+int norm_f32(const RadArgs* a,RadStream st,bool plain) {
+    bool chain=r4d_geti_or(a,"chain",0)!=0;
+    auto *x=r4d_opt(a,0), *w=plain?nullptr:r4d_opt(a,1), *out=r4d_opt(a,plain?1:2);
+    const int n=r4d_geti_or(a,"n",0);
+    if(!x||!out||n<=0 || x->dtype!=RAD_F32 || out->dtype!=RAD_F32 ||
+        (w && (!r4d_contig(w) || (w->dtype!=RAD_F32 && w->dtype!=RAD_BF16))))return R4D_NO(RAD_E_DTYPE);
+    long long m=0,mo=0,xs=r4d_rows_pitch(x,n,&m),os=r4d_rows_pitch(out,n,&mo);
+    if(xs<0||os<0||m<1||m!=mo||(w && r4d_numel(w)<n))return R4D_NO(RAD_E_SHAPE);
+    float wadd=r4d_getf(a,"wadd",0);
+    if(wadd!=0 && !w)return R4D_NO(RAD_E_INVAL);
+    chain=chain && m<=64;
+    if(chain) r4dchain_rms_rows<<<m,128,0,(hipStream_t)st>>>((const float*)x->data,r4d_p(w),w && w->dtype==RAD_F32,
+        (float*)out->data,n,xs,os,r4d_getf(a,"eps",1e-6),wadd,r4d_getf(a,"mult",1));
+    else rms_rows<<<m,128,0,(hipStream_t)st>>>((const float*)x->data,r4d_p(w),w && w->dtype==RAD_F32,
+        (float*)out->data,n,xs,os,r4d_getf(a,"eps",1e-6),wadd,r4d_getf(a,"mult",1));
+    return launched();
+}
