new file mode 100644
index 0000000..feebd0e
--- /dev/null
+++ b/libr4d/r4d_tanh_ff.h
@@ -0,0 +1,121 @@
+// r4d_tanh_ff.h - float(tanh(double(x))) without the FP64 rate, bit for bit.
+//
+// The loop controller's blend takes two tanh(double) a channel-token and casts them to float; on
+// gfx1201 FP64 runs at 1/32 of the FP32 rate, so those two calls were 3.7 of the controller's 4.7 ms
+// at M=2048 and about 1 ms of every decode step. This evaluates tanh in float-float arithmetic
+// (pairs of floats, error about 2^-42 relative), rounds the pair to one float, and takes the
+// FP64 path only when the pair lies within 2^-38 of a float rounding threshold, where the two
+// could round apart. Everywhere else the result is the float ocml's tanh(double) rounds to, so the
+// function's output is identical to float(tanh(double(x))) for every float x; an exhaustive
+// sweep (tanh_ff_sweep.hip) checks every float in [-16, 16] against ocml.
+// No plain float product appears: every rounded product goes through mulr, whose empty asm keeps
+// the backend from fusing it into a later add. With -ffp-contract=fast (HIP's device default; a
+// contract(off) pragma did not stop it, nor did fmaf(a, b, -0.f)) the fused products voided the
+// error-free transformations: 45 M of the 2.2 G floats in [-16, 16] then rounded apart from ocml.
+#pragma once
+#include <hip/hip_runtime.h>
+#include <cstdint>
+namespace r4d_tanh_ff {
+struct FF { float hi, lo; };
+// RN(a*b) that no later add can absorb: the empty asm pins the rounded product in a register, so the
+// backend sees no fmul to fuse (fmaf(a, b, -0.f) does not work: the compiler folds it back to a product).
+__device__ __forceinline__ float mulr(float a,float b) { float p=__fmul_rn(a,b); asm volatile("" : "+v"(p)); return p; }
+__device__ __forceinline__ FF two_sum(float a,float b) {
+    float s=__fadd_rn(a,b), bb=__fsub_rn(s,a);
+    return {s,__fadd_rn(__fsub_rn(a,__fsub_rn(s,bb)),__fsub_rn(b,bb))};
+}
+__device__ __forceinline__ FF quick_two_sum(float a,float b) {   // |a| >= |b|
+    float s=__fadd_rn(a,b);
+    return {s,__fsub_rn(b,__fsub_rn(s,a))};
+}
+__device__ __forceinline__ FF two_prod(float a,float b) {
+    float p=mulr(a,b);
+    return {p,fmaf(a,b,-p)};
+}
+__device__ __forceinline__ FF ff_mul_f(FF a,float b) {
+    FF p=two_prod(a.hi,b);
+    return quick_two_sum(p.hi,__fadd_rn(p.lo,mulr(a.lo,b)));
+}
+__device__ __forceinline__ FF ff_mul(FF a,FF b) {
+    FF p=two_prod(a.hi,b.hi);
+    return quick_two_sum(p.hi,__fadd_rn(p.lo,__fadd_rn(mulr(a.hi,b.lo),mulr(a.lo,b.hi))));
+}
+__device__ __forceinline__ FF ff_add(FF a,FF b) {
+    FF s=two_sum(a.hi,b.hi);
+    return quick_two_sum(s.hi,__fadd_rn(s.lo,__fadd_rn(a.lo,b.lo)));
+}
+__device__ __forceinline__ FF ff_div(FF n,FF d) {   // n / d
+    float q1=__fdiv_rn(n.hi,d.hi);
+    float r=__fsub_rn(__fadd_rn(fmaf(-q1,d.hi,n.hi),n.lo),mulr(q1,d.lo));
+    return quick_two_sum(q1,__fdiv_rn(r,d.hi));
+}
+// exp(r) - 1 for |r| <= 0.3466 (half of ln 2): r times the degree-10 Horner of 1/n!, so there is
+// no cancellation for a small r; truncation under 2^-47 of the value. Coefficients as float pairs.
+__device__ __forceinline__ FF ff_expm1_small(float r) {
+    FF p={0x1.ae6456p-26f,0x1.fd5138p-52f};
+    p=ff_add(ff_mul_f(p,r),{0x1.27e4fcp-22f,-0x1.10ec14p-47f});
+    p=ff_add(ff_mul_f(p,r),{0x1.71de3ap-19f,0x1.55b1ccp-45f});
+    p=ff_add(ff_mul_f(p,r),{0x1.a01a02p-16f,-0x1.7f97fap-42f});
+    p=ff_add(ff_mul_f(p,r),{0x1.a01a02p-13f,-0x1.7f97fap-39f});
+    p=ff_add(ff_mul_f(p,r),{0x1.6c16c2p-10f,-0x1.27d27ep-35f});
+    p=ff_add(ff_mul_f(p,r),{0x1.111112p-7f,-0x1.dddddep-32f});
+    p=ff_add(ff_mul_f(p,r),{0x1.555556p-5f,-0x1.555556p-30f});
+    p=ff_add(ff_mul_f(p,r),{0x1.555556p-3f,-0x1.555556p-28f});
+    p=ff_add(ff_mul_f(p,r),{0.5f,0.f});
+    p=ff_add(ff_mul_f(p,r),{1.f,0.f});
+    return ff_mul_f(p,r);
+}
+#ifdef R4D_TANH_FF_COUNT
+__device__ unsigned long long g_tanh_ff_fallbacks=0;
+#define R4D_TANH_FF_NOTE() atomicAdd(&g_tanh_ff_fallbacks,1ull)
+#else
+#define R4D_TANH_FF_NOTE() ((void)0)
+#endif
+// float(tanh(double(x))) for every float x.
+__device__ __forceinline__ float tanh_ff(float x) {
+    const float ax=fabsf(x);
+    if(!(ax<10.f)) {
+        if(ax>=10.f) return copysignf(1.f,x);   // 1 - tanh(10) = 4.1e-9 is under half a float ulp of 1
+        R4D_TANH_FF_NOTE(); return (float)tanh((double)x);   // NaN
+    }
+    FF t;
+    if(ax<0x1p-10f) {
+        // ax - ax^3/3 + 2 ax^5/15; the x^7 term is under 2^-57 of the value.
+        const float x2=mulr(ax,ax);
+        const float poly=fmaf(x2,0x1.111111p-3f,-0x1.555556p-2f);
+        t=two_sum(ax,mulr(mulr(ax,x2),poly));
+    } else {
+        // tanh(a) = 1 - 2 / (exp(2a) + 1); exp(2a) = 2^k exp(rhi) exp(d), ln 2 split in three.
+        const float y=__fadd_rn(ax,ax);
+        const float kf=rintf(mulr(y,0x1.715476p+0f));
+        const float rhi=__fsub_rn(y,mulr(kf,0x1.62e4p-1f));          // exact: 15-bit L1, |k| < 32
+        const float d1=-mulr(kf,0x1.7f6p-20f);                        // exact: 12-bit L2
+        const float d2=-mulr(kf,0x1.d1cf7ap-32f);
+        const int k=(int)kf;
+        if(k==0) {
+            // a < 0.174: tanh(a) = (exp(2a) - 1) / (exp(2a) + 1) with expm1, so the small result is
+            // not the difference of two numbers near one.
+            const FF Em1=ff_expm1_small(y);
+            t=ff_div(Em1,ff_add(Em1,{2.f,0.f}));
+        } else {
+            const FF P=ff_add(ff_expm1_small(rhi),{1.f,0.f});
+            const float dsq=mulr(mulr(d1,d1),0.5f);
+            const FF E0=ff_mul(P,ff_add({1.f,0.f},{d1,__fadd_rn(d2,dsq)}));   // exp(d) = 1 + d + d^2/2, |d| < 4.2e-5
+            const FF E={ldexpf(E0.hi,k),ldexpf(E0.lo,k)};
+            const FF Q=ff_div({2.f,0.f},ff_add(E,{1.f,0.f}));   // E >= 1.4, so 1 - Q keeps all but two bits
+            t=ff_add({1.f,0.f},{-Q.hi,-Q.lo});
+        }
+    }
+    // t.hi is the pair's correctly rounded float and t.lo its exact remainder. The true value is
+    // within eps*t.hi of the pair; when that interval stays inside t.hi's rounding cell (half an
+    // ulp each way, a quarter below a power of two) the FP64 path would round to the same float.
+    const float c=t.hi, e=t.lo;
+    const uint32_t cb=__float_as_uint(c);
+    const float up=__fsub_rn(__uint_as_float(cb+1u),c), down=__fsub_rn(c,__uint_as_float(cb-1u));
+    const float margin=mulr(fminf(up,down),0.5f);
+    if(__fadd_rn(fabsf(e),mulr(0x1p-38f,c))<margin) return copysignf(c,x);
+    R4D_TANH_FF_NOTE();
+    return (float)tanh((double)x);
+}
+}
+using r4d_tanh_ff::tanh_ff;
