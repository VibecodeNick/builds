diff --git a/plugin/spechub/inkling_draft_ops.cpp b/plugin/spechub/inkling_draft_ops.cpp
new file mode 100644
index 0000000..e12728a
--- /dev/null
+++ b/plugin/spechub/inkling_draft_ops.cpp
@@ -0,0 +1,149 @@
+#include "inkling_draft_ops.h"
+#include "rad_plugin.h"
+#include <array>
+#include <algorithm>
+#include <limits>
+namespace ids {
+namespace {
+float asfloat(uint16_t x) { uint32_t u=uint32_t(x)<<16; float y; std::memcpy(&y,&u,4); return y; }
+uint16_t asbf(float x) { uint32_t u; std::memcpy(&u,&x,4); return (u+0x7fff+((u>>16)&1))>>16; }
+float roundb(float x) {return asfloat(asbf(x));}
+bool matches(const RadTensor& t,uint32_t dt,int64_t size) {
+    return t.data && t.dtype==dt && rad_tensor_is_contiguous(&t) && rad_tensor_numel(&t)==size;
+}
+const RadParamSpec params[]={{"M",RAD_P_INT,RAD_REQUIRED,0}};
+#define IN(k) {k,RAD_OPD_IN,0}
+#define WT(k) {k,RAD_OPD_WEIGHT,0}
+#define OUT(k) {k,RAD_OPD_OUT,0}
+const RadOperandSpec mop[]={IN("taps"),WT("alpha"),WT("gain"),OUT("mixed")};
+const RadOperandSpec sop[]={IN("embedding"),WT("mask"),OUT("seed")};
+const RadOperandSpec hop[]={IN("hidden"),IN("feature"),IN("anchor_rows"),IN("ids"),IN("base"),
+    WT("codebook"),WT("context_w"),WT("recurrent_w"),WT("bias"),WT("fold_w"),WT("fold_bias"),OUT("proposals")};
+const RadOpSchema schemas[]={
+    {"ink_ds_mix",params,1,mop,4,"RMSNorm of the four tap streams weighted by a learned softmax row."},
+    {"ink_ds_seed",params,1,sop,3,"Normalized target anchor, followed by seven learned mask vectors."},
+    {"ink_ds_markov",params,1,hop,12,"Seven sequential full-vocabulary greedy proposals from the recurrent Inkling draft."},
+};
+#undef IN
+#undef WT
+#undef OUT
+int64_t scratch(const RadArgs* a) {
+    return a?int64_t(words)*4*rad_param_getdim(a->p,a->n_p,"M",1):0;
+}
+int mix_cpu(const RadArgs* a,RadStream) {
+    Mix c{}; int rc=read(a,c); if(rc) return rc;
+    for(int r=0;r<c.rows;++r) {
+        float x[H], ss=0;
+        for(int h=0;h<H;++h) {
+            x[h]=0;
+            for(int t=0;t<taps;++t) x[h]+=asfloat(c.x[(r*taps+t)*H+h])*asfloat(c.alpha[t]);
+            ss+=x[h]*x[h];
+        }
+        float scale=1.f/std::sqrt(ss/H+1e-6f);
+        for(int h=0;h<H;++h) c.y[r*H+h]=asbf(x[h]*scale*asfloat(c.gain[h]));
+    }
+    return RAD_OK;
+}
+int seed_cpu(const RadArgs* a,RadStream) {
+    Seed c{}; int rc=read(a,c); if(rc) return rc;
+    for(int r=0;r<c.rows;++r)
+        std::memcpy(c.y+r*H, r%block?c.mask:c.embedding+r*H, H*2);
+    return RAD_OK;
+}
+int head_cpu(const RadArgs* a,RadStream) {
+    Head c{}; int rc=read(a,c); if(rc) return rc;
+    for(int s=0;s<c.nseq;++s) {
+        const int anchor=c.anchors[s];
+        if(anchor<0 || anchor>=c.feature_rows) return RAD_E_INVAL;
+        int prev=c.ids[s*block];
+        float state[R]={}, raw[3*R], latent[R];
+        for(int j=0;j<c.k;++j) {
+            if(prev<0 || prev>=V) return RAD_E_INVAL;
+            const uint16_t* x=c.hidden+(s*c.k+j)*H;
+            const uint16_t* f=c.feature+anchor*H;
+            for(int i=0;i<3*R;++i) {
+                float sum=0;
+                const uint16_t* w=c.context_w+i*2*H;
+                for(int h=0;h<H;++h) sum+=asfloat(x[h])*asfloat(w[h]);
+                for(int h=0;h<H;++h) sum+=asfloat(f[h])*asfloat(w[H+h]);
+                float rec=0;
+                const uint16_t* wr=c.recur_w+i*2*R;
+                for(int k=0;k<R;++k) rec+=state[k]*asfloat(wr[k]);
+                for(int k=0;k<R;++k) rec+=asfloat(c.codebook[prev*R+k])*asfloat(wr[R+k]);
+                raw[i]=roundb((sum+c.bias[i])+rec);
+            }
+            for(int k=0;k<R;++k) {
+                float gate=roundb(1.f/(1.f+std::exp(-raw[k])));
+                state[k]=roundb(roundb(gate*state[k])+roundb(roundb(1.f-gate)*roundb(std::tanh(raw[R+k]))));
+                latent[k]=roundb(std::tanh(raw[2*R+k]));
+            }
+            const uint16_t* base=c.base+(s*c.k+j)*V;
+            float best=-std::numeric_limits<float>::infinity(); prev=0;
+            for(int i=0;i<V;++i) {
+                float dot=0;
+                for(int k=0;k<R;++k) dot+=latent[k]*asfloat(c.fold_w[i*R+k]);
+                float z=roundb(asfloat(base[i])+roundb(dot+asfloat(c.fold_bias[i])));
+                float value=roundb(30.f*std::tanh(z/30.f));
+                if(value>best) { best=value; prev=i; }
+            }
+            c.out[s*steps+j]=prev;
+        }
+    }
+    return RAD_OK;
+}
+}
+int read(const RadArgs* a,Mix& c) {
+    if(!a||a->n_t!=4) return RAD_E_INVAL;
+    auto t=a->t; int n=rad_tensor_numel(t+3)/H;
+    if(n<1||!matches(t[0],RAD_BF16,int64_t(n)*H*4)||!matches(t[1],RAD_BF16,4)||
+       !matches(t[2],RAD_BF16,H)||!matches(t[3],RAD_BF16,int64_t(n)*H)) return RAD_E_SHAPE;
+    c={(uint16_t*)t[0].data,(uint16_t*)t[1].data,(uint16_t*)t[2].data,(uint16_t*)t[3].data,n}; return RAD_OK;
+}
+int read(const RadArgs* a,Seed& c) {
+    if(!a||a->n_t!=3) return RAD_E_INVAL;
+    auto t=a->t; int n=rad_tensor_numel(t+2)/H;
+    if(n<block||n%block||!matches(t[0],RAD_BF16,int64_t(n)*H)||!matches(t[1],RAD_BF16,H)||
+        !matches(t[2],RAD_BF16,int64_t(n)*H)) return RAD_E_SHAPE;
+    c={(uint16_t*)t[0].data,(uint16_t*)t[1].data,(uint16_t*)t[2].data,n}; return RAD_OK;
+}
+int read(const RadArgs* a, Head& c) {
+    if(!a||a->n_t!=12) return RAD_E_INVAL;
+    auto t=a->t; int n=rad_tensor_numel(t+2); int f=rad_tensor_numel(t+1)/H;
+    // The pass proposes k drafts a sequence, the head rows it was given; the proposal row keeps its pitch.
+    const int64_t hid=rad_tensor_numel(t+0); const int k=n>0?int(hid/(int64_t(n)*H)):0;
+    if(k<1||k>steps) return RAD_E_SHAPE;
+    int64_t size[]={int64_t(n)*k*H,int64_t(f)*H,n,int64_t(n)*block,int64_t(n)*k*V,
+        int64_t(V)*R,3*R*2*H,3*R*2*R,3*R,int64_t(V)*R,V,int64_t(n)*steps};
+    uint32_t dt[]={RAD_BF16,RAD_BF16,RAD_I32,RAD_I32,RAD_BF16,RAD_BF16,RAD_BF16,RAD_BF16,RAD_F32,RAD_BF16,RAD_BF16,RAD_I32};
+    if(n<1||f<1||int64_t(n)*words*4>a->scratch_bytes||!a->scratch) return RAD_E_SHAPE;
+    for(int i=0;i<12;++i) if(!matches(t[i],dt[i],size[i])) return RAD_E_SHAPE;
+    c.hidden=(uint16_t*)t[0].data; c.feature=(uint16_t*)t[1].data; c.anchors=(int*)t[2].data;
+    c.ids=(int*)t[3].data; c.base=(uint16_t*)t[4].data; c.codebook=(uint16_t*)t[5].data;
+    c.context_w=(uint16_t*)t[6].data; c.recur_w=(uint16_t*)t[7].data; c.bias=(float*)t[8].data;
+    c.fold_w=(uint16_t*)t[9].data; c.fold_bias=(uint16_t*)t[10].data; c.out=(int*)t[11].data;
+    c.nseq=n; c.feature_rows=f; c.k=k; c.pre=(float*)a->scratch; c.raw=c.pre+n*steps*3*R;
+    c.state=c.raw+n*3*R; c.latent=c.state+n*R; c.best=c.latent+n*R; c.idx=(int*)(c.best+n*tiles);
+    return RAD_OK;
+}
+const RadOpSchema* schema(int i) {return i>=0&&i<count?schemas+i:nullptr;}
+const RadKernelInfo* row(int i,bool gpu) {
+    static const auto rows=[] {
+        std::array<RadKernelInfo,6> x{};
+        const char* refs[]={"ref_ink_ds_mix","ref_ink_ds_seed","ref_ink_ds_markov"};
+        RadLaunchFn cpu[]={mix_cpu,seed_cpu,head_cpu};
+        for(int k=0;k<6;++k) {
+            auto& r=x[k]; int j=k%3;
+            r.op=schemas[j].op; r.name=k>=3?r.op:refs[j]; r.family="draft"; r.computes=schemas[j].doc;
+            r.shape="Inkling 2 Mini"; r.dtypes="bf16,f32,i32";
+            r.domain=k>=3?RAD_DOMAIN_DEVICE:RAD_DOMAIN_HOST; r.priority=k>=3?100:0;
+            r.launch=cpu[j]; if(j==2) r.scratch=scratch;
+#ifdef RAD_SPECHUB_WITH_DEVICE
+            RadLaunchFn device[]={mix_gpu,seed_gpu,head_gpu};
+            if(k>=3) r.launch=device[j];
+#endif
+        }
+        return x;
+    }();
+    return i>=0&&i<count?&rows[(gpu?3:0)+i]:nullptr;
+}
+}
diff --git a/plugin/spechub/inkling_draft_ops.h b/plugin/spechub/inkling_draft_ops.h
new file mode 100644
index 0000000..3d878f2
--- /dev/null
+++ b/plugin/spechub/inkling_draft_ops.h
@@ -0,0 +1,31 @@
+// Inkling 2 Mini's fixed seven-token recurrent draft head.
+#pragma once
+#include "rad_abi.h"
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+namespace ids {
+constexpr int H=2304, R=256, V=200058, steps=7, block=8, taps=4;
+struct Mix { const uint16_t *x,*alpha,*gain; uint16_t* y; int rows; };
+struct Seed { const uint16_t *embedding,*mask; uint16_t* y; int rows; };
+struct Head {
+    const uint16_t *hidden,*feature,*base,*codebook,*context_w,*recur_w,*fold_w,*fold_bias;
+    const float* bias;
+    const int *anchors,*ids;
+    int *out, nseq, feature_rows;
+    int k;   // drafts a sequence in this pass, 1..steps: the rows of `hidden` and `base` (their pitch)
+    float *pre,*raw,*state,*latent,*best;
+    int *idx;
+};
+constexpr int tile=128, tiles=(V+tile-1)/tile;
+constexpr int words=steps*3*R+3*R+2*R+2*tiles;
+int read(const RadArgs*,Mix&); int read(const RadArgs*,Seed&); int read(const RadArgs*,Head&);
+constexpr int count=3;
+const RadOpSchema* schema(int);
+const RadKernelInfo* row(int,bool);
+#ifdef RAD_SPECHUB_WITH_DEVICE
+int mix_gpu(const RadArgs*,RadStream);
+int seed_gpu(const RadArgs*,RadStream);
+int head_gpu(const RadArgs*,RadStream);
+#endif
+}
diff --git a/plugin/spechub/inkling_draft_ops.hip b/plugin/spechub/inkling_draft_ops.hip
new file mode 100644
index 0000000..9da70b2
--- /dev/null
+++ b/plugin/spechub/inkling_draft_ops.hip
@@ -0,0 +1,110 @@
+#include <hip/hip_runtime.h>
+#include "inkling_draft_ops.h"
+#include "../../libr4d/r4d_emit.h"
+namespace ids {
+namespace {
+__device__ float val(uint16_t x) {return __uint_as_float(unsigned(x)<<16);}
+__device__ uint16_t bits(float x) {unsigned u=__float_as_uint(x); return (u+0x7fff+((u>>16)&1))>>16;}
+__device__ float bf(float x) {return val(bits(x));}
+__device__ float sumwarp(float v) {for(int n=16;n;n/=2) v+=__shfl_down(v,n,32); return v;}
+__global__ void mix(Mix c) {
+    int r=blockIdx.x, i=threadIdx.x; float ss=0, mixed[H/256];
+    for(int j=0;j<H/256;++j) {
+        float acc=0; for(int k=0;k<4;++k) acc+=val(c.x[(r*taps+k)*H+j*256+i])*val(c.alpha[k]);
+        mixed[j]=acc; ss+=acc*acc;
+    }
+    __shared__ float part[8],inv;
+    ss=sumwarp(ss); if(i%32==0) part[i/32]=ss;
+    __syncthreads();
+    if(i==0) {float acc=0; for(float a:part) acc+=a; inv=rsqrtf(acc/H+1e-6f);}
+    __syncthreads();
+    for(int j=0;j<H/256;++j) c.y[r*H+j*256+i]=bits(mixed[j]*inv*val(c.gain[j*256+i]));
+}
+__global__ void seed(Seed c) {
+    int r=blockIdx.x; for(int h=threadIdx.x;h<H;h+=blockDim.x)
+        c.y[r*H+h]=r%block?c.mask[h]:c.embedding[r*H+h];
+}
+__global__ void precompute(Head c) {
+    int i=blockIdx.x*8+threadIdx.x/32, lane=threadIdx.x%32, j=blockIdx.y, s=blockIdx.z;
+    if(i>=3*R) return;
+    int anchor=max(0,min(c.anchors[s],c.feature_rows-1));
+    const uint16_t* w=c.context_w+i*2*H;
+    const uint16_t* h=c.hidden+(s*c.k+j)*H;
+    const uint16_t* f=c.feature+anchor*H;
+    float x=0;
+    for(int k=lane;k<H;k+=32) x+=val(w[k])*val(h[k])+val(w[H+k])*val(f[k]);
+    x=sumwarp(x);
+    if(!lane) c.pre[(s*steps+j)*3*R+i]=x+c.bias[i];
+}
+__global__ void recurrence(Head c,int j) {
+    int i=blockIdx.x*8+threadIdx.x/32,s=blockIdx.y,lane=threadIdx.x%32;
+    if(i>=3*R) return;
+    int prev=j?c.out[s*steps+j-1]:c.ids[s*block]; prev=max(0,min(V-1,prev));
+    const uint16_t* w=c.recur_w+i*2*R; float sum=0;
+    for(int k=lane;k<R;k+=32) {
+        float old=j?c.state[s*R+k]:0;
+        sum+=old*val(w[k])+val(c.codebook[prev*R+k])*val(w[R+k]);
+    }
+    sum=sumwarp(sum); if(!lane) c.raw[s*3*R+i]=bf(c.pre[(s*steps+j)*3*R+i]+sum);
+}
+__global__ void gate(Head c,int j) {
+    int s=blockIdx.x, k=threadIdx.x;
+    const float* x=c.raw+s*3*R;
+    float g=bf(1.f/(1.f+expf(-x[k]))), old=j?c.state[s*R+k]:0;
+    c.state[s*R+k]=bf(bf(g*old)+bf(bf(1.f-g)*bf(tanhf(x[R+k]))));
+    c.latent[s*R+k]=bf(tanhf(x[2*R+k]));
+}
+__global__ void vocab_tiles(Head c,int j) {
+    int s=blockIdx.y, ix=blockIdx.x*tile, lane=threadIdx.x%32, wave=threadIdx.x/32;
+    __shared__ float latent[R],score[8]; __shared__ int idx[8];
+    latent[threadIdx.x]=c.latent[s*R+threadIdx.x]; __syncthreads();
+    float maxv=-INFINITY; int best=V;
+    for(int local=wave;local<tile;local+=8) {
+        int token=ix+local; if(token>=V) continue;
+        float acc=0; for(int k=lane;k<R;k+=32) acc+=val(c.fold_w[token*R+k])*latent[k];
+        acc=sumwarp(acc);
+        if(!lane) {
+            float z=bf(val(c.base[(int64_t(s)*c.k+j)*V+token])+bf(acc+val(c.fold_bias[token])));
+            float x=bf(30*tanhf(z/30.f)); if(x>maxv || (x==maxv&&token<best)) {maxv=x; best=token;}
+        }
+    }
+    if(!lane) {score[wave]=maxv; idx[wave]=best;} __syncthreads();
+    if(!threadIdx.x) {
+        for(int i=1;i<8;++i) if(score[i]>maxv || (score[i]==maxv&&idx[i]<best)) {maxv=score[i];best=idx[i];}
+        c.best[s*tiles+blockIdx.x]=maxv; c.idx[s*tiles+blockIdx.x]=best;
+    }
+}
+__global__ void choose(Head c,int j) {
+    int s=blockIdx.x, i=threadIdx.x, id=V; float best=-INFINITY;
+    __shared__ int ids[256]; __shared__ float scores[256];
+    for(int k=i;k<tiles;k+=256) {float v=c.best[s*tiles+k];int t=c.idx[s*tiles+k];if(v>best||(v==best&&t<id)){id=t;best=v;}}
+    ids[i]=id;scores[i]=best;__syncthreads();
+    for(int stride=128;stride;stride/=2) {
+        if(i<stride && (scores[i+stride]>scores[i] || (scores[i+stride]==scores[i]&&ids[i+stride]<ids[i]))) {
+            scores[i]=scores[i+stride];ids[i]=ids[i+stride];
+        }
+        __syncthreads();
+    }
+    if(i==0)c.out[s*steps+j]=ids[0]<V?ids[0]:0;
+}
+}
+int mix_gpu(const RadArgs* a,RadStream stream) {
+    Mix c{};int rc=read(a,c);if(rc) return rc;
+    return r4d_emit(stream,mix,dim3(c.rows),dim3(256),0,c);
+}
+int seed_gpu(const RadArgs* a,RadStream stream) {
+    Seed c{};int rc=read(a,c);if(rc) return rc;
+    return r4d_emit(stream,seed,dim3(c.rows),dim3(256),0,c);
+}
+int head_gpu(const RadArgs* a,RadStream stream) {
+    Head c{};int rc=read(a,c);if(rc) return rc;
+    if ((rc = r4d_emit(stream,precompute,dim3(3*R/8,c.k,c.nseq),dim3(256),0,c)) != RAD_OK) return rc;
+    for(int j=0;j<c.k;++j) {
+        if ((rc = r4d_emit(stream,recurrence,dim3(3*R/8,c.nseq),dim3(256),0,c,j)) != RAD_OK) return rc;
+        if ((rc = r4d_emit(stream,gate,dim3(c.nseq),dim3(R),0,c,j)) != RAD_OK) return rc;
+        if ((rc = r4d_emit(stream,vocab_tiles,dim3(tiles,c.nseq),dim3(256),0,c,j)) != RAD_OK) return rc;
+        if ((rc = r4d_emit(stream,choose,dim3(c.nseq),dim3(256),0,c,j)) != RAD_OK) return rc;
+    }
+    return RAD_OK;
+}
+}
