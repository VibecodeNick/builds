+// One (token, head) block of the clip; the two kernels below pick t and h differently.
+__device__ __forceinline__ void clip_head(const uint16_t* x,const void* scale,bool fp_scale,const int* pos,uint16_t* out,
+                     int heads,int d,float threshold,float alpha,int floor,int t,int h,long long xs,long long ys) {
+    const int c=threadIdx.x;
+    // x and out may be column slices of wider rows (q out of the q|gate GEMM): rows at their own pitch.
+    const long long xbase=(long long)t*xs+(long long)h*d, ybase=(long long)t*ys+(long long)h*d;
+    float v=0;
+    if (c<d) {
+        float s=!scale ? 1.f : fp_scale ? ((const float*)scale)[h*d+c] :
+                                          bf16_to_f32(((const uint16_t*)scale)[h*d+c]);
+        v=bf16_to_f32(x[xbase+c])*s;
+    }
+    __shared__ float partial[4];
+    float ss=wave_sum(v*v);
+    if (c%32==0) partial[c/32]=ss;
+    __syncthreads();
+    float norm=sqrtf(partial[0]+partial[1]+partial[2]+partial[3]);
+    float tau=alpha ? 1.f+alpha*logf(fmaxf(1.f,(pos[t]+1.f)/floor)) : 1.f;
+    if (c<d) out[ybase+c]=f32_to_bf16(bf(v*fminf(1.f,threshold/(norm+1e-6f)))*tau);
+}
+__device__ __forceinline__ void clip_body(const uint16_t* x,const void* scale,bool fp_scale,const int* pos,uint16_t* out,
+                     int heads,int d,float threshold,float alpha,int floor) {
+    clip_head(x,scale,fp_scale,pos,out,heads,d,threshold,alpha,floor,blockIdx.x,blockIdx.y,(long long)heads*d,(long long)heads*d);
+}
+// The three clips of a visit (q, r and k) in one launch: grid (m, heads_q + heads_r + heads_k), a
+// block picks its set by blockIdx.y and runs clip_head unchanged. Three launches a visit were 144
+// a step; the arithmetic per (token, head) is the single clip's.
+struct ClipSet { const uint16_t* x; const void* scale; uint16_t* out; int heads, d; bool fp_scale; float threshold, alpha; long long xs, ys; };
+struct Clip3 { ClipSet s[3]; const int* pos; int floor; };
+__device__ __forceinline__ void clip3_body(Clip3 a) {
+    const int t=blockIdx.x;
+    int h=blockIdx.y, i=0;
+    if(h>=a.s[0].heads){h-=a.s[0].heads;i=1;if(h>=a.s[1].heads){h-=a.s[1].heads;i=2;}}
+    const ClipSet& c=a.s[i];
+    clip_head(c.x,c.scale,c.fp_scale,a.pos,c.out,c.heads,c.d,c.threshold,c.alpha,a.floor,t,h,c.xs,c.ys);
+}
+__global__ void clip3(Clip3 a) { clip3_body(a); }
+__global__ void r4dchain_clip3(Clip3 a) {
+    r4d_chain_wait();
+    clip3_body(a);
+    r4d_chain_done();
+}
+__global__ void clip(const uint16_t* x,const void* scale,bool fp_scale,const int* pos,uint16_t* out,
+                     int heads,int d,float threshold,float alpha,int floor) {
