+// Each rank gets a 256-thread workgroup. The two inverse norms are reused
+// inside the workgroup and the normalized hidden vectors stay in registers.
+// As rms_ink: a thread's columns are tid, tid+256, ... and both sums take them in that order, but
+// every load (x, msg and the two weight halves) is issued before the first add. The runtime-bound
+// loops had one load in flight at a time: 10 us a launch at n=2,304, 64 blocks each redoing it.
+constexpr int ctrl_threads=256, ctrl_cols=9;
+// The controller's bottleneck dot at decode and verify heights. The reference sums the
+// 4,608 exact products (two BF16 values each) in FP64 and rounds the sum to float, then to BF16.
+// FP64 runs at 1/32 of the FP32 rate here and a visit's three controllers made the stage three times
+// as long side by side, so it was bound by that rate. The same exact products are now summed as
+// float pairs with their magnitude sum alongside (MixFF, as the depth mix): a thread's 18 terms in
+// six partials of three, the wave's butterfly, the eight wave partials as a tree. The pair is within
+// about 2^-42 of the magnitude sum of the true sum, the FP64 reference within 4,608 x 2^-53; when the
+// pair's float is not at least 2^-38 of the magnitude sum clear of a rounding threshold (or the sums
+// are too small for float products to be exact), the block runs the reference's FP64 statements
+// instead, so the float is the reference's in every case.
+__device__ __forceinline__ bool ctl_ff_settle(const float* h,const float* l,const float* m,float* out) {
+    r4d_tanh_ff::FF q[4]; float g[4];
+#pragma unroll
+    for(int w=0;w<4;++w){q[w]=r4d_tanh_ff::ff_add({h[2*w],l[2*w]},{h[2*w+1],l[2*w+1]});g[w]=__fadd_rn(m[2*w],m[2*w+1]);}
+    const r4d_tanh_ff::FF t=r4d_tanh_ff::ff_add(r4d_tanh_ff::ff_add(q[0],q[1]),r4d_tanh_ff::ff_add(q[2],q[3]));
+    const float mag=__fadd_rn(__fadd_rn(g[0],g[1]),__fadd_rn(g[2],g[3]));
+    const float c=t.hi, e=t.lo, ac=fabsf(c);
+    const uint32_t cb=__float_as_uint(ac);
+    const float up=__fsub_rn(__uint_as_float(cb+1u),ac), down=cb?__fsub_rn(ac,__uint_as_float(cb-1u)):up;
+    const float margin=__fmul_rn(fminf(up,down),0.5f);
+    *out=c;
+#ifdef R4D_PROBE_CTL_FALLBACK
+    return false;   // timing and equality probe only: every block takes the reference's FP64 statements
+#endif
+    // mag >= 2^-60: every product that matters is far above the subnormals, so the float products were exact.
+    return isfinite(c) && mag>=0x1p-60f && mag<0x1p100f && __fadd_rn(fabsf(e),__fmul_rn(0x1p-38f,mag))<margin;
+}
+__device__ __forceinline__ MixFF ctl_ff_term(float a,float b) { return mix_ff_first(r4d_tanh_ff::two_prod(a,b)); }
+__device__ __forceinline__ void control_norm_down_rank_body(const float* x,const float* msg,const uint16_t* weight,float* hidden,
+                                       int n,int rank,float eps) {
+    int j=blockIdx.x,t=blockIdx.y,tid=threadIdx.x,lane=tid%32,wave=tid/32;
+    x+=(long long)t*n;msg+=(long long)t*n;weight+=(long long)j*2*n;
+    __shared__ double part[2][8];
+    __shared__ float inv[2];
+    const bool preload=n<=ctrl_threads*ctrl_cols;
+    float xr[ctrl_cols],mr[ctrl_cols];uint16_t w0[ctrl_cols],w1[ctrl_cols];
+    double a=0,b=0;
+    if(preload){
+#pragma unroll
+        for(int i=0;i<ctrl_cols;++i){const int c=tid+i*ctrl_threads;const bool in=c<n;
+            xr[i]=in?x[c]:0.f;mr[i]=in?msg[c]:0.f;w0[i]=in?weight[c]:0;w1[i]=in?weight[n+c]:0;}
+#pragma unroll
+        for(int i=0;i<ctrl_cols;++i){const int c=tid+i*ctrl_threads;if(c<n){a+=double(xr[i])*xr[i];b+=double(mr[i])*mr[i];}}
+    } else {
+        for(int c=tid;c<n;c+=256){a+=double(x[c])*x[c];b+=double(msg[c])*msg[c];}
+    }
+    for(int s=16;s;s/=2){a+=__shfl_down(a,s,32);b+=__shfl_down(b,s,32);}
+    if(!lane){part[0][wave]=a;part[1][wave]=b;}
+    __syncthreads();
+    if(tid<2){
+        double sum=0;for(int w=0;w<8;++w)sum+=part[tid][w];
+        inv[tid]=float(1.0/sqrt(sum/n+eps));
+    }
+    __syncthreads();
+    if(preload && n==ctrl_threads*ctrl_cols){
+        // The float-pair dot (see ctl_ff_settle); the FP64 statements below run only when it does not settle.
+        __shared__ float fh[8],fl[8],fm[8]; __shared__ int refuse;
+        MixFF q[6];
+#pragma unroll
+        for(int i=0;i<3;++i){
+            q[2*i]=ctl_ff_term(bf(xr[i]*inv[0]),bf16_to_f32(w0[i]));
+            q[2*i+1]=ctl_ff_term(bf(mr[i]*inv[1]),bf16_to_f32(w1[i]));
+        }
+#pragma unroll
+        for(int i=3;i<ctrl_cols;++i){
+            q[(2*i)%6]=mix_ff_add(q[(2*i)%6],r4d_tanh_ff::two_prod(bf(xr[i]*inv[0]),bf16_to_f32(w0[i])));
+            q[(2*i+1)%6]=mix_ff_add(q[(2*i+1)%6],r4d_tanh_ff::two_prod(bf(mr[i]*inv[1]),bf16_to_f32(w1[i])));
+        }
+        const MixFF acc=mix_ff_wave(mix_ff_tree6(q));
+        if(!lane){fh[wave]=acc.hi;fl[wave]=acc.lo;fm[wave]=acc.mag;}
+        __syncthreads();
+        if(!tid){float v;const bool ok=ctl_ff_settle(fh,fl,fm,&v);refuse=!ok;if(ok)hidden[(long long)t*rank+j]=bf(v);}
+        __syncthreads();
+        if(!refuse)return;
+    }
+    double d=0;
+    if(preload){
+#pragma unroll
+        for(int i=0;i<ctrl_cols;++i){const int c=tid+i*ctrl_threads;if(c<n){
+            d+=double(bf(xr[i]*inv[0]))*bf16_to_f32(w0[i]);
+            d+=double(bf(mr[i]*inv[1]))*bf16_to_f32(w1[i]);}}
+    } else for(int c=tid;c<n;c+=256){
+        d+=double(bf(x[c]*inv[0]))*bf16_to_f32(weight[c]);
+        d+=double(bf(msg[c]*inv[1]))*bf16_to_f32(weight[n+c]);
+    }
+    for(int s=16;s;s/=2)d+=__shfl_down(d,s,32);
+    if(!lane)part[0][wave]=d;
+    __syncthreads();
+    if(tid<32){
+        double v=tid<8?part[0][tid]:0;
+        for(int s=4;s;s/=2)v+=__shfl_down(v,s,32);
+        if(!tid)hidden[(long long)t*rank+j]=bf(float(v));
+    }
+}
+__global__ void control_norm_down_rank(const float* x,const float* msg,const uint16_t* weight,float* hidden,
+                                       int n,int rank,float eps) {
+    control_norm_down_rank_body(x,msg,weight,hidden,n,rank,eps);
+}
+__global__ void r4dchain_control_norm_down_rank(const float* x,const float* msg,const uint16_t* weight,float* hidden,
+                                       int n,int rank,float eps) {
+    r4d_chain_wait();
+    control_norm_down_rank_body(x,msg,weight,hidden,n,rank,eps);
+    r4d_chain_done();
+}
