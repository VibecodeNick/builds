+// Two FP32 statistics per real-model stream per token.
+static int64_t depth_mix_scratch(const RadArgs* a) {
+    const int64_t m = rad_args_geti_or(a, "M", 0);
+    const int64_t streams = rad_args_geti_or(a, "streams", 0);
+    if (rad_args_geti_or(a, "n", 0) != 2304 || m < 1 || m > INT32_MAX || streams < 1 || streams > 8) return 0;
+    // Declarations can cover a range of M. Reserve the largest eligible
+    // runtime case in that range, including a later single-token decode.
+    if (streams < 2) return 0;
+    const int64_t rows = streams == 2 && m >= 128 ? 128 : 1;
+    return rows * streams * 2 * sizeof(float);
+}
