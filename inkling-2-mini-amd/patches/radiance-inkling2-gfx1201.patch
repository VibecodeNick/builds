+template <bool E, bool L> int launch(const RadArgs *a, RadStream stream) {
+  auto *x = r4d_opt(a, 0);
+  auto *w = r4d_opt(a, 1);
+  auto *y = r4d_opt(a, E ? 4 : 2);
+  if (!x || !w || !y || x->dtype != RAD_BF16 || w->dtype != RAD_BF16 ||
+      y->dtype != (L ? RAD_F32 : RAD_BF16))
+    return RAD_E_DTYPE;
+  int64_t n = r4d_geti_or(a, L ? "n_vocab" : "N", 0),
+          k = r4d_geti_or(a, L ? "n_embd" : "K", 0);
+  if (n <= 0 || n > (1 << 24) || k <= 0 || k > 65536)
+    return RAD_E_SHAPE;
+  long long rows = 0, xrows = 0;
+  auto yp = r4d_rows_pitch(y, n, &rows), xp = r4d_rows_pitch(x, k, &xrows);
+  if (rows <= 0 || rows > INT_MAX || xp < k || yp < n || xp > INT_MAX ||
+      yp > INT_MAX)
+    return RAD_E_SHAPE;
+  auto *r = E ? r4d_opt(a, 2) : nullptr;
+  auto *off = E ? r4d_opt(a, 3) : nullptr;
+  int e = 0, top = 0;
+  int64_t ep = 0;
+  bool sorted = false;
+  if constexpr (E) {
+    if (!r || !off || r->dtype != RAD_I32 || off->dtype != RAD_I32 ||
+        !r4d_contig(r) || !r4d_contig(off) || w->rank != 3)
+      return RAD_E_SHAPE;
+    e = r4d_geti_or(a, "n_expert", 0);
+    top = r4d_geti_or(a, "top_k", 0);
+    auto ord = r4d_gets(a, "a_order");
+    sorted = ord && !std::strcmp(ord, "sorted");
+    if (!ord || (!sorted && std::strcmp(ord, "token")))
+      return RAD_E_INVAL;
+    ep = w->stride[0];
+    if (e <= 0 || top <= 0 || rows % top || r4d_numel(r) < rows ||
+        r4d_numel(off) < e + 1 || w->shape[0] < e ||
+        xrows < (sorted ? rows : (rows + top - 1) / top))
+      return RAD_E_SHAPE;
+  } else if (w->rank != 2 || xrows < rows)
+    return RAD_E_SHAPE;
+  int iw = E ? 1 : 0;
+  if (w->stride[iw + 1] != 1 || w->shape[iw] < n || w->shape[iw + 1] < k ||
+      w->stride[iw] < k || w->stride[iw] > INT_MAX)
+    return RAD_E_SHAPE;
+  int grid_rows = int(rows > 65535 ? 65535 : rows);
+  dim3 grid((n + 7) / 8, grid_rows, (rows + grid_rows - 1) / grid_rows);
+  ordered_dot<E, L><<<grid, 256, 0, (hipStream_t)stream>>>(
+      (const uint16_t *)x->data, (const uint16_t *)w->data, y->data,
+      r ? (const int *)r->data : nullptr,
+      off ? (const int *)off->data : nullptr, e, top, sorted, rows, n, k, xp,
+      w->stride[iw], yp, ep);
+  return hipGetLastError() == hipSuccess ? RAD_OK : RAD_E_DEVICE;
+}
+struct MixInputs {
+  const float *data[8];
+  long long pitch[8];
+};
