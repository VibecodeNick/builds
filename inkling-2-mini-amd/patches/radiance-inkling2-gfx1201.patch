diff --git a/tools/inkling2_prepare.py b/tools/inkling2_prepare.py
new file mode 100644
index 0000000..ef02192
--- /dev/null
+++ b/tools/inkling2_prepare.py
@@ -0,0 +1,172 @@
+#!/usr/bin/env python3
+"""Decode Inkling 2 Mini's packed experts for rad-convert. CPU only, one expert at a time."""
+import argparse
+import json
+import math
+import os
+from pathlib import Path
+import shutil
+import struct
+import tempfile
+
+import torch
+from safetensors import safe_open
+
+
+FP4 = (0, .5, 1, 1.5, 2, 3, 4, 6, -0., -.5, -1, -1.5, -2, -3, -4, -6)
+
+
+def load_header(path):
+    with path.open('rb') as f:
+        size, = struct.unpack('<Q', f.read(8))
+        if size > 100_000_000:
+            raise ValueError(f"invalid safetensors header length {size}")
+        return json.loads(f.read(size)), size + 8
+
+
+def layout(source_header, groups, config):
+    out, transforms = {}, {}
+    offset = 0
+    experts = config['n_routed_experts']
+    hidden = config['hidden_size']
+    intermediate = config['intermediate_size']
+    for name, entry in sorted(source_header.items()):
+        if not name.startswith('model.llm.'):
+            continue
+        shape, dtype = entry['shape'], entry['dtype']
+        if '.mlp.experts.' in name:
+            if name.endswith(('_scale', '_amax', '_outer_scale_denominator')):
+                continue
+            if name.endswith('.w13_weight'):
+                rows, cols = 2 * intermediate, hidden
+            elif name.endswith('.w2_weight'):
+                rows, cols = hidden, intermediate
+            else:
+                raise ValueError(f"unknown expert tensor {name}")
+            kind = groups[name]['weight_transform']
+            if kind == 'nvfp4_nearest':
+                expect, scale_type, k, pack = 'U8', 'F8_E4M3', 16, 2
+                for suffix, scale_shape in [('_amax', [experts]), ('_outer_scale_denominator', [1])]:
+                    other = source_header[name + suffix]
+                    if (other['dtype'], other['shape']) != ('F32', scale_shape):
+                        raise ValueError(f"invalid {name}{suffix}")
+            elif kind == 'mxfp8_nearest':
+                expect, scale_type, k, pack = 'F8_E4M3', 'U8', 32, 1
+            else:
+                raise ValueError(f"unsupported {name} transform {kind}")
+            scale = source_header[name + '_scale']
+            if ((dtype, shape) != (expect, [experts, rows, cols // pack]) or cols % k
+                    or (scale['dtype'], scale['shape']) != (scale_type, [experts, rows, cols // k])):
+                raise ValueError(f"wrong {kind} weight or scale layout for {name}")
+            transforms[name] = kind
+            dtype, shape = 'BF16', [experts, rows, cols]
+        elif name in ('model.llm.embed.weight', 'model.llm.unembed.weight'):
+            if shape != [config['vocab_size'], hidden] or dtype != 'BF16':
+                raise ValueError(f"invalid vocabulary table {name}: {dtype} {shape}")
+            shape = [config['unpadded_vocab_size'], hidden]
+        elif dtype not in ('BF16', 'F32'):
+            raise ValueError(f"unexpected dense weight {name} {dtype}")
+        size = math.prod(shape) * {'F32': 4, 'BF16': 2}[dtype]
+        out[name] = dict(dtype=dtype, shape=shape, data_offsets=[offset, offset + size])
+        offset += size
+    if len(transforms) != 2 * config['num_hidden_layers']:
+        raise ValueError("expected gate/up and down expert weights at every physical layer")
+    return out, transforms
+
+
+def write_experts(out, src, name, kind, lut):
+    weights, scales = src.get_slice(name), src.get_slice(name + '_scale')
+    nvfp4 = kind == 'nvfp4_nearest'
+    if nvfp4:
+        amax = src.get_tensor(name + '_amax')
+        denom = src.get_tensor(name + '_outer_scale_denominator')
+        if not torch.isfinite(denom).all() or denom.item() <= 0 or not torch.isfinite(amax).all() or (amax < 0).any():
+            raise ValueError(f"invalid per-expert scale {name}")
+        # Transformers loads all expert source planes into the destination parameter
+        # dtype before Inkling2LoopDequantizeExperts widens the scales for arithmetic.
+        factors = amax.bfloat16().float() / denom.bfloat16().float()
+    for e in range(weights.get_shape()[0]):
+        w, s = weights[e], scales[e].float()
+        if nvfp4:
+            values = lut[w.long()].view(*s.shape, 16)
+            values.mul_(s.unsqueeze(-1)).mul_(factors[e])
+        else:
+            if torch.any(s == 255):
+                raise ValueError(f"invalid MXFP8 exponent {name}[{e}]")
+            values = w.float().view(*s.shape, 32)
+            values.mul_(torch.exp2(s - 127).unsqueeze(-1))
+        values = values.flatten(1).to(torch.bfloat16)
+        if not torch.isfinite(values).all():
+            raise ValueError(f"non-finite decoded weight {name}[{e}]")
+        if name.endswith('.w13_weight'):
+            values = torch.cat([values[0::2], values[1::2]], dim=0)
+        values.contiguous().view(torch.uint16).numpy().tofile(out)
+
+
+def prepare(srcdir, dest):
+    if dest.exists():
+        raise FileExistsError(dest)
+    config = json.loads((srcdir/'config.json').read_text())
+    if config['model_type'] != 'inkling2_loop':
+        raise ValueError("expected the Inkling 2 Mini model_type inkling2_loop")
+    config.pop('quantization_config', None)
+    files = set(json.loads((srcdir/'model.safetensors.index.json').read_text())['weight_map'].values())
+    if len(files) != 1:
+        raise ValueError("expected the single text checkpoint shard of Inkling 2 Mini")
+    path = srcdir / files.pop()
+    inp, data_start = load_header(path)
+    groups = {}
+    for group in json.loads((srcdir/'hf_quant_config.json').read_text())['model']['parameter_groups']:
+        for name in group['tensors']:
+            if name in groups:
+                raise ValueError(f'duplicate quantization group for {name}')
+            groups[name] = group
+    header, transforms = layout(inp, groups, config['text_config'])
+    raw = json.dumps(header, separators=(',', ':')).encode()
+    raw += b' ' * (-len(raw) % 8)
+    lut = torch.tensor(FP4)
+    codes = torch.arange(256)
+    lut = torch.stack((lut[codes & 15], lut[codes >> 4]), dim=-1)
+    dest.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory(prefix=dest.name + '.tmp-', dir=dest.parent) as scratch:
+        tmp = Path(scratch) / 'prepared'
+        tmp.mkdir()
+        with (tmp/'model.safetensors').open('wb') as out, path.open('rb') as source, safe_open(path, framework='pt', device='cpu') as tensors:
+            out.write(struct.pack('<Q',len(raw)))
+            out.write(raw)
+            for name, entry in header.items():
+                if name in transforms:
+                    write_experts(out, tensors, name, transforms[name], lut)
+                    print(f"{transforms[name]} -> BF16 {name} {entry['shape']}", flush=True)
+                else:
+                    lo, hi = inp[name]['data_offsets']
+                    source.seek(data_start + lo)
+                    remaining = entry['data_offsets'][1] - entry['data_offsets'][0]
+                    if remaining > hi - lo:
+                        raise ValueError(f"source too small at {name}")
+                    while remaining:
+                        chunk = source.read(min(8 << 20, remaining))
+                        if not chunk:
+                            raise EOFError(name)
+                        out.write(chunk)
+                        remaining -= len(chunk)
+                if out.tell() != 8 + len(raw) + entry['data_offsets'][1]:
+                    raise ValueError(f"wrong output size at {name}")
+        config['text_config']['vocab_size'] = config['text_config']['unpadded_vocab_size']
+        (tmp/'config.json').write_text(json.dumps(config, indent=2) + '\n')
+        for part in ('tokenizer.json', 'tokenizer_config.json', 'special_tokens_map.json', 'chat_template.jinja', 'generation_config.json'):
+            shutil.copyfile(srcdir/part, tmp/part)
+        os.rename(tmp, dest)
+    print(f"ready {dest} {len(header)} text tensors, {len(transforms)} decoded expert tensors", flush=True)
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('source', type=Path)
+    parser.add_argument('dest', type=Path)
+    parser.add_argument('--threads', type=int, default=2)
+    args = parser.parse_args()
+    if args.threads < 1:
+        parser.error('--threads must be positive')
+    torch.set_num_threads(args.threads)
+    prepare(args.source.resolve(), args.dest.resolve())
diff --git a/tools/inkling2_prepare_draft.py b/tools/inkling2_prepare_draft.py
new file mode 100644
index 0000000..af421e8
--- /dev/null
+++ b/tools/inkling2_prepare_draft.py
@@ -0,0 +1,65 @@
+#!/usr/bin/env python3
+"""Prepare the Inkling DSpark drafter for native Radiance --draft-model."""
+import argparse
+import json
+from pathlib import Path
+from tempfile import TemporaryDirectory
+import torch
+from safetensors import safe_open
+from safetensors.torch import save_file
+
+
+def main(src, dest):
+    torch.set_num_threads(3)
+    config = json.loads((src/'config.json').read_text())
+    draft = config['mtp_config'].copy()
+    vocab = config['text_config']['unpadded_vocab_size']
+    if (draft['block_size'], draft['markov_head_type'], draft['num_hidden_layers'], draft['target_layer_ids']) != (8, 'rnn_hidden', 3, [5,23,41,48]):
+        raise ValueError("unsupported DSpark config")
+    if dest.exists():
+        raise FileExistsError(dest)
+    dense_files = json.loads((src/'model.safetensors.index.json').read_text())['weight_map']
+    with safe_open(src/'mtp.safetensors', framework='pt') as orig:
+        tensors = {k: orig.get_tensor(k) for k in orig.keys()}
+    if any(x.dtype != torch.bfloat16 for x in tensors.values()):
+        raise ValueError("expected BF16 draft weights")
+    rank = draft['markov_rank']
+    projection = tensors.pop('markov_head.hidden_out.weight').double()
+    bias = tensors.pop('markov_head.hidden_out.bias').double()
+    weight_key = 'model.llm.unembed.weight'
+    with safe_open(src/dense_files[weight_key], framework='pt') as target:
+        head = target.get_slice(weight_key)
+        folded = torch.empty((vocab,rank), dtype=torch.bfloat16)
+        folded_bias = torch.empty(vocab, dtype=torch.bfloat16)
+        for start in range(0,vocab,2048):
+            end = min(vocab,start+2048)
+            rows = head[start:end].double()
+            folded[start:end] = rows @ projection
+            folded_bias[start:end] = rows @ bias
+    tensors['markov_head.fold.weight'] = folded
+    tensors['markov_head.fold.bias'] = folded_bias
+    tensors['markov_head.markov_w1.weight'] = tensors['markov_head.markov_w1.weight'][:vocab].contiguous()
+    raw = tensors.pop('markov_head.rnn_proj.weight')
+    tensors['markov_head.recurrent.weight'] = raw[:, :2*rank].contiguous()
+    tensors['markov_head.context.weight'] = raw[:, 2*rank:].contiguous()
+    tensors['markov_head.rnn_proj.bias'] = tensors['markov_head.rnn_proj.bias'].float()
+    mix = tensors.pop('fuse_weight').float().softmax(dim=-1).bfloat16()
+    for i in range(mix.shape[0]):
+        tensors[f'fuse_alpha.{i}'] = mix[i].clone()
+    draft.update(architectures=['Inkling2DSpark'], model_type='inkling2_dspark',
+                 vocab_size=vocab, final_logit_softcapping=config['text_config']['final_logit_softcapping'])
+    with TemporaryDirectory(dir=dest.parent) as stage:
+        tmp = Path(stage)/'draft'
+        tmp.mkdir()
+        (tmp/'config.json').write_text(json.dumps(draft, indent=2)+'\n')
+        save_file(tensors, tmp/'model.safetensors')
+        tmp.rename(dest)
+    print("prepared", dest, len(tensors), "tensors", folded.shape, flush=True)
+
+
+if __name__ == '__main__':
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('source',type=Path)
+    p.add_argument('dest',type=Path)
+    args=p.parse_args()
+    main(args.source,args.dest)
