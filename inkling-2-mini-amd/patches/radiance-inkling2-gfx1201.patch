+extern "C" int r4d_inkling2_gate(const RadArgs* a,RadStream stream) {
+    bool chain=r4d_geti_or(a,"chain",0)!=0;
+    const auto *gate=r4d_opt(a,0), *ctx=r4d_opt(a,1), *out=r4d_opt(a,2);
+    const int n=r4d_geti_or(a,"n",0);
+    if (!gate || gate->dtype!=RAD_BF16 || !dense(ctx,RAD_BF16) || !dense(out,RAD_BF16))
+        return R4D_NO(RAD_E_DTYPE);
+    long long count=r4d_numel(out),mg=0;
+    const auto gs=r4d_rows_pitch(gate,n,&mg);   // the gate's rows at their own pitch (a column slice)
+    if(n<1 || gs<0) return R4D_NO(RAD_E_STRIDE);
+    if(count<1 || count%n || mg!=count/n || r4d_numel(ctx)!=count) return R4D_NO(RAD_E_SHAPE);
+    chain=chain && count<=(long long)64*4096;
+    if(chain) r4dchain_ink_gate<<<(count+255)/256,256,0,(hipStream_t)stream>>>((const uint16_t*)gate->data,
+        (const uint16_t*)ctx->data,(uint16_t*)out->data,count,n,gs);
+    else ink_gate<<<(count+255)/256,256,0,(hipStream_t)stream>>>((const uint16_t*)gate->data,
+        (const uint16_t*)ctx->data,(uint16_t*)out->data,count,n,gs);
+    return launched();
+}
