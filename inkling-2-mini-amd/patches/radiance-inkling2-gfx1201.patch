@@ -0,0 +1,118 @@
+#!/usr/bin/env python3
+"""Extract the Inkling vision tower and projector from the read-only HF shard."""
+import argparse
+import json
+import math
+import os
+from pathlib import Path
+import shutil
+import struct
+import tempfile
+
+
+def extract(src, dest):
+    if dest.exists():
+        raise FileExistsError(dest)
+    weight_map = json.loads((src/'model.safetensors.index.json').read_text())['weight_map']
+    files = {name: file for name, file in weight_map.items() if name.startswith('model.visual.')}
+    if not files or len(set(files.values())) != 1:
+        raise ValueError('expected a single source shard with visual weights')
+    dest.parent.mkdir(parents=True, exist_ok=True)
+    with (src/next(iter(files.values()))).open('rb') as source, tempfile.TemporaryDirectory(dir=dest.parent) as tmp:
+        length, = struct.unpack('<Q', source.read(8))
+        if length > 100_000_000:
+            raise ValueError('invalid source header')
+        original = json.loads(source.read(length))
+        offset = 0
+        header = {}
+        for name in sorted(files):
+            t = original[name]
+            lo, hi = t['data_offsets']
+            if t['dtype'] != 'BF16' or hi-lo != 2*math.prod(t['shape']):
+                raise ValueError(f'unexpected shape or storage for {name}')
+            header[name] = dict(dtype='BF16', shape=t['shape'], data_offsets=[offset,offset+hi-lo])
+            offset += hi-lo
+        raw = json.dumps(header,separators=(',',':')).encode()
+        raw += b' ' * (-len(raw)%8)
+        stage = Path(tmp)/'vision'
+        stage.mkdir()
+        with (stage/'model.safetensors').open('wb') as out:
+            out.write(struct.pack('<Q',len(raw)))
+            out.write(raw)
+            for name in header:
+                lo,hi=original[name]['data_offsets']
+                source.seek(8+length+lo)
+                remaining=hi-lo
+                while remaining:
+                    chunk=source.read(min(8<<20,remaining))
+                    if not chunk:
+                        raise EOFError(name)
+                    out.write(chunk)
+                    remaining-=len(chunk)
+        for file in ('config.json','processor_config.json'):
+            shutil.copyfile(src/file,stage/file)
+        stage.rename(dest)
+    print(f'{dest}: {len(header)} BF16 visual tensors, {offset} payload bytes')
+
+
+def combine(text, vision, dest):
+    """Make a normalized joint HF source. The two persistent weight shards stay in place."""
+    if dest.exists():
+        raise FileExistsError(dest)
+    config = json.loads((text/'config.json').read_text())
+    visual_config = json.loads((vision/'config.json').read_text())['vision_config']
+    if config['vision_config'] != visual_config:
+        raise ValueError('different vision configs for the target and sidecar')
+    config['vision_config']['patch_size'] = visual_config['native_patch_size']
+    config['image_token_id'] = 200054
+    dest.parent.mkdir(parents=True,exist_ok=True)
+    with tempfile.TemporaryDirectory(dir=dest.parent) as tmp:
+        stage=Path(tmp)/'multimodal'
+        stage.mkdir()
+        (stage/'config.json').write_text(json.dumps(config,indent=2)+'\n')
+        for name in ('tokenizer.json','tokenizer_config.json','special_tokens_map.json','generation_config.json'):
+            (stage/name).symlink_to(os.path.relpath((text/name).resolve(),dest.resolve()))
+        (stage/'processor_config.json').symlink_to(os.path.relpath((vision/'processor_config.json').resolve(),dest.resolve()))
+        # Radiance staged the picture bytes already. Its marker expands to the image start,
+        # one placeholder per 40x40 cell and the end token, just as HF's image branch does.
+        template=(text/'chat_template.jinja').read_text()
+        here='            {%- elif part.type in ("image", "input_image", "image_url") -%}'
+        branch='''            {%- elif part.type == "media_marker" -%}
+                {%- if message.role not in ("user", "tool") -%}
+                    {{- raise_exception("Image content is only supported for user and tool messages") -}}
+                {%- endif -%}
+                {{- rtok ~ part.text -}}
+'''
+        if template.count(here) != 1:
+            raise ValueError('could not identify the Inkling image template branch')
+        (stage/'chat_template.jinja').write_text(template.replace(here,branch+here))
+        index={}
+        for n,folder in enumerate((text,vision),1):
+            shard='model-%05d-of-00002.safetensors' % n
+            path=(folder/'model.safetensors').resolve()
+            (stage/shard).symlink_to(os.path.relpath(path,dest.resolve()))
+            with path.open('rb') as f:
+                length, = struct.unpack('<Q', f.read(8))
+                if length>100_000_000: raise ValueError('invalid safetensors header')
+                header=json.loads(f.read(length))
+            for key in header:
+                if key=='__metadata__': continue
+                if key in index: raise ValueError(f'duplicate {key}')
+                index[key]=shard
+        (stage/'model.safetensors.index.json').write_text(json.dumps({'weight_map':index},indent=2)+'\n')
+        stage.rename(dest)
+    print(f'{dest}: {len(index)} native target and vision matrices')
+
+
+
+
+if __name__ == '__main__':
+    ap=argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('source',type=Path)
+    ap.add_argument('dest',type=Path)
+    ap.add_argument('--text',type=Path,help='combine the prepared vision source with this normalized text source')
+    args=ap.parse_args()
+    if args.text:
+        combine(args.text,args.source,args.dest)
+    else:
+        extract(args.source,args.dest)
