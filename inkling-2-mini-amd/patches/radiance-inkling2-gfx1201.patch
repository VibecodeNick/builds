+// Stage one. Eight bottleneck rows share a normalized token; every bottleneck row
+// is computed just once regardless of the number of later output-channel tiles.
+__device__ __forceinline__ void control_down_body(const float* x,const float* msg,const uint16_t* down,float* h,
+                             int n,int rank,float eps) {
+    extern __shared__ uint16_t normalized[];
+    __shared__ double partial[2][8];__shared__ float inv[2];
+    int t=blockIdx.x,lane=threadIdx.x%32,wave=threadIdx.x/32;
+    x+=(long long)t*n;msg+=(long long)t*n;
+    double a=0,b=0;
+#ifndef R4D_PROBE_SKIP_NORM
+    for(int c=threadIdx.x;c<n;c+=256){a+=double(x[c])*x[c];b+=double(msg[c])*msg[c];}
+    for(int sh=16;sh;sh>>=1){a+=__shfl_xor(a,sh,32);b+=__shfl_xor(b,sh,32);}
+#else
+    a=1;b=1;
+#endif
+    if(!lane){partial[0][wave]=a;partial[1][wave]=b;}
+    __syncthreads();
+    if(threadIdx.x<2) {
+        double s=0;
+        for(int j=0;j<8;++j)s+=partial[threadIdx.x][j];
+        inv[threadIdx.x]=float(1.0/sqrt(s/n+eps));
+    }
+    __syncthreads();
+    for(int c=threadIdx.x;c<n;c+=256){
+        normalized[c]=f32_to_bf16(x[c]*inv[0]);
+        normalized[n+c]=f32_to_bf16(msg[c]*inv[1]);
+    }
+    __syncthreads();
+    // A grid of (m, 1) at prefill heights: the token is normalized once and each wave takes every
+    // eighth bottleneck row in turn (before, eight blocks each redid the F64 norms: 0.6 of 3.1 ms at
+    // M=2048). Decode and verify heights keep the (m, rank/8) grid for its parallelism.
+    for(int j=blockIdx.y*8+wave;j<rank;j+=8*gridDim.y) {
+#ifndef R4D_PROBE_SKIP_DOT
+        float v=bounded_dot_bf16(normalized,down+(long long)j*2*n,2*n,lane);
+#else
+        float v=bf16_to_f32(normalized[lane])+bf16_to_f32(down[(long long)j*2*n+lane]);
+#endif
+        if(!lane)h[(long long)t*rank+j]=v;
+    }
+}
+__global__ void control_down(const float* x,const float* msg,const uint16_t* down,float* h,
+                             int n,int rank,float eps) {
+    control_down_body(x,msg,down,h,n,rank,eps);
+}
+__global__ void r4dchain_control_down(const float* x,const float* msg,const uint16_t* down,float* h,
+                             int n,int rank,float eps) {
+    r4d_chain_wait();
+    control_down_body(x,msg,down,h,n,rank,eps);
+    r4d_chain_done();
+}
