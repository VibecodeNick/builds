+namespace {
+// Select once per process. The scalar path retains the original arithmetic;
+// cached stores those exact BF16 scores. Grouped decode reuses each KV page
+// across the three query heads with RDNA4 matrix instructions.
+int decode_mode() {
+    static const int mode=[]{
+        const char* name=std::getenv("R4D_INKLING2_DECODE");
+        if(!name || !std::strcmp(name,"grouped"))return 2;
+        if(!std::strcmp(name,"cached"))return 1;
+        return 0;
+    }();
+    return mode;
+}
+}
+extern "C" int64_t r4d_inkling2_scratch(const RadArgs*) {
+    return (int64_t)part_budget*decode_rows*(hd+2)*sizeof(float)+(decode_mode()?decode_score_capacity*sizeof(uint16_t):0);
+}
+
+extern "C" int r4d_inkling2_attn(const RadArgs* a,RadStream stream) {
+    bool chain=r4d_geti_or(a,"chain",0)!=0;
+    auto op=[&](int i){return r4d_opt(a,i);};
+    const auto *q=op(0), *kv=op(1), *bt=op(2), *su=op(3), *cu=op(6), *r=op(7);
+    const auto *sink=op(8), *table=op(9), *out=op(10);
+    if(!q || !kv || !bt || !su || !r || !sink || !table || !out) return R4D_NO(RAD_E_INVAL);
+    const int h=r4d_geti_or(a,"n_head",0), g=r4d_geti_or(a,"gqa",0), e=r4d_geti_or(a,"rel_extent",0);
+    const int win=r4d_geti_or(a,"window",0);
+    if(h<1 || g<1 || h%g || win<0 || e<1 || r4d_geti_or(a,"causal",0)!=1 ||
+       r4d_geti_or(a,"head_dim",0)!=hd || r4d_geti_or(a,"d_rel",0)!=dr ||
+       op(4) || op(5)) return R4D_NO(RAD_E_UNSUPPORTED);
+    if(q->dtype!=RAD_BF16 || r->dtype!=RAD_BF16 || sink->dtype!=RAD_BF16 || out->dtype!=RAD_BF16 ||
+       !dense(table,RAD_BF16) || (!dense(kv,RAD_I8) && !dense(kv,RAD_BF16)) || bt->dtype!=RAD_I32 ||
+       !dense(su,RAD_I32) || (cu && !dense(cu,RAD_I32))) return R4D_NO(RAD_E_DTYPE);
+    long long m=0,mr=0,ms=0,mo=0;
+    const auto qld=r4d_rows_pitch(q,h*hd,&m), rld=r4d_rows_pitch(r,h*dr,&mr);
+    const auto sld=r4d_rows_pitch(sink,h,&ms), old=r4d_rows_pitch(out,h*hd,&mo);
+    const int seqs=r4d_numel(su), cols=r4d_dim(bt,1);
+    if (qld<0 || rld<0 || sld<0 || old<0 || bt->stride[1]!=1) return R4D_NO(RAD_E_STRIDE);
+    if (m<=0 || m>INT_MAX/h || mr!=m || ms!=m || mo!=m || seqs<=0 || (!cu && m%seqs) ||
+        (cu && r4d_numel(cu)!=seqs+1) || bt->rank!=2 || bt->shape[0]!=seqs || cols<=0 ||
+        table->rank!=2 || table->shape[0]!=dr || table->shape[1]!=e || kv->rank!=4 ||
+        kv->shape[1]!=h/g || kv->shape[2]!=16 || kv->shape[3]!=2*hd+(kv->dtype==RAD_I8?4:0))
+        return R4D_NO(RAD_E_SHAPE);
+    // A rank with fewer heads still partitions each head's context in the full-model order.
+    const auto split_heads=r4d_geti_or(a,"split_heads",h);
+    if(split_heads<h || split_heads>INT_MAX) return R4D_NO(RAD_E_SHAPE);
+    // Rows up to decode_rows share the one-token step's budget a row (see decode_rows).
+    const long long budget=m<=decode_rows ? (long long)part_budget*m : (long long)part_budget;
+    int splits=std::max(1,std::min(32,int(budget/(m*split_heads))));
+    int upper=cols*16;
+    if (a->kv_used_max_h>0) upper=std::min(upper,(int)a->kv_used_max_h);
+    if (win) upper=std::min(upper,win);
+    splits=std::min(splits,std::max(1,(upper+255)/256));
+    if (splits>1 && (!a->scratch || a->scratch_bytes < (long long)m*h*splits*(hd+2)*4)) return R4D_NO(RAD_E_SHAPE);
+    chain=chain && m<=64;   // decode heights only: a prefill grid's blocks would serialise on the chain counter
+    Attention arg={(const uint16_t*)q->data,(const uint16_t*)r->data,(const uint16_t*)table->data,
+        (const uint16_t*)sink->data,kv->data,(const int*)bt->data,(const int*)su->data,
+        cu?(const int*)cu->data:nullptr,(uint16_t*)out->data,(float*)a->scratch,(int)m,h,g,seqs,
+        (int)kv->shape[0],cols,e,win,splits,0,bt->stride[0],qld,rld,sld,old,(float)r4d_getf(a,"scale",1./sqrt(double(hd)))};
+    const int64_t metadata=(int64_t)part_budget*decode_rows*(hd+2)*sizeof(float);
+    if(decode_mode()!=0 && m<=8 && splits>1 && a->scratch && a->scratch_bytes>metadata) {
+        const int64_t room=(a->scratch_bytes-metadata)/sizeof(uint16_t);
+        const int64_t capacity=win?std::min<int64_t>(int64_t(cols)*16,win):int64_t(cols)*16;
+        arg.score_stride=std::min<int64_t>(capacity,room/(m*h));
+        arg.score_cache=(uint16_t*)((uint8_t*)a->scratch+metadata);
+    }
+    static const bool enable_tiled=[] {
+        const char* flag=std::getenv("R4D_INKLING2_WMMA_PREFILL");
+        return flag && flag[0]=='1';
+    }();
+    const bool fragment_aligned=qld%8==0 && reinterpret_cast<uintptr_t>(q->data)%16==0 &&
+                                (kv->dtype==RAD_I8 || reinterpret_cast<uintptr_t>(kv->data)%16==0);
+    if (decode_mode()==2 && g==3 && m<=8 && upper>=1024 && splits>1 && kv->dtype==RAD_I8 && fragment_aligned) {
+        if (m>seqs && !win && a->kv_used_max_h>0) {
+            // Several rows a sequence in a full-context layer: each row folds in its own one-token
+            // step's count (ink_row_splits). The grid carries the next bucket's parts too, for the
+            // rows that have crossed into it; a block past its row's count returns at once.
+            const long long cap=r4d_geti_or(a,"max_ctx",0);
+            const int next=std::max(1,std::min(32,(int)(((long long)upper+1024+255)/256)));
+            if ((long long)m*h*next*(hd+2)*4 <= a->scratch_bytes && next<=int(budget/(m*split_heads))) {
+                arg.splits=splits=next;
+                arg.reserved=cap>0 && cap<INT_MAX ? (int)cap : INT_MAX;
+            }
+        }
+        dim3 grid(m,h/g,splits);
+        if(chain) r4dchain_grouped_decode<true><<<grid,128,0,(hipStream_t)stream>>>(arg);
+    else grouped_decode<true><<<grid,128,0,(hipStream_t)stream>>>(arg);
+        if(chain) r4dchain_grouped_decode<false><<<grid,128,0,(hipStream_t)stream>>>(arg);
+    else grouped_decode<false><<<grid,128,0,(hipStream_t)stream>>>(arg);
+        if(chain) r4dchain_merge<<<dim3(m,h),hd,0,(hipStream_t)stream>>>(arg);
+    else merge<<<dim3(m,h),hd,0,(hipStream_t)stream>>>(arg);
+        return launched();
+    }
+    if (enable_tiled && m>=32 && seqs<=8 && fragment_aligned) {
+        // The bias table transposed to [distance][d_rel] in scratch (unused by the tiled kernel
+        // otherwise): a score then reads its sixteen bf16 as two 16-byte words instead of sixteen
+        // 2-byte loads a row apart. Same values, same FMA order.
+        if(a->scratch && a->scratch_bytes>=(long long)dr*e*2) {
+            rel_table_transpose<<<(dr*e+255)/256,256,0,(hipStream_t)stream>>>((const uint16_t*)table->data,(uint16_t*)a->scratch,e);
+            const int trc=launched();
+            if(trc!=RAD_OK) return trc;
+            arg.score_cache=(uint16_t*)a->scratch;
+        }
+        dim3 grid((m+15)/16,h,seqs);
+        if(kv->dtype==RAD_I8)tiled_prefill<true><<<grid,32*prefill_waves,0,(hipStream_t)stream>>>(arg);
+        else tiled_prefill<false><<<grid,32*prefill_waves,0,(hipStream_t)stream>>>(arg);
+        return launched();
+    }
+    if (splits>1) {
+        if (kv->dtype==RAD_I8) { if(chain) r4dchain_paged<true,true><<<dim3(m,h,splits),threads,0,(hipStream_t)stream>>>(arg);
+            else paged<true,true><<<dim3(m,h,splits),threads,0,(hipStream_t)stream>>>(arg); }
+        else { if(chain) r4dchain_paged<false,true><<<dim3(m,h,splits),threads,0,(hipStream_t)stream>>>(arg);
+            else paged<false,true><<<dim3(m,h,splits),threads,0,(hipStream_t)stream>>>(arg); }
+        const int rc=launched();
+        if(rc!=RAD_OK) return rc;
+    }
+    if (kv->dtype==RAD_I8) { if(chain) r4dchain_paged<true,false><<<dim3(m,h,splits),threads,0,(hipStream_t)stream>>>(arg);
+        else paged<true,false><<<dim3(m,h,splits),threads,0,(hipStream_t)stream>>>(arg); }
+    else { if(chain) r4dchain_paged<false,false><<<dim3(m,h,splits),threads,0,(hipStream_t)stream>>>(arg);
+        else paged<false,false><<<dim3(m,h,splits),threads,0,(hipStream_t)stream>>>(arg); }
+    int rc=launched();
+    if (rc!=RAD_OK || splits==1) return rc;
+    if(chain) r4dchain_merge<<<dim3(m,h),threads,0,(hipStream_t)stream>>>(arg);
+    else merge<<<dim3(m,h),threads,0,(hipStream_t)stream>>>(arg);
+    return launched();
+}
