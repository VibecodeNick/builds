+    const int first_pass=!stats_only && a.splits>1 ? 1 : 0;
+    const int last_pass=stats_only ? 0 : 1;
+    for(int pass=first_pass; pass<=last_pass; ++pass) {
+        float mx=-INFINITY,sum=0;
+        if(part==0 && wave==0) { mx=bf16_to_f32(a.sink[t*a.sink_stride+h]); sum=1; }
+        for (int j=lo+wave; j<hi; j+=waves) {
+            int block=a.bt[seq*a.bt_stride+j/16];
+            if (block<0 || block>=a.blocks) continue;
+            long long slot=((long long)block*kvheads+h/a.gqa)*16+j%16;
+            float ks=1,vs=1;
+            if constexpr (int8_kv) {
+                const auto* scales=(const __half*)((const int8_t*)a.kv+slot*(2*hd+4)+2*hd);
+                ks=__half2float(scales[0]); vs=__half2float(scales[1]);
+            }
+            float score;
+            const int column=j-begin;
+            uint16_t* cached=a.score_cache && column<a.score_stride ?
+                a.score_cache+((long long)t*a.heads+h)*a.score_stride+column : nullptr;
+            if(!stats_only && pass==1 && cached) {
+                score=bf16_to_f32(*cached);
+            } else {
+                float dot=0;
+    #pragma unroll
+                for (int i=0; i<hd/32; ++i) {
+                    const int c=lane+i*32;
+                    float k;
+                    if constexpr (int8_kv) k=float(((const int8_t*)a.kv)[slot*(2*hd+4)+c])*ks;
+                    else k=bf16_to_f32(((const uint16_t*)a.kv)[slot*(2*hd)+c]);
+                    dot+=query[i]*k;
+                }
+                dot=wave_sum(dot);
+                const int distance=pos-j;
+                float bias=lane<dr && distance<a.extent ? r*bf16_to_f32(a.table[lane*a.extent+distance]) : 0;
+                bias=wave_sum(bias);
+                score=bf(bf(bf(dot)*a.scale)+bf(bias));
+                if(stats_only && cached && !lane)*cached=f32_to_bf16(score);
+            }
+            if (pass==0) {
+                const float next=fmaxf(mx,score);
+                sum=sum*expf(mx-next)+expf(score-next); mx=next;
+            } else {
+                const float weight=bf(expf(score-row_max)/denominator);
+#pragma unroll
+                for (int i=0; i<hd/32; ++i) {
+                    const int c=hd+lane+i*32;
+                    float v;
+                    if constexpr (int8_kv) v=float(((const int8_t*)a.kv)[slot*(2*hd+4)+c])*vs;
+                    else v=bf16_to_f32(((const uint16_t*)a.kv)[slot*(2*hd)+c]);
+                    value[i]+=v*weight;
+                }
+            }
+        }
+        if (pass==0) {
+            if (!lane) { maxima[wave]=mx; sums[wave]=sum; }
+            __syncthreads();
+            if(threadIdx.x==0) {
+                float m=-INFINITY,den=0;
+                for(int w=0;w<waves;++w) m=fmaxf(m,maxima[w]);
+                for(int w=0;w<waves;++w) if(sums[w]) den+=sums[w]*expf(maxima[w]-m);
+                if (stats_only) { parts[part*(hd+2)+hd]=m; parts[part*(hd+2)+hd+1]=den; }
+                else { row_max=m; denominator=den; }
+            }
+            __syncthreads();
+        }
+    }
+    if constexpr (!stats_only) {
+#pragma unroll
+        for(int i=0; i<hd/32; ++i) accum[wave][lane+32*i]=value[i];
+        __syncthreads();
+        float val=0;
+        for(int w=0;w<waves;++w) val+=accum[w][threadIdx.x];
+        if (a.splits==1) a.out[t*a.out_stride+h*hd+threadIdx.x]=f32_to_bf16(val);
+        else parts[part*(hd+2)+threadIdx.x]=val;
+    }
+}
+template<bool int8_kv, bool stats_only>
+__global__ void paged(Attention a) {
+    paged_body<int8_kv,stats_only>(a);
+}
