+        (const int*)coord->data,(const uint16_t*)c->data,(const uint16_t*)cp->data,m,n,side);
+    return hipGetLastError()==hipSuccess?RAD_OK:R4D_NO(RAD_E_DEVICE);
+}
+extern "C" int r4d_inkling2_vrope(const RadArgs* a,RadStream s) {
+    const auto *x=r4d_opt(a,0),*coord=r4d_opt(a,1);
+    const int heads=r4d_geti_or(a,"n_head",0),d=r4d_geti_or(a,"head_dim",0);
+    const float theta=r4d_getf(a,"theta",0);
+    if(!b16(x)||heads<=0||d<=0||d%4||theta<=0||r4d_numel(x)%(3*heads*d)) return R4D_NO(RAD_E_SHAPE);
+    const auto m=r4d_numel(x)/(3*heads*d);
+    if(m<=0||m>65535||!coords(coord,m)) return R4D_NO(RAD_E_SHAPE);
+    rotate<<<dim3((heads*d+255)/256,m),256,0,(hipStream_t)s>>>((uint16_t*)x->data,(const int*)coord->data,m,heads,d,theta);
+    return hipGetLastError()==hipSuccess?RAD_OK:R4D_NO(RAD_E_DEVICE);
+}
