+extern "C" int r4d_inkling2_add_residual(const RadArgs* a,RadStream stream) {
+    bool chain=r4d_geti_or(a,"chain",0)!=0;
+    const auto *x=r4d_opt(a,0),*delta=r4d_opt(a,1),*out=r4d_opt(a,2);
+    if(!x||!delta||!out||x->dtype!=RAD_F32||delta->dtype!=RAD_BF16||out->dtype!=RAD_F32)return R4D_NO(RAD_E_DTYPE);
+    int n=r4d_geti_or(a,"n",0),round=r4d_geti_or(a,"round_bf16",-1);
+    if(n<1||(round!=0&&round!=1))return R4D_NO(RAD_E_SHAPE);
+    long long m=0,md=0,mo=0;
+    auto xs=r4d_rows_pitch(x,n,&m),ds=r4d_rows_pitch(delta,n,&md),os=r4d_rows_pitch(out,n,&mo);
+    if(xs<0||ds<0||os<0)return R4D_NO(RAD_E_STRIDE);
+    if(m<1||m>INT_MAX||m!=md||m!=mo)return R4D_NO(RAD_E_SHAPE);
+    chain=chain && m<=64;
+    const dim3 grid((n+255)/256,std::min<long long>(m,65535));
+    if(round) { if(chain) r4dchain_add_residual<true><<<grid,256,0,(hipStream_t)stream>>>((const float*)x->data,
+        (const uint16_t*)delta->data,(float*)out->data,n,m,xs,ds,os);
+        else add_residual<true><<<grid,256,0,(hipStream_t)stream>>>((const float*)x->data,
+        (const uint16_t*)delta->data,(float*)out->data,n,m,xs,ds,os); }
+    else { if(chain) r4dchain_add_residual<false><<<grid,256,0,(hipStream_t)stream>>>((const float*)x->data,
+        (const uint16_t*)delta->data,(float*)out->data,n,m,xs,ds,os);
+    else add_residual<false><<<grid,256,0,(hipStream_t)stream>>>((const float*)x->data,
+        (const uint16_t*)delta->data,(float*)out->data,n,m,xs,ds,os); }
+    return launched();
+}
