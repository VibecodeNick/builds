index 0000000..354e744
--- /dev/null
+++ b/arch/inkling2/vision.h
@@ -0,0 +1,213 @@
+// Inkling 2's per-image ViT. One class row precedes native patches, and the processor
+// orders them by 2x2 merge block. Output rows already have the language model's hidden width.
+#pragma once
+#include <arch/rad_arch.h>
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <vector>
+
+namespace inkling2 {
+using namespace rad::arch;
+struct InkVision {
+    struct Linear {rad_weight weight=0,bias=0; rad_op op=0;};
+    struct Norm {rad_weight gain=0,bias=0; rad_op op=0;};
+    struct Block {
+        Norm ln1,ln2;
+        Linear qkv,projection,up,down;
+        rad_weight scale1=0,scale2=0;
+        rad_op rope=0,attn=0,scale_a=0,add_a=0,scale_b=0,add_b=0;
+    };
+    bool on=false;
+    int n=0,heads=0,ff=0,dim=0,patch_dim=0,proj_dim=0,text_dim=0,rows=0,merged=0;
+    rad_weight patch=0,position=0,cls=0,clspos=0,proj1=0,proj2=0;
+    rad_op stem=0,addpos=0,iota=0,gather=0,proj_in=0,gelu=0,proj_out=0;
+    Norm pre;
+    rad_buf x=0,h=0,qkv=0,a=0,up=0,seq=0,patches=0,mid=0,active=0,out=0;
+    std::vector<Block> layers;
+
+    int declare(RadBuilder* b,const RadModelMeta* m,const RadBuildCtx* c,Names& nm,int hidden,int first_group) {
+        if(c->max_enc_patches<=0 ||
+           std::strcmp(rad_meta_gets(m,"vision_config.model_type",""),"inkling2_vision")) return RAD_OK;
+        const char* pname=nm.f("v.patch.weight");
+        RAD_ARCH_TRY(map_copy(b,pname,nm.ckpt("model.visual.backbone.embeddings.patch_embedding.weight")));
+        RadEncoding enc{};
+        if(!weight_enc(b,pname,&enc)) return RAD_OK;
+        auto v=[&](const char* key,int def=0){return (int)rad_meta_geti(m,nm.f("vision_config.%s",key),def);};
+        n=v("hidden_size");heads=v("num_attention_heads"); int depth=v("num_hidden_layers");
+        int p=v("native_patch_size",v("patch_size")), merge=v("adapter_merge_size",v("spatial_merge_size"));
+        int side=v("posemb_grid_size");
+        ff=v("intermediate_size",int(std::lround(n*rad_meta_getf(m,"vision_config.mlp_ratio",4.))));
+        proj_dim=v("projection_hidden_dim");text_dim=v("text_hidden_size");
+        const float eps=rad_meta_getf(m,"vision_config.layer_norm_eps",1.e-5);
+        const double theta=rad_meta_getf(m,"vision_config.rope_parameters.rope_theta",10000.);
+        if(n<1||heads<1||n%heads||n/heads%4||depth<=0||p<1||side<1||merge!=2||
+           ff<=0||proj_dim<=0||hidden!=text_dim||v("num_channels",3)!=3||
+           std::strcmp(rad_meta_gets(m,"vision_config.hidden_act","gelu"),"gelu")||
+           !std::strcmp(rad_meta_gets(m,"vision_config.projector_bias","false"),"true"))
+            return RAD_E_UNSUPPORTED;
+        dim=n/heads;patch_dim=p*p*3;
+        rows=c->shape_probe?std::max<int>(5,std::min(c->max_enc_patches,c->max_tok)):c->max_enc_patches;
+        merged=rows/4;
+        if(!merged) return RAD_E_SHAPE;
+        auto bw=[&](const char* logical,const char* source,std::initializer_list<int64_t> shape,RadWeightGroup group){
+            if(map_copy(b,logical,source)!=RAD_OK) return rad_weight(0);
+            return decl_w(b,logical,RAD_BF16,shape,RAD_ACCESS_PER_REQUEST,RAD_SHARD_NONE,group);
+        };
+        auto wt=[&](const char* logical,const char* path,std::initializer_list<int64_t> shape) {
+            return bw(nm.f("v.%s",logical),nm.ckpt("model.visual.%s",path),shape,grp_model());
+        };
+        patch=decl_w(b,pname,RAD_BF16,{n,patch_dim},RAD_ACCESS_PER_REQUEST,RAD_SHARD_NONE,grp_model());
+        position=wt("position","backbone.embeddings.position_embedding",{side*side,n});
+        cls=wt("class","backbone.embeddings.class_embedding",{n});
+        clspos=wt("class_position","backbone.embeddings.cls_position_embedding",{n});
+        pre.gain=wt("pre_ln.weight","backbone.ln_pre.weight",{n});
+        pre.bias=wt("pre_ln.bias","backbone.ln_pre.bias",{n});
+        proj1=wt("projector.in","proj_in.weight",{proj_dim,4*n});
+        proj2=wt("projector.out","proj_out.weight",{text_dim,proj_dim});
+        if(!patch||!position||!cls||!clspos||!pre.gain||!pre.bias||!proj1||!proj2) return RAD_E_INVAL;
+        layers.resize(depth);
+        for(int i=0;i<depth;++i) {
+            auto& l=layers[i];auto group=grp_layer(first_group+i);
+            auto src=[&](const char* name){return nm.ckpt("model.visual.backbone.layers.%d.%s",i,name);};
+            auto name=[&](const char* key){return nm.f("v.blk.%d.%s",i,key);};
+            auto w=[&](const char* key,std::initializer_list<int64_t> shape){return bw(name(key),src(key),shape,group);};
+            l.ln1.gain=w("ln_1.weight",{n});l.ln1.bias=w("ln_1.bias",{n});
+            l.ln2.gain=w("ln_2.weight",{n});l.ln2.bias=w("ln_2.bias",{n});
+            l.scale1=w("ls_1.gamma",{n});l.scale2=w("ls_2.gamma",{n});
+            for(bool bias:{false,true}) {
+                const std::string ext=bias?"bias":"weight";
+                const char* dst=name(("qkv."+ext).c_str());
+                RAD_ARCH_TRY(map_concat(b,dst,{src(("self_attn.q_proj."+ext).c_str()),
+                                               src(("self_attn.k_proj."+ext).c_str()),
+                                               src(("self_attn.v_proj."+ext).c_str())},0));
+                if(bias) l.qkv.bias=decl_w(b,dst,RAD_BF16,{3*n},RAD_ACCESS_PER_REQUEST,RAD_SHARD_NONE,group);
+                else l.qkv.weight=decl_w(b,dst,RAD_BF16,{3*n,n},RAD_ACCESS_PER_REQUEST,RAD_SHARD_NONE,group);
+            }
+            l.projection.weight=w("self_attn.out_proj.weight",{n,n});l.projection.bias=w("self_attn.out_proj.bias",{n});
+            l.up.weight=w("mlp.c_fc.weight",{ff,n});l.up.bias=w("mlp.c_fc.bias",{ff});
+            l.down.weight=w("mlp.c_proj.weight",{n,ff});l.down.bias=w("mlp.c_proj.bias",{n});
+            if(!l.ln1.gain||!l.ln1.bias||!l.ln2.gain||!l.ln2.bias||!l.scale1||!l.scale2||
+               !l.qkv.weight||!l.qkv.bias||!l.projection.weight||!l.projection.bias||
+               !l.up.weight||!l.up.bias||!l.down.weight||!l.down.bias) return RAD_E_INVAL;
+        }
+        auto buf=[&](const char* key,int m,int width) {return decl_b(b,nm.f("vi.%s",key),RAD_BF16,{m,width});};
+        x=buf("x",rows,n);h=buf("h",rows,n);qkv=buf("qkv",rows,3*n);a=buf("context",rows,n);
+        up=buf("ff",rows,ff);seq=decl_b(b,nm.f("vi.index"),RAD_I32,{rows});
+        patches=buf("patches",merged,4*n);mid=buf("projected",merged,proj_dim);
+        active=buf("activated",merged,proj_dim);out=buf("output",merged,text_dim);
+        if(!x||!h||!qkv||!a||!up||!seq||!patches||!mid||!active||!out) return RAD_E_INVAL;
+        auto linear=[&](int m,int N,int K,rad_weight w) {return RAD_OP(b,"gemm_nt",
+            RAD_PARAMS(RAD_RANGE("M",1,m),RAD_INT("N",N),RAD_INT("K",K),RAD_STR("dtype","bf16")),RAD_WEIGHTS(w));};
+        auto affine=[&](Linear& l,int N,int K,const char* act,rad_buf input,rad_buf output){
+            l.op=rw(b,RAD_OP(b,"gemm_nt_bias",RAD_PARAMS(RAD_RANGE("M",1,rows),RAD_INT("N",N),RAD_INT("K",K),
+                RAD_STR("dtype","bf16"),RAD_STR("act",act)),RAD_WEIGHTS(l.weight,l.bias)),{input},{output});};
+        auto norm=[&](Norm& l,rad_buf input,rad_buf output){
+            l.op=rw(b,RAD_OP(b,"layernorm",RAD_PARAMS(RAD_RANGE("M",1,rows),RAD_INT("n",n),RAD_F64("eps",eps),
+                    RAD_STR("dtype","bf16")),RAD_WEIGHTS(l.gain,l.bias)),{input},{output});};
+        auto scale=[&](rad_weight w){return rw(b,RAD_OP(b,"mul_weight",RAD_PARAMS(RAD_RANGE("M",1,rows),
+            RAD_INT("n",n),RAD_STR("dtype","bf16")),RAD_WEIGHTS(w)),{h},{h});};
+        auto add=[&](){return rw(b,RAD_OP(b,"add",RAD_PARAMS(RAD_RANGE("M",1,rows),
+            RAD_INT("n",n),RAD_STR("dtype","bf16")),RAD_NOWEIGHTS),{x,h},{x});};
+        stem=rw(b,linear(rows,n,patch_dim,patch),{},{h});
+        addpos=rw(b,RAD_OP(b,"inkling2_vpos",RAD_PARAMS(RAD_RANGE("M",1,rows),RAD_INT("n",n),RAD_INT("side",side),
+                  RAD_STR("dtype","bf16")),RAD_WEIGHTS(position,cls,clspos)),{h},{h});
+        norm(pre,h,x);
+        iota=rw(b,RAD_OP(b,"iota",RAD_PARAMS(RAD_RANGE("M",1,rows),RAD_INT("start",0),RAD_INT("step",1)),
+                    RAD_NOWEIGHTS),{},{seq});
+        for(auto& l:layers) {
+            norm(l.ln1,x,h);affine(l.qkv,3*n,n,"none",h,qkv);
+            l.rope=rw(b,RAD_OP(b,"inkling2_vrope",RAD_PARAMS(RAD_RANGE("M",1,rows),RAD_INT("n_head",heads),
+                       RAD_INT("head_dim",dim),RAD_F64("theta",theta),RAD_STR("dtype","bf16")),RAD_NOWEIGHTS),{qkv},{qkv});
+            l.attn=rw(b,RAD_OP(b,"attn_dense",RAD_PARAMS(RAD_RANGE("M",1,rows),RAD_INT("head_dim",dim),RAD_INT("gqa",1),
+                       RAD_INT("causal",0),RAD_STR("dtype","bf16"),RAD_F64("scale",1./std::sqrt(double(dim))),
+                       RAD_INT("max_seqlen",c->max_enc_patches)),RAD_NOWEIGHTS),{qkv},{a});
+            affine(l.projection,n,n,"none",a,h);l.scale_a=scale(l.scale1);l.add_a=add();
+            norm(l.ln2,x,h);affine(l.up,ff,n,"gelu",h,up);affine(l.down,n,ff,"none",up,h);
+            l.scale_b=scale(l.scale2);l.add_b=add();
+        }
+        gather=rw(b,RAD_OP(b,"gather_rows",RAD_PARAMS(RAD_RANGE("M",1,rows),RAD_INT("n",n),RAD_STR("dtype","bf16")),
+                  RAD_NOWEIGHTS),{x,seq},{patches});
+        proj_in=rw(b,linear(merged,proj_dim,4*n,proj1),{patches},{mid});
+        gelu=rw(b,RAD_OP(b,"gelu",RAD_PARAMS(RAD_RANGE("M",1,merged),RAD_INT("n",proj_dim),RAD_STR("dtype","bf16")),
+                  RAD_NOWEIGHTS),{mid},{active});
+        proj_out=rw(b,linear(merged,text_dim,proj_dim,proj2),{active},{out});
+        if(!c->shape_probe) {
+            RadEncoderDecl e{};e.name="Inkling vision";e.modalities=RAD_MM_IMAGE;e.patch_dim=patch_dim;
+            e.merge=4;e.max_patches=rows;e.n_embd=text_dim;e.out=out;e.one_grid=1;
+            RAD_ARCH_TRY(rad_declare_encoder(b,&e));
+        }
+        on=true;return RAD_OK;
+    }
+
+    void step(RadCtx* c,const RadBatch* b) const {
+        const int64_t P=b->enc_n_patch,S=b->enc_n_seg;
+        int64_t gh=S&&b->enc_seg_h?b->enc_seg_h[0]:0,gw=S&&b->enc_seg_w?b->enc_seg_w[0]:0;
+        const int64_t hw=gh*gw, R=S*hw/4;
+        if(!on||gh<=0||gw<=0||(gh%2)||(gw%2)||P!=S*(1+hw)||P>rows||R>merged) {
+            rad_step_fail(c,"inkling2: image pass requires class rows followed by whole 2x2 patch groups");return;
+        }
+        auto X=brows(x,P),H=brows(h,P),Q=brows(qkv,P),A=brows(a,P),U=brows(up,P);
+        auto coord=praw2(b->enc_coord,RAD_I32,4,P);
+        RAD_ISSUE_N(c,stem,P,praw2(b->enc_pixels,RAD_BF16,P,patch_dim),RAD_W(patch),H);
+        RAD_ISSUE_N(c,addpos,P,H,RAD_W(position),coord,RAD_W(cls),RAD_W(clspos));
+        RAD_ISSUE_N(c,pre.op,P,H,RAD_W(pre.gain),RAD_W(pre.bias),X);
+        RAD_ISSUE_N(c,iota,P,brows(seq,P));
+        for(const auto& l:layers) {
+            RAD_ISSUE_N(c,l.ln1.op,P,X,RAD_W(l.ln1.gain),RAD_W(l.ln1.bias),H);
+            RAD_ISSUE_N(c,l.qkv.op,P,H,RAD_W(l.qkv.weight),RAD_W(l.qkv.bias),RAD_NONE,Q);
+            RAD_ISSUE_N(c,l.rope,P,Q,coord);
+            RAD_ISSUE_N(c,l.attn,P,bcol(qkv,0,n,P),bcol(qkv,n,n,P),bcol(qkv,2*n,n,P),
+                        praw(b->enc_cu,RAD_I32,S+1),A);
+            RAD_ISSUE_N(c,l.projection.op,P,A,RAD_W(l.projection.weight),RAD_W(l.projection.bias),RAD_NONE,H);
+            RAD_ISSUE_N(c,l.scale_a,P,H,RAD_W(l.scale1),H);RAD_ISSUE_N(c,l.add_a,P,X,H,X);
+            RAD_ISSUE_N(c,l.ln2.op,P,X,RAD_W(l.ln2.gain),RAD_W(l.ln2.bias),H);
+            RAD_ISSUE_N(c,l.up.op,P,H,RAD_W(l.up.weight),RAD_W(l.up.bias),RAD_NONE,U);
+            RAD_ISSUE_N(c,l.down.op,P,U,RAD_W(l.down.weight),RAD_W(l.down.bias),RAD_NONE,H);
+            RAD_ISSUE_N(c,l.scale_b,P,H,RAD_W(l.scale2),H);RAD_ISSUE_N(c,l.add_b,P,X,H,X);
+        }
+        for(int64_t s=0;s<S;++s)
+            RAD_ISSUE_N(c,gather,hw,X,brow_slice(seq,s*(hw+1)+1,hw,1),brow_slice(patches,s*hw/4,hw/4,n*4));
+        RAD_ISSUE_N(c,proj_in,R,brows(patches,R),RAD_W(proj1),brows(mid,R));
+        RAD_ISSUE_N(c,gelu,R,brows(mid,R),brows(active,R));
+        RAD_ISSUE_N(c,proj_out,R,brows(active,R),RAD_W(proj2),brows(out,R));
+    }
+};
+}
+
+namespace inkling2 {
+// Encoder embeddings are already normalized by the projector. The ABI sends them on
+// rank zero. Replicate just the image rows for this trunk's unsharded token lookup.
+struct InkVisionRows {
+    rad_buf text=0, replica=0;
+    rad_op scatter=0, copy=0, reduce=0;
+    int width=0;
+    int declare(RadBuilder* b,Names& names,int max_tok,int h,int ranks,rad_buf embedding) {
+        width=h;text=embedding;
+        if(ranks>1) {
+            replica=decl_b(b,names.f("vi.media_rows"),RAD_BF16,{max_tok,h});
+            copy=rw(b,RAD_OP(b,"cast",RAD_PARAMS(RAD_RANGE("M",1,max_tok),RAD_INT("n",h),
+                    RAD_STR("from","bf16"),RAD_STR("to","bf16")),RAD_NOWEIGHTS),{},{replica});
+            reduce=rw(b,RAD_OP(b,"all_reduce",RAD_PARAMS(RAD_INT("world_size",ranks),
+                      RAD_RANGE("numel",h,int64_t(max_tok)*h),RAD_STR("dtype","bf16"),RAD_INT("exact",1)),
+                      RAD_NOWEIGHTS),{replica},{replica});
+            if(!copy||!replica||!reduce) return RAD_E_INVAL;
+        }
+        auto sc=RAD_OP(b,"scatter_rows",RAD_PARAMS(RAD_RANGE("M",1,max_tok),RAD_INT("n",h),RAD_STR("dtype","bf16")),
+                       RAD_NOWEIGHTS);
+        scatter=replica?rw(b,sc,{text,replica},{text}):rw(b,sc,{text},{text});
+        return scatter?RAD_OK:RAD_E_INVAL;
+    }
+    void step(RadCtx* c,const RadBatch* b) const {
+        int64_t n=b->n_mm_rows;
+        if(!n) return;
+        auto rows=praw2(b->mm_embd,RAD_BF16,n,width);
+        if(replica) {
+            RAD_ISSUE_N(c,copy,n,rows,brows(replica,n));
+            RAD_ISSUE_N(c,reduce,n*width,brows(replica,n),RAD_NONE);
+            rows=brows(replica,n);
+        }
+        RAD_ISSUE_N(c,scatter,n,rows,praw(b->mm_rows,RAD_I32,n),brows(text,b->n_tok));
+    }
+};
+}
