+// One element of the softcapped SwiGLU: gate at column c of the packed row, up at column c + n.
+__device__ __forceinline__ float situ_value(const uint16_t* x,long long at,int n,float gc,float uc) {
+    float g=bf16_to_f32(x[at]),u=bf16_to_f32(x[at+n]);
+    const float gate_arg=__fdiv_rn(g,gc), up_arg=__fdiv_rn(u,uc);
+    const float sigmoid=__fdiv_rn(1.f,1.f+expf(-g));
+    float y=(gc*tanhf(gate_arg))*sigmoid*(uc*tanhf(up_arg));
+    // Re-evaluate near BF16 midpoints where the device transcendental's few low bits matter.
+    if (abs(int(__float_as_uint(y)&0xffff)-0x8000)<=32) {
+        const float sg=__fdiv_rn(1.f,1.f+float(exp(-double(g))));
+        y=(gc*float(tanh(double(gate_arg))))*sg*(uc*float(tanh(double(up_arg))));
+    }
+    return y;
+}
+__device__ __forceinline__ void situ_body(const uint16_t* x,uint16_t* out,long long count,int n,float gc,float uc) {
+    long long i=(long long)blockIdx.x*blockDim.x+threadIdx.x;
+    if(i>=count) return;
+    long long at=(i/n)*2*n+i%n;
+    out[i]=f32_to_bf16(situ_value(x,at,n,gc,uc));
+}
+// situ and quant_act_fp8 as one launch: the standalone pair writes the bf16 situ row
+// and the quantiser reads it back, so the codes are taken over bf16-rounded values; here each value
+// is rounded to bf16 and widened before the amax and the codes, the quantiser's mapping (a block a
+// row, a wave a 128-column group, a lane four consecutive columns, one dword store) and its
+// arithmetic (amax / 448, scale 1 for a zero group, clamp, v_cvt_pk_fp8_f32) kept as in
+// r4d_quant_act_fp8.hip. Saves the launch and the pass over the row.
+__device__ __forceinline__ void situ_quant_body(const uint16_t* x,uint8_t* q,float* s,int rows,int n,int nkb,float gc,float uc) {
+    const int row=blockIdx.x;
+    if(row>=rows) return;
+    const int lane=threadIdx.x&31, wave=threadIdx.x>>5;
+    const long long xrow=(long long)row*2*n, qrow=(long long)row*n;
+    for(int kb=wave;kb<nkb;kb+=8) {
+        const int c0=kb*128+lane*4;
+        float v[4]; float m=0.f;
+#pragma unroll
+        for(int j=0;j<4;++j) {
+            const int c=c0+j;
+            v[j]=c<n ? bf16_to_f32(f32_to_bf16(situ_value(x,xrow+c,n,gc,uc))) : 0.f;
+            m=fmaxf(m,fabsf(v[j]));
+        }
+        m=r4d_wave_max(m);
+        constexpr float kTop=448.0f;
+        const float sc=m>0.0f ? m*(1.0f/kTop) : 1.0f;
+        if(lane==0) s[(long long)row*nkb+kb]=sc;
+        const float inv=1.0f/sc;
+        int pk=0;
+        pk=__builtin_amdgcn_cvt_pk_fp8_f32(fminf(fmaxf(v[0]*inv,-448.0f),448.0f),fminf(fmaxf(v[1]*inv,-448.0f),448.0f),pk,false);
+        pk=__builtin_amdgcn_cvt_pk_fp8_f32(fminf(fmaxf(v[2]*inv,-448.0f),448.0f),fminf(fmaxf(v[3]*inv,-448.0f),448.0f),pk,true);
+        if(c0<n) *(uint32_t*)(q+qrow+c0)=(uint32_t)pk;
+    }
+}
+__global__ void situ_quant(const uint16_t* x,uint8_t* q,float* s,int rows,int n,int nkb,float gc,float uc) {
+    situ_quant_body(x,q,s,rows,n,nkb,gc,uc);
+}
