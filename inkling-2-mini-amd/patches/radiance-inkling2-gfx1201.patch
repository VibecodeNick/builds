+TEST(named_tool_call_whole_and_one_byte_at_a_time) {
+    ChatFormat f;
+    std::string why;
+    CHECK_OK(chat_format_from_abi(inkling2::chat_format(nullptr), &f, &why));
+    REQUIRE(chat_format_check(f, &why)==RAD_OK);
+    std::shared_ptr<const ReplyFormat> format;
+    REQUIRE(ReplyFormat::compile(f,&format,&why)==RAD_OK);
+    auto tools=Json::parse(R"([{"type":"function","function":{"name":"log_event","parameters":{"type":"object","properties":{"event_id":{"type":"string"},"count":{"type":"integer"}}}}}])");
+    ReplyOptions opt;
+    opt.tools=&tools;
+    std::shared_ptr<const ReplyParser> parser;
+    REQUIRE(ReplyParser::create(format,opt,&parser,&why)==RAD_OK);
+    const std::string lead="<|message_model|>log_event<|content_invoke_tool_json|>";
+    const std::string args=R"({"count":7,"event_id":"EVENT-77"})";
+    const std::string call=lead+R"({"name":"log_event","args":)"+args+"}<|end_message|>";
+    const auto check=[&](const ReplyMessage& m) {
+        REQUIRE_EQ(m.calls.size(), size_t(1));
+        CHECK_EQ(m.calls[0].name,std::string("log_event"));
+        CHECK(m.calls[0].closed);
+        CHECK(Json::parse(m.calls[0].arguments)==Json::parse(args));
+    };
+    check(reply_parse(*parser,call));
+    auto text=reply_parse(*parser,"<|message_model|><|content_text|>Plain.<|end_message|>");
+    CHECK_EQ(text.content,std::string("Plain."));
+    auto thought=reply_parse(*parser,"<|message_model|><|content_thinking|>Plan.<|end_message|>"
+            "<|message_model|><|content_text|>Answer.<|end_message|>");
+    CHECK_EQ(thought.reasoning,std::string("Plan."));
+    CHECK_EQ(thought.content,std::string("Answer."));
+
+    auto stream=parser->open();
+    for(size_t i=0;i<call.size();++i) stream->feed(std::string_view(call).substr(i,1),nullptr);
+    stream->finish(nullptr);
+    check(stream->message());
+    CHECK(reply_parse(*parser,lead+R"({"name":"other","args":{})"+"}<|end_message|>").calls.empty());
+    ChatGrammarRequest req;
+    req.tools=&tools;
+    req.require_call=true;
+    ChatGrammar grammar;
+    REQUIRE(chat_format_grammar(f,req,&grammar,&why)==RAD_OK);
+    CHECK(!grammar.lazy);
+    CHECK(!grammar.text.empty());
+}
+RAD_TEST_MAIN()
