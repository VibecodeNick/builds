+extern "C" int r4d_inkling2_clip(const RadArgs* a,RadStream stream) {
+    bool chain=r4d_geti_or(a,"chain",0)!=0;
+    auto *x=r4d_opt(a,0), *s=r4d_opt(a,1), *p=r4d_opt(a,2), *y=r4d_opt(a,3);
+    const int h=r4d_geti_or(a,"n_head",0),d=r4d_geti_or(a,"head_dim",0),floor=r4d_geti_or(a,"log_floor",1);
+    const float alpha=r4d_getf(a,"log_alpha",0),th=r4d_getf(a,"threshold",0);
+    if(!dense(x,RAD_BF16) || !dense(y,RAD_BF16) || (s && !dense(s,RAD_BF16) && !dense(s,RAD_F32)) ||
+        (p && !dense(p,RAD_I32))) return R4D_NO(RAD_E_DTYPE);
+    if(h<=0 || d<=0 || d>128 || th<=0 || floor<=0 || (alpha && !p)) return R4D_NO(RAD_E_SHAPE);
+    long long count=r4d_numel(x),m=count/(h*d);
+    if(m<=0 || count!=m*h*d || r4d_numel(y)!=count || (p && r4d_numel(p)!=m) ||
+        (s && r4d_numel(s)!=h*d)) return R4D_NO(RAD_E_SHAPE);
+    chain=chain && m<=64;
+    if(chain) r4dchain_clip<<<dim3(m,h),threads,0,(hipStream_t)stream>>>((const uint16_t*)x->data,r4d_p(s),
+        s && s->dtype==RAD_F32,(const int*)r4d_p(p),(uint16_t*)y->data,h,d,th,alpha,floor);
+    else clip<<<dim3(m,h),threads,0,(hipStream_t)stream>>>((const uint16_t*)x->data,r4d_p(s),
+        s && s->dtype==RAD_F32,(const int*)r4d_p(p),(uint16_t*)y->data,h,d,th,alpha,floor);
+    return launched();
+}
+
+extern "C" int r4d_inkling2_clip3(const RadArgs* a,RadStream stream) {
+    bool chain=r4d_geti_or(a,"chain",0)!=0;
+    const RadTensor* x[3]={r4d_opt(a,0),r4d_opt(a,2),r4d_opt(a,4)};
+    const RadTensor* sc[3]={r4d_opt(a,1),r4d_opt(a,3),r4d_opt(a,5)};
+    const RadTensor* y[3]={r4d_opt(a,7),r4d_opt(a,8),r4d_opt(a,9)};
+    const RadTensor* p=r4d_opt(a,6);
+    const int floor=r4d_geti_or(a,"log_floor",1);
+    const char* hk[3]={"n_head","n_head1","n_head2"}; const char* dk[3]={"head_dim","head_dim1","head_dim2"};
+    const char* tk[3]={"threshold","threshold1","threshold2"}; const char* ak[3]={"log_alpha","log_alpha1","log_alpha2"};
+    if(floor<=0 || (p && !dense(p,RAD_I32))) return R4D_NO(RAD_E_SHAPE);
+    Clip3 arg{}; long long m=0; int heads_total=0; bool any_alpha=false;
+    for(int i=0;i<3;++i){
+        const int h=r4d_geti_or(a,hk[i],0), d=r4d_geti_or(a,dk[i],0);
+        const float th=r4d_getf(a,tk[i],0), alpha=r4d_getf(a,ak[i],0);
+        // x may be a column slice of a wider row (q out of the q|gate GEMM): rows at their own pitch.
+        if(!x[i] || x[i]->dtype!=RAD_BF16 || !y[i] || y[i]->dtype!=RAD_BF16 || (sc[i] && !dense(sc[i],RAD_BF16) && !dense(sc[i],RAD_F32)))
+            return R4D_NO(RAD_E_DTYPE);
+        if(h<=0 || d<=0 || d>128 || th<=0 || (alpha && !p)) return R4D_NO(RAD_E_SHAPE);
+        long long mi=0,myi=0;
+        const auto xs=r4d_rows_pitch(x[i],h*d,&mi), ys=r4d_rows_pitch(y[i],h*d,&myi);
+        if(xs<0 || ys<0) return R4D_NO(RAD_E_STRIDE);
+        if(mi<=0 || mi>INT_MAX || myi!=mi || (sc[i] && r4d_numel(sc[i])!=h*d)) return R4D_NO(RAD_E_SHAPE);
+        if(i==0) m=mi; else if(mi!=m) return R4D_NO(RAD_E_SHAPE);
+        arg.s[i]={(const uint16_t*)x[i]->data,r4d_p(sc[i]),(uint16_t*)y[i]->data,h,d,sc[i] && sc[i]->dtype==RAD_F32,th,alpha,xs,ys};
+        heads_total+=h; any_alpha=any_alpha||alpha!=0;
+    }
+    if(any_alpha && (!p || r4d_numel(p)!=m)) return R4D_NO(RAD_E_SHAPE);
+    arg.pos=(const int*)r4d_p(p); arg.floor=floor;
+    chain=chain && m<=64;
+    if(chain) r4dchain_clip3<<<dim3(m,heads_total),threads,0,(hipStream_t)stream>>>(arg);
+    else clip3<<<dim3(m,heads_total),threads,0,(hipStream_t)stream>>>(arg);
+    return launched();
+}
+
+// One mix: `query` a row of its table, `out` its rows. The launch choice by height is r4d_inkling2_mix's.
+static int mix_one(RadStream stream,const Streams& src,const float* query,float* out,long long m,int n,int s,
+                   bool chain,float* stats,long long stats_bytes) {
+    if (n == 2304) {
+        auto queue = (hipStream_t)stream;
+        // Decode heights take the fused single launch: three column tiles for the one-token step
+        // (about 5% off the step), one tile a token at the drafter's verify height
+        // (there, 24 blocks of three tiles polled the chain counter harder than they saved and a
+        // round came out slower).
+        if (m == 1) {
+            if(chain) r4dchain_depth_mix_fused<3><<<dim3(m,3),1024,0,queue>>>(src,query,out,s);
+            else depth_mix_fused<3><<<dim3(m,3),1024,0,queue>>>(src,query,out,s);
+            return launched();
+        }
+        if (m <= 8) {
+            if(chain) r4dchain_depth_mix_fused<1><<<dim3(m,1),1024,0,queue>>>(src,query,out,s);
+            else depth_mix_fused<1><<<dim3(m,1),1024,0,queue>>>(src,query,out,s);
+            return launched();
+        }
+        // Split the measured decode cases and the two-stream, 128-row prefill.
+        // Other row counts use the one-dispatch path without workspace.
+        const bool split = (m == 1 && s >= 2) || (m == 128 && s == 2);
+        if (split && stats && stats_bytes >= (long long)(2 * sizeof(float)) * m * s) {
+            if(chain) r4dchain_depth_mix_stats<1,true><<<dim3(m,s),128,0,queue>>>(src,query,out,stats,s);
+    else depth_mix_stats<1,true><<<dim3(m,s),128,0,queue>>>(src,query,out,stats,s);
+            int status = launched();
+            if (status != RAD_OK) return status;
+            if(chain) r4dchain_depth_mix_finish<<<dim3(m,9),256,0,queue>>>(src,stats,out,s);
+    else depth_mix_finish<<<dim3(m,9),256,0,queue>>>(src,stats,out,s);
+        } else if (s <= 2) {
+            if(chain) r4dchain_depth_mix_stats<2,false><<<m,256,0,queue>>>(src,query,out,nullptr,s);
+    else depth_mix_stats<2,false><<<m,256,0,queue>>>(src,query,out,nullptr,s);
+        } else if (s <= 4) {
+            if(chain) r4dchain_depth_mix_stats<4,false><<<m,512,0,queue>>>(src,query,out,nullptr,s);
+    else depth_mix_stats<4,false><<<m,512,0,queue>>>(src,query,out,nullptr,s);
+        } else {
+            if(chain) r4dchain_depth_mix_stats<8,false><<<m,1024,0,queue>>>(src,query,out,nullptr,s);
+    else depth_mix_stats<8,false><<<m,1024,0,queue>>>(src,query,out,nullptr,s);
+        }
+        return launched();
+    }
+    if(chain) r4dchain_mix<<<m,threads,0,(hipStream_t)stream>>>(src,query,out,n,s);
+    else mix<<<m,threads,0,(hipStream_t)stream>>>(src,query,out,n,s);
+    return launched();
+}
+
+extern "C" int r4d_inkling2_mix(const RadArgs* a,RadStream stream) {
+    bool chain=r4d_geti_or(a,"chain",0)!=0;
+    auto *q=r4d_opt(a,0), *y=r4d_opt(a,1);
+    int n=r4d_geti_or(a,"n",0), s=r4d_geti_or(a,"streams",0), qr=r4d_geti_or(a,"query_row",-1);
+    if(!dense(q,RAD_F32) || !dense(y,RAD_F32)) return R4D_NO(RAD_E_DTYPE);
+    if(n<=0 || s<1 || s>8 || qr<0 || qr>=r4d_numel(q)/n || r4d_numel(y)%n) return R4D_NO(RAD_E_SHAPE);
+    long long m=r4d_numel(y)/n;
+    if (m<=0) return R4D_NO(RAD_E_SHAPE);
+    chain=chain && m<=64;
+    Streams src{};
+    for(int i=0; i<s; ++i) {
+        const auto* t=r4d_opt(a,2+i);
+        if(!dense(t,RAD_F32) || r4d_numel(t)!=m*n) return R4D_NO(RAD_E_SHAPE);
+        src.x[i]=(const float*)t->data;
+    }
+    return mix_one(stream,src,(const float*)q->data+(long long)qr*n,(float*)y->data,m,n,s,chain,
+                   (float*)a->scratch,a->scratch_bytes);
+}
+
+// inkling2_mixn: operands query, query_b (optional), out0..out3, stream0..stream7. Query j is row
+// `row<j>` of table `tab<j>` (0: query, 1: query_b). At decode heights one launch; above them the
+// mixes run one after another through mix_one, each with its own slice of the scratch.
+extern "C" int r4d_inkling2_mixn(const RadArgs* a,RadStream stream) {
+    bool chain=r4d_geti_or(a,"chain",0)!=0;
+    const int n=r4d_geti_or(a,"n",0), s=r4d_geti_or(a,"streams",0), nq=r4d_geti_or(a,"queries",0);
+    if(n<=0 || s<1 || s>8 || nq<2 || nq>4) return R4D_NO(RAD_E_SHAPE);
+    const RadTensor* tab[2]={r4d_opt(a,0),r4d_opt(a,1)};
+    if(!dense(tab[0],RAD_F32) || (tab[1] && !dense(tab[1],RAD_F32))) return R4D_NO(RAD_E_DTYPE);
+    static const char* const rk[4]={"row0","row1","row2","row3"};
+    static const char* const tk[4]={"tab0","tab1","tab2","tab3"};
+    MixSet set{}; long long m=0;
+    for(int j=0;j<nq;++j) {
+        const int row=r4d_geti_or(a,rk[j],-1), t=r4d_geti_or(a,tk[j],0);
+        const RadTensor* y=r4d_opt(a,2+j);
+        if(t<0 || t>1 || !tab[t] || !dense(y,RAD_F32)) return R4D_NO(RAD_E_DTYPE);
+        if(row<0 || row>=r4d_numel(tab[t])/n || r4d_numel(y)%n) return R4D_NO(RAD_E_SHAPE);
+        const long long rows=r4d_numel(y)/n;
+        if(rows<=0 || (j && rows!=m)) return R4D_NO(RAD_E_SHAPE);
+        m=rows;
+        set.q[j]=(const float*)tab[t]->data+(long long)row*n; set.y[j]=(float*)y->data;
+    }
+    chain=chain && m<=64;
+    Streams src{};
+    for(int i=0; i<s; ++i) {
+        const auto* t=r4d_opt(a,6+i);
+        if(!dense(t,RAD_F32) || r4d_numel(t)!=m*n) return R4D_NO(RAD_E_SHAPE);
+        src.x[i]=(const float*)t->data;
+    }
+    if(n==2304 && m<=8) {
+        auto queue=(hipStream_t)stream;
+        if(m==1) {
+            if(chain) r4dchain_depth_mix_fused_n<3><<<dim3(m,3,nq),1024,0,queue>>>(src,set,s);
+            else depth_mix_fused_n<3><<<dim3(m,3,nq),1024,0,queue>>>(src,set,s);
+        } else {
+            if(chain) r4dchain_depth_mix_fused_n<1><<<dim3(m,1,nq),1024,0,queue>>>(src,set,s);
+            else depth_mix_fused_n<1><<<dim3(m,1,nq),1024,0,queue>>>(src,set,s);
+        }
+        return launched();
+    }
+    const long long slice=a->scratch ? a->scratch_bytes/4/(long long)sizeof(float)*(long long)sizeof(float) : 0;
+    for(int j=0;j<nq;++j) {
+        const int rc=mix_one(stream,src,set.q[j],set.y[j],m,n,s,chain,
+                             a->scratch ? (float*)((char*)a->scratch+j*slice) : nullptr,slice);
+        if(rc!=RAD_OK) return rc;
+    }
+    return RAD_OK;
+}
