+        for(int i=0; i<a.splits; ++i) m=fmaxf(m,parts[i*(hd+2)+hd]);
+        for(int i=0; i<a.splits; ++i)
+            if(parts[i*(hd+2)+hd+1]) den+=parts[i*(hd+2)+hd+1]*expf(parts[i*(hd+2)+hd]-m);
+        denominator=den; row_max=m;
+    }
