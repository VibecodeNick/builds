+__global__ void ordered_control_kernel(const float* x,const float* msg,const uint16_t* down,
+                                const float* gain,const float* forget,float* y,int n,int rank,float eps) {
+    extern __shared__ uint16_t normalized[];
+    __shared__ float inv[2],hidden[64];
+    const int t=blockIdx.x,lane=threadIdx.x%32,wave=threadIdx.x/32;
+    x+=1LL*t*n;msg+=1LL*t*n;y+=1LL*t*n;
+    if(wave<2) {
+        const float total=squared_sum(wave?msg:x,n,lane);
+        if(!lane)inv[wave]=eager_inverse(total,n,eps);
+    }
+    __syncthreads();
+    for(int c=threadIdx.x;c<n;c+=blockDim.x) {
+        normalized[c]=f32_to_bf16(x[c]*inv[0]);
+        normalized[c+n]=f32_to_bf16(msg[c]*inv[1]);
+    }
+    __syncthreads();
+    for(int j=wave;j<rank;j+=8) {
+        const uint16_t* w=down+1LL*j*2*n;float sum=0;
+        for(int i=0;i<2*n;i+=32) {
+            const int k=i+lane;
+            float pair=bf16_to_f32(normalized[k])*bf16_to_f32(w[k]);
+            for(int s=0;s<32;s+=2) {sum+=__shfl(pair,s+1,32);sum+=__shfl(pair,s,32);}
+        }
+        if(!lane)hidden[j]=bf16_to_f32(f32_to_bf16(sum));
+    }
+    __syncthreads();
+    for(int c=threadIdx.x;c<n;c+=blockDim.x) {
+        float f=0,g=0;
+        for(int j=0;j<rank;++j) {
+            g=__fadd_rn(g,__fmul_rn(hidden[j],gain[1LL*c*rank+j]));
+            f=__fadd_rn(f,__fmul_rn(hidden[j],forget[1LL*c*rank+j]));
+        }
+        y[c]=__fadd_rn(__fmul_rn(1.f-float(tanh(double(f))),x[c]),__fmul_rn(float(tanh(double(g))),msg[c]));
+    }
+}
+extern "C" int r4d_reference_order_control(const RadArgs* a,RadStream stream) {
+    const auto* x=r4d_opt(a,0);const auto* msg=r4d_opt(a,1);const auto* down=r4d_opt(a,2);
+    const auto* gain=r4d_opt(a,3);const auto* forget=r4d_opt(a,4);const auto* y=r4d_opt(a,5);
+    const int n=r4d_geti_or(a,"n",0),r=r4d_geti_or(a,"rank",0);
+    if(n<=0||n%32||n>8192||r<=0||r>64)return RAD_E_SHAPE;
+    for(auto* v:{x,msg,down,gain,forget,y})if(!v||!r4d_contig(v)||v->dtype!=(v==down?RAD_BF16:RAD_F32))return RAD_E_DTYPE;
+    const int64_t m=r4d_numel(x)/n;
+    if(m<1||m>INT_MAX||m*n!=r4d_numel(x)||r4d_numel(y)!=m*n||r4d_numel(msg)!=m*n||
+       r4d_numel(down)!=2LL*n*r||r4d_numel(gain)!=1LL*n*r||r4d_numel(forget)!=1LL*n*r)return RAD_E_SHAPE;
+    ordered_control_kernel<<<m,256,4*n,(hipStream_t)stream>>>((const float*)x->data,(const float*)msg->data,
+        (const uint16_t*)down->data,(const float*)gain->data,(const float*)forget->data,
+        (float*)y->data,n,r,(float)r4d_getf(a,"eps",1e-6));
+    return hipGetLastError()==hipSuccess?RAD_OK:RAD_E_DEVICE;
+}
