+extern "C" int r4d_inkling2_conv(const RadArgs* a,RadStream stream) {
+    bool chain=r4d_geti_or(a,"chain",0)!=0;
+    auto op=[&](int i){return r4d_opt(a,i);};
+    const auto *x=op(0),*w=op(1),*st=op(2),*cu=op(3),*slot=op(4),*init=op(5),
+               *acc=op(6),*y=op(7),*dyn=op(8);
+    if(!dense(x,RAD_BF16)||!dense(w,RAD_BF16)||!dense(y,RAD_BF16)||!st||st->dtype!=RAD_BF16||
+        !dense(cu,RAD_I32)||(slot&&!dense(slot,RAD_I32))||(init&&!dense(init,RAD_I32))||
+        (acc&&!dense(acc,RAD_I32))||(dyn&&!dense(dyn,RAD_BF16))) return R4D_NO(RAD_E_DTYPE);
+    int n=r4d_geti_or(a,"n",0),h=r4d_geti_or(a,"n_head",0);
+    if(n<1 || h<0 || r4d_geti_or(a,"width",0)!=4 || (h>0)!=(dyn!=nullptr) || (h && n%h))
+        return R4D_NO(RAD_E_SHAPE);
+    long long m=r4d_numel(x)/n,s=r4d_numel(cu)-1;
+    if(m<=0 || m>INT_MAX || s<=0 || s>65535 || r4d_numel(x)!=m*n || r4d_numel(y)!=m*n ||
+        r4d_numel(w)!=4LL*n || (dyn && r4d_numel(dyn)!=m*h*4) || st->rank!=3 || st->shape[1]!=n ||
+        st->shape[2]<3 || st->stride[2]!=1 || (slot && r4d_numel(slot)!=s) ||
+        (init && r4d_numel(init)!=s) || (acc && r4d_numel(acc)!=s)) return R4D_NO(RAD_E_SHAPE);
+    chain=chain && m<=64;
+    if(chain) r4dchain_conv<<<dim3((n+127)/128,(m+31)/32,s),128,0,(hipStream_t)stream>>>((const uint16_t*)x->data,
+        (const uint16_t*)w->data,(const uint16_t*)r4d_p(dyn),(uint16_t*)y->data,(uint16_t*)st->data,
+        (const int*)cu->data,(const int*)r4d_p(slot),(const int*)r4d_p(init),(const int*)r4d_p(acc),
+        m,n,h,st->shape[2],st->shape[0],st->stride[0],st->stride[1]);
+    else conv<<<dim3((n+127)/128,(m+31)/32,s),128,0,(hipStream_t)stream>>>((const uint16_t*)x->data,
+        (const uint16_t*)w->data,(const uint16_t*)r4d_p(dyn),(uint16_t*)y->data,(uint16_t*)st->data,
+        (const int*)cu->data,(const int*)r4d_p(slot),(const int*)r4d_p(init),(const int*)r4d_p(acc),
+        m,n,h,st->shape[2],st->shape[0],st->stride[0],st->stride[1]);
+    return launched();
+}
