+// F32 residual operators. The input and output may be column slices of wider token rows.
+namespace {
+__device__ __forceinline__ void sigmoid_rows_body(const float* x,float* y,int n,long long xs,long long ys) {
+    int t=blockIdx.x;
+    for (int c=threadIdx.x;c<n;c+=blockDim.x) y[t*ys+c]=1.f/(1.f+expf(-x[t*xs+c]));
+}
+__global__ void sigmoid_rows(const float* x,float* y,int n,long long xs,long long ys) {
+    sigmoid_rows_body(x,y,n,xs,ys);
+}
+__global__ void r4dchain_sigmoid_rows(const float* x,float* y,int n,long long xs,long long ys) {
+    r4d_chain_wait();
+    sigmoid_rows_body(x,y,n,xs,ys);
+    r4d_chain_done();
+}
+
+__device__ __forceinline__ void gather_rows_body(const float* x,const int* index,float* y,int n,int src_rows,
+                            long long xs,long long ys) {
+    int t=blockIdx.x, src=index[t];
+    for (int c=threadIdx.x;c<n;c+=blockDim.x) y[t*ys+c]=(src<0 || src>=src_rows)?0.f:x[src*xs+c];
+}
+__global__ void gather_rows(const float* x,const int* index,float* y,int n,int src_rows,
+                            long long xs,long long ys) {
+    gather_rows_body(x,index,y,n,src_rows,xs,ys);
+}
+__global__ void r4dchain_gather_rows(const float* x,const int* index,float* y,int n,int src_rows,
+                            long long xs,long long ys) {
+    r4d_chain_wait();
+    gather_rows_body(x,index,y,n,src_rows,xs,ys);
+    r4d_chain_done();
+}
+
+__device__ __forceinline__ void rms_rows_body(const float* x,const void* w,bool w_f32,float* out,int n,long long xs,
+                         long long os,float eps,float wadd,float mult) {
+    int t=blockIdx.x;float ss=0;
+    for(int j=threadIdx.x;j<n;j+=blockDim.x){float v=x[t*xs+j];ss+=v*v;}
+    __shared__ float sums[4];
+    ss=wave_sum(ss);if(threadIdx.x%32==0)sums[threadIdx.x/32]=ss;
+    __syncthreads();
+    float inv=rsqrtf((sums[0]+sums[1]+sums[2]+sums[3])/n+eps);
+    for(int j=threadIdx.x;j<n;j+=blockDim.x){
+        float g=!w?1.f: (w_f32? ((const float*)w)[j]:bf16_to_f32(((const uint16_t*)w)[j]))+wadd;
+        out[t*os+j]=x[t*xs+j]*inv*g*mult;
+    }
+}
+__global__ void rms_rows(const float* x,const void* w,bool w_f32,float* out,int n,long long xs,
+                         long long os,float eps,float wadd,float mult) {
+    rms_rows_body(x,w,w_f32,out,n,xs,os,eps,wadd,mult);
+}
+__global__ void r4dchain_rms_rows(const float* x,const void* w,bool w_f32,float* out,int n,long long xs,
+                         long long os,float eps,float wadd,float mult) {
+    r4d_chain_wait();
+    rms_rows_body(x,w,w_f32,out,n,xs,os,eps,wadd,mult);
+    r4d_chain_done();
+}
