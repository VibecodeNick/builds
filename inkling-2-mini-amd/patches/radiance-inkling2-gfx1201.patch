+
+// One CTA per token forms the normalized BF16 input once. A dedicated CTA
+// for each rank row then evaluates its entire BF16 dot with 256 workers.
+__device__ __forceinline__ void control_norm_token_body(const float* x,const float* msg,uint16_t* norm,int n,float eps) {
+    int t=blockIdx.x,tid=threadIdx.x,lane=tid%32,wave=tid/32;
+    __shared__ double ss[2][8];
+    __shared__ float inv[2];
+    x+=(long long)t*n;msg+=(long long)t*n;norm+=(long long)t*2*n;
+    double a=0,b=0;
+    for(int c=tid;c<n;c+=256){a+=double(x[c])*x[c];b+=double(msg[c])*msg[c];}
+    for(int s=16;s;s/=2){a+=__shfl_xor(a,s,32);b+=__shfl_xor(b,s,32);}
+    if(!lane){ss[0][wave]=a;ss[1][wave]=b;}
+    __syncthreads();
+    if(tid<2){double total=0;for(int j=0;j<8;++j)total+=ss[tid][j];inv[tid]=float(1.0/sqrt(total/n+eps));}
+    __syncthreads();
+    for(int c=tid;c<n;c+=256){norm[c]=f32_to_bf16(x[c]*inv[0]);norm[c+n]=f32_to_bf16(msg[c]*inv[1]);}
+}
+__global__ void control_norm_token(const float* x,const float* msg,uint16_t* norm,int n,float eps) {
+    control_norm_token_body(x,msg,norm,n,eps);
+}
+__global__ void r4dchain_control_norm_token(const float* x,const float* msg,uint16_t* norm,int n,float eps) {
+    r4d_chain_wait();
+    control_norm_token_body(x,msg,norm,n,eps);
+    r4d_chain_done();
+}
+
+__device__ __forceinline__ void control_down_rank_body(const uint16_t* norm,const uint16_t* weight,float* hidden,int count,int rank) {
+    const int j=blockIdx.x,t=blockIdx.y,tid=threadIdx.x;
+    norm+=(long long)t*count;weight+=(long long)j*count;
+    if(count==256*18){
+        // The float-pair dot (see ctl_ff_settle); the FP64 statements below run only when it does not settle.
+        __shared__ float fh[8],fl[8],fm[8]; __shared__ int refuse;
+        uint16_t a[18],b[18];
+#pragma unroll
+        for(int i=0;i<18;++i){a[i]=norm[tid+i*256];b[i]=weight[tid+i*256];}
+        MixFF q[6];
+#pragma unroll
+        for(int i=0;i<6;++i)q[i]=ctl_ff_term(bf16_to_f32(a[i]),bf16_to_f32(b[i]));
+#pragma unroll
+        for(int i=6;i<18;++i)q[i%6]=mix_ff_add(q[i%6],r4d_tanh_ff::two_prod(bf16_to_f32(a[i]),bf16_to_f32(b[i])));
+        const MixFF acc=mix_ff_wave(mix_ff_tree6(q));
+        if(tid%32==0){fh[tid/32]=acc.hi;fl[tid/32]=acc.lo;fm[tid/32]=acc.mag;}
+        __syncthreads();
+        if(!tid){float v;const bool ok=ctl_ff_settle(fh,fl,fm,&v);refuse=!ok;if(ok)hidden[(long long)t*rank+j]=bf(v);}
+        __syncthreads();
+        if(!refuse)return;
+    }
+    double partial=0;
+    for(int i=tid;i<count;i+=256)partial+=double(bf16_to_f32(norm[i]))*bf16_to_f32(weight[i]);
+    for(int s=16;s;s/=2)partial+=__shfl_down(partial,s,32);
+    __shared__ double sum[8];
+    if(tid%32==0)sum[tid/32]=partial;
+    __syncthreads();
+    if(tid<32){
+        double x=tid<8?sum[tid]:0;
+        for(int s=4;s;s/=2)x+=__shfl_down(x,s,32);
+        if(!tid)hidden[(long long)t*rank+j]=bf(float(x));
+    }
+}
+__global__ void control_down_rank(const uint16_t* norm,const uint16_t* weight,float* hidden,int count,int rank) {
+    control_down_rank_body(norm,weight,hidden,count,rank);
+}
+__global__ void r4dchain_control_down_rank(const uint16_t* norm,const uint16_t* weight,float* hidden,int count,int rank) {
+    r4d_chain_wait();
+    control_down_rank_body(norm,weight,hidden,count,rank);
+    r4d_chain_done();
+}
+
+
+// Stage two. Cooperatively fetch a 32-channel weight tile and reuse it across
+// up to eight tokens. Each output follows the reference's 64 F32 products and
+// additions in order. The pad keeps adjacent channels on different LDS banks.
+__device__ __forceinline__ void control_blend_body(const float* x,const float* msg,const float* gain,const float* forget,
+                              const float* h,float* y,int m,int n,int rank) {
+    constexpr int channels=32, tokens=8, pitch=65;
+    __shared__ float gw[channels][pitch], fw[channels][pitch], hidden[tokens][64];
+    int c0=blockIdx.x*channels,t0=blockIdx.y*tokens,tid=threadIdx.x;
+    // rank <= 64, so the tile is at most 8 elements a thread: unrolled, the 16 loads go out
+    // together instead of one pair a loop trip (14 us a launch before, for a 16 KB tile).
+    constexpr int tile_max=channels*64/256;
+#pragma unroll
+    for(int k=0;k<tile_max;++k) {
+        const int i=tid+k*256;
+        if(i<channels*rank) {
+            int c=i/rank,j=i%rank;
+            if(c0+c<n) {
+                long long offset=(long long)(c0+c)*rank+j;
+                gw[c][j]=gain[offset];fw[c][j]=forget[offset];
+            }
+        }
+    }
+    for(int i=tid;i<tokens*rank;i+=blockDim.x){
+        int t=i/rank,j=i%rank;
+        if(t0+t<m)hidden[t][j]=h[(long long)(t0+t)*rank+j];
+    }
+    __syncthreads();
+    int c=tid%channels,t=tid/channels;
+    if(c0+c>=n || t0+t>=m)return;
+    float g=0,f=0;
+    // rank <= 64: unrolled over the bound so the three LDS reads a step are in flight together
+    // instead of one trip at a time; the 64 products and sums keep their order.
+#pragma unroll
+    for(int j=0;j<64;++j) {
+        if(j<rank) {
+            g=__fadd_rn(g,__fmul_rn(hidden[t][j],gw[c][j]));
+            f=__fadd_rn(f,__fmul_rn(hidden[t][j],fw[c][j]));
+        }
+    }
+    long long dst=(long long)(t0+t)*n+c0+c;
+#ifdef R4D_INKLING2_FLOAT_TANH
+    y[dst]=(1.f-tanhf(f))*x[dst]+tanhf(g)*msg[dst];   // changed-arithmetic arm, never in the exact build
+#else
+    // tanh_ff(v) == float(tanh(double(v))) for every float v (r4d_tanh_ff.h), without the FP64 rate.
+    y[dst]=(1.f-tanh_ff(f))*x[dst]+tanh_ff(g)*msg[dst];
+#endif
+}
+__global__ void control_blend(const float* x,const float* msg,const float* gain,const float* forget,
+                              const float* h,float* y,int m,int n,int rank) {
+    control_blend_body(x,msg,gain,forget,h,y,m,n,rank);
+}
+__global__ void r4dchain_control_blend(const float* x,const float* msg,const float* gain,const float* forget,
+                              const float* h,float* y,int m,int n,int rank) {
+    r4d_chain_wait();
+    control_blend_body(x,msg,gain,forget,h,y,m,n,rank);
+    r4d_chain_done();
+}
