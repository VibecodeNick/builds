+                for(int e=0;e<8;++e) {
+                    float prob=live ? bf(__fdiv_rn(expf(sv[e]-row_max),den)) : 0.f;
+                    if constexpr(i8) {
+                        float vscale=__shfl(vs,8*half+e,32);
