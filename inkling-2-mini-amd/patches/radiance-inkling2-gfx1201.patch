+// Eager CPU reduction of four vectors of eight floats, followed by one
+// left-to-right scalar sum. Matching the two reductions matters at BF16 midpoints.
+__device__ float read_float(float v) {return v;}
+__device__ float read_float(uint16_t v) {return bf16_to_f32(v);}
+template<class T> __device__ float squared_sum(const T* x, int n, int lane) {
+    float levels[4]{};
+    int count = n / 32;
+    int power = max(4, (32 - __clz(unsigned(max(1,count-1)))) / 4);
+    int width = 1 << power;
+    int i = 0;
+    for (; i + width <= count;) {
+        for (int k = 0; k < width; ++k, ++i) {
+            float v = read_float(x[i * 32 + lane]);
+            levels[0] = __fadd_rn(levels[0], __fmul_rn(v, v));
+        }
+        for (int l = 1; l < 4; ++l) {
+            levels[l] += levels[l-1];
+            levels[l-1] = 0.f;
+            if (i & ((width - 1) << (l * power))) break;
+        }
+    }
+    for (; i < count; ++i) {
+        float v = read_float(x[i * 32 + lane]);
+        levels[0] = __fadd_rn(levels[0], __fmul_rn(v, v));
+    }
+    float v = ((levels[0] + levels[1]) + levels[2]) + levels[3];
+    float group = __shfl(v,lane%8,32);
+    for (int j=8; j<32; j+=8) group += __shfl(v,j+lane%8,32);
+    float total = __shfl(group, 0, 32);
+    for (int j=1; j<8; ++j) total += __shfl(group,j,32);
+    return total;
+}
