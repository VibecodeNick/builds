+// CPU AVX512 BF16 dot-pair order. Each wave reads 32 adjacent features and
+// replays its FP32 products in the order used by the eager BF16 projection on
+// the CPU reference host.
+#include "r4d_args.h"
+#include "r4d_common.h"
+#include <climits>
+#include <cstring>
+#include <hip/hip_runtime.h>
+
+namespace {
+
+template <bool Expert, bool Logits>
+__global__ void ordered_dot(const uint16_t *x, const uint16_t *weights,
+                            void *out, const int *routes, const int *offsets,
+                            int experts, int top, bool sorted, int rows, int n,
+                            int k, int xp, int wp, int yp, int64_t ep) {
+  const int lane = threadIdx.x % 32;
+  const int col = int(blockIdx.x) * 8 + threadIdx.x / 32;
+  const long long row = (long long)blockIdx.z * gridDim.y + blockIdx.y;
+  if (col >= n || row >= rows)
+    return;
+  int source = int(row);
+  if constexpr (Expert) {
+    if (row >= offsets[experts])
+      return;
+    int e = 0;
+    while (e + 1 < experts && row >= offsets[e + 1])
+      ++e;
+    weights = ep ? weights + e * ep : ((const uint16_t *const *)weights)[e];
+    source = sorted ? row : routes[row] / top;
+  }
+  const uint16_t *a = x + int64_t(source) * xp;
+  const uint16_t *w = weights + int64_t(col) * wp;
+  float sum = 0;
+  for (int j = 0; j < k; j += 32) {
+    int at = j + lane;
+    float product = at < k ? bf16_to_f32(a[at]) * bf16_to_f32(w[at]) : 0.f;
+#pragma unroll
+    for (int p = 0; p < 32; p += 2) {
+      sum += __shfl(product, p + 1, 32);
+      sum += __shfl(product, p, 32);
+    }
+  }
+  if (lane == 0) {
+    if constexpr (Logits)
+      ((float *)out)[int64_t(row) * yp + col] = sum;
+    else
+      ((uint16_t *)out)[int64_t(row) * yp + col] = f32_to_bf16(sum);
+  }
+}
