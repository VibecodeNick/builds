+namespace {
+// BF16 products are exact in F32 at ordinary exponents. Each chain and the chain and lane folds
+// carry a compensation term (TwoSum), so the sum is accurate to about u|s| + (26u)^2 sum|p| rather
+// than 26u sum|p|; the error bound is then far inside a BF16 half-spacing except right at a rounding
+// threshold, and the F64 path runs only there (before, the 56u sum|p| bound sent about 30% of the
+// prefill-height waves to it: 1.5 of control_down's 3.1 ms at M=2048). The F64 path
+// itself and its result are unchanged; a product that could be subnormal still takes it.
+__device__ float bounded_dot_bf16(const uint16_t* x,const uint16_t* w,int count,int lane) {
+    constexpr int chains=8;
+    float hi[chains]={},lo[chains]={},magnitude=0;
+    for(int base=lane;base<count;base+=32*chains) {
+#pragma unroll
+        for(int k=0;k<chains;++k) {
+            int c=base+32*k;
+            if(c<count) {
+                float product=bf16_to_f32(x[c])*bf16_to_f32(w[c]);
+                float s=hi[k]+product, bb=s-hi[k];
+                lo[k]+=(hi[k]-(s-bb))+(product-bb);
+                hi[k]=s;
+                magnitude+=fabsf(product);
+            }
+        }
+    }
+#pragma unroll
+    for(int shift=chains/2;shift;shift>>=1) {
+#pragma unroll
+        for(int k=0;k<shift;++k) {
+            float s=hi[k]+hi[k+shift], bb=s-hi[k];
+            lo[k]+=lo[k+shift]+((hi[k]-(s-bb))+(hi[k+shift]-bb));
+            hi[k]=s;
+        }
+    }
+    float h=hi[0], l=lo[0];
+    for(int sh=16;sh;sh>>=1) {
+        float oh=__shfl_xor(h,sh,32), ol=__shfl_xor(l,sh,32);
+        float s=h+oh, bb=s-h;
+        l+=ol+((h-(s-bb))+(oh-bb));
+        h=s;
+    }
+    const float estimate=h+l, absolute=wave_sum(magnitude);
+    const unsigned hb=__float_as_uint(fabsf(estimate))>>16;
+    float mid=__uint_as_float((hb<<16)|0x8000);
+    float prev=hb?__uint_as_float(((hb-1)<<16)|0x8000):mid;
+    float distance=fminf(fabsf(fabsf(estimate)-mid),fabsf(fabsf(estimate)-prev));
+    // Each product traverses at most 18 adds in its chain, 3 chain folds and 5 lane folds: 26
+    // levels. The compensated result is within u|s| of the sum plus a second-order term in the
+    // levels; both carry a margin of two, and the subnormal term is as before.
+    constexpr float levels=26.f;
+    const float error=2.f*0x1p-24f*fabsf(estimate)+4.f*(levels*0x1p-24f)*(levels*0x1p-24f)*absolute+count*0x1p-126f;
+#ifdef R4D_PROBE_NO_FALLBACK
+    return bf(estimate);
+#endif
+    if(isfinite(estimate) && distance>error)return bf(estimate);
+    double exact=0;
+    for(int c=lane;c<count;c+=32)exact+=double(bf16_to_f32(x[c]))*bf16_to_f32(w[c]);
+    for(int sh=16;sh;sh>>=1)exact+=__shfl_xor(exact,sh,32);
+    return bf(float(exact));
+}
+
+// A workgroup normalizes both inputs and keeps the rank-64 bottleneck on chip. At short
+// batch size several workgroups share a token, each computing a different output channel tile.
+__device__ __forceinline__ void control_body(const float* x,const float* msg,const uint16_t* down,const float* gain,
+                        const float* forget,float* y,int n,int rank,float eps,int output_tile) {
+    extern __shared__ uint16_t normalized[];
+    __shared__ float hidden[64], inv[2];
+    __shared__ double partial[2][8];
+    const int t=blockIdx.x,lane=threadIdx.x%32,wave=threadIdx.x/32;
+    x+=(long long)t*n; msg+=(long long)t*n; y+=(long long)t*n;
+    double xx=0,mm=0;
+    for(int c=threadIdx.x;c<n;c+=blockDim.x){xx+=double(x[c])*x[c];mm+=double(msg[c])*msg[c];}
+    for(int sh=16;sh;sh>>=1){xx+=__shfl_xor(xx,sh,32);mm+=__shfl_xor(mm,sh,32);}
+    if(!lane){partial[0][wave]=xx;partial[1][wave]=mm;}
+    __syncthreads();
+    if(threadIdx.x<2){
+        double ss=0;for(int i=0;i<8;++i)ss+=partial[threadIdx.x][i];
+        inv[threadIdx.x]=float(1.0/sqrt(ss/n+eps));
+    }
+    __syncthreads();
+    for(int c=threadIdx.x;c<n;c+=blockDim.x){
+        normalized[c]=f32_to_bf16(x[c]*inv[0]);normalized[n+c]=f32_to_bf16(msg[c]*inv[1]);
+    }
+    __syncthreads();
+    for(int j=wave;j<rank;j+=8) {
+        const uint16_t* w=down+(long long)j*2*n;
+        double v=0;for(int c=lane;c<2*n;c+=32)v+=double(bf16_to_f32(normalized[c]))*bf16_to_f32(w[c]);
+        for(int sh=16;sh;sh>>=1)v+=__shfl_xor(v,sh,32);
+        if(!lane)hidden[j]=bf(float(v));
+    }
+    __syncthreads();
+    const int stop=min(n,(int)((blockIdx.y+1)*output_tile));
+    for(int c=blockIdx.y*output_tile+threadIdx.x;c<stop;c+=blockDim.x) {
+        float f=0,g=0;
+        for(int j=0;j<rank;++j){
+            g=__fadd_rn(g,__fmul_rn(hidden[j],gain[(long long)c*rank+j]));
+            f=__fadd_rn(f,__fmul_rn(hidden[j],forget[(long long)c*rank+j]));
+        }
+#ifdef R4D_INKLING2_FLOAT_TANH
+        y[c]=(1.f-tanhf(f))*x[c]+tanhf(g)*msg[c];
+#else
+        y[c]=(1.f-tanh_ff(f))*x[c]+tanh_ff(g)*msg[c];
+#endif
+    }
+}
+__global__ void control(const float* x,const float* msg,const uint16_t* down,const float* gain,
+                        const float* forget,float* y,int n,int rank,float eps,int output_tile) {
+    control_body(x,msg,down,gain,forget,y,n,rank,eps,output_tile);
+}
+__global__ void r4dchain_control(const float* x,const float* msg,const uint16_t* down,const float* gain,
+                        const float* forget,float* y,int n,int rank,float eps,int output_tile) {
+    r4d_chain_wait();
+    control_body(x,msg,down,gain,forget,y,n,rank,eps,output_tile);
+    r4d_chain_done();
+}
