diff --git a/libref/ref_inkling2.cpp b/libref/ref_inkling2.cpp
new file mode 100644
index 0000000..a43ff73
--- /dev/null
+++ b/libref/ref_inkling2.cpp
@@ -0,0 +1,196 @@
+#include "ref_common.h"
+#include "ref_ops.h"
+
+#include <algorithm>
+#include <cmath>
+
+using namespace ref;
+
+int ref_inkling2_clip(const RadArgs* a, RadStream) {
+    const auto* x = t_in(a, 0);
+    const auto* scale = t_in(a, 1);
+    const auto* pos = t_in(a, 2);
+    const auto* y = t_in(a, 3);
+    const int64_t heads = p_int(a, "n_head", 0), d = p_int(a, "head_dim", 0);
+    const float threshold = p_f32(a, "threshold", 0), alpha = p_f32(a, "log_alpha", 0);
+    const int64_t floor = p_int(a, "log_floor", 1);
+    if (!x || !y || heads <= 0 || d <= 0 || threshold <= 0 || floor <= 0) return RAD_E_INVAL;
+    const int64_t m = numel(x) / (heads*d);
+    if (m*heads*d != numel(x) || numel(x) != numel(y) ||
+        (scale && numel(scale) != heads*d) || (pos && numel(pos) != m) ||
+        (alpha != 0 && !pos)) return RAD_E_SHAPE;
+    REF_PAR_FOR(m * heads * d)
+    for (int64_t row = 0; row < m*heads; ++row) {
+        auto channel = [&](int64_t i) {
+            return ldt(x, offlin(x, row*d+i)) * (scale ? ldt(scale, offlin(scale,(row%heads)*d+i)) : 1.f);
+        };
+        float sum = 0;
+        for (int64_t i = 0; i < d; ++i) { float v = channel(i); sum += v*v; }
+        const float factor = std::min(1.f, threshold / (std::sqrt(sum) + 1e-6f));
+        const float tau = alpha == 0 ? 1.f : 1.f + alpha * std::log(std::max(1.f,
+            (1.f + ld_int(pos->dtype, pos->data, offlin(pos,row/heads))) / floor));
+        for (int64_t i = 0; i < d; ++i)
+            stt(y, offlin(y,row*d+i), round_dt(x->dtype, channel(i)*factor)*tau);
+    }
+    return RAD_OK;
+}
+
+int ref_inkling2_mix(const RadArgs* a, RadStream) {
+    const auto* query = t_in(a, 0);
+    const auto* out = t_in(a, 1);
+    const int64_t streams = p_int(a, "streams", 0), n = p_int(a, "n", 0), qr = p_int(a, "query_row", -1);
+    if (!query || !out || streams < 1 || streams > 8 || n <= 0 || qr < 0 ||
+        qr >= numel(query)/n || numel(out)%n) return RAD_E_SHAPE;
+    const int64_t m = numel(out)/n;
+    const RadTensor* state[8];
+    for (int i = 0; i < streams; ++i) {
+        state[i] = t_in(a, i+2);
+        if (!state[i] || numel(state[i]) != m*n) return RAD_E_SHAPE;
+    }
+    const float qscale = 1.f / std::sqrt(float(n));
+    REF_PAR_FOR(m*n*streams)
+    for (int64_t row = 0; row < m; ++row) {
+        float norm[8], score[8], max_score = -INFINITY;
+        for (int s = 0; s < streams; ++s) {
+            double sum = 0, dot = 0;
+            for (int64_t c = 0; c < n; ++c) {
+                double x = ldt(state[s], offlin(state[s],row*n+c));
+                sum += x*x;
+            }
+            norm[s] = 1.f / std::sqrt(float(sum/n) + 1e-6f);
+            for (int64_t c = 0; c < n; ++c) {
+                const float normalized = ldt(state[s], offlin(state[s],row*n+c))*norm[s];
+                dot += double(normalized) * ldt(query, offlin(query,qr*n+c));
+            }
+            score[s] = float(dot)*qscale;
+            max_score = std::max(max_score, score[s]);
+        }
+        float denom = 0;
+        for (int s = 0; s < streams; ++s) { score[s] = ref_exp(score[s]-max_score); denom += score[s]; }
+        for (int64_t c = 0; c < n; ++c) {
+            float val = 0;
+            for (int s = 0; s < streams; ++s) {
+                // The eager stream reduction rounds the product before adding the next stream.
+                const volatile float term=(score[s]/denom)*(norm[s]*ldt(state[s],offlin(state[s],row*n+c)));
+                val+=term;
+            }
+            stt(out, offlin(out,row*n+c), val);
+        }
+    }
+    return RAD_OK;
+}
+
+int ref_inkling2_add_residual(const RadArgs* a,RadStream) {
+    const auto *x=t_in(a,0),*delta=t_in(a,1),*out=t_in(a,2);
+    if(!x||!delta||!out||x->dtype!=RAD_F32||delta->dtype!=RAD_BF16||out->dtype!=RAD_F32)
+        return RAD_E_DTYPE;
+    const int64_t n=p_int(a,"n",0),round=p_int(a,"round_bf16",-1),count=numel(out);
+    if(n<=0||count<=0||count%n||numel(x)!=count||numel(delta)!=count||(round!=0&&round!=1))
+        return RAD_E_SHAPE;
+    REF_PAR_FOR(count)
+    for(int64_t i=0;i<count;++i) {
+        float value=ldt(x,offlin(x,i))+ldt(delta,offlin(delta,i));
+        if(round)value=rad_bf16_to_f32(rad_f32_to_bf16(value));
+        stt(out,offlin(out,i),value);
+    }
+    return RAD_OK;
+}
+
+int ref_inkling2_gate(const RadArgs* a, RadStream) {
+    const auto *gate=t_in(a,0), *context=t_in(a,1), *out=t_in(a,2);
+    if (!gate || !context || !out || gate->dtype!=RAD_BF16 || context->dtype!=RAD_BF16 ||
+        out->dtype!=RAD_BF16) return RAD_E_DTYPE;
+    const int64_t count=numel(out);
+    if (count<1 || numel(gate)!=count || numel(context)!=count) return RAD_E_SHAPE;
+    REF_PAR_FOR(count)
+    for (int64_t i=0; i<count; ++i) {
+        float g=act_sigmoid(ldt(gate,offlin(gate,i)));
+        stt(out,offlin(out,i),g*ldt(context,offlin(context,i)));
+    }
+    return RAD_OK;
+}
+
+int ref_inkling2_situ(const RadArgs* a, RadStream) {
+    const auto* x = t_in(a,0);
+    const auto* out = t_in(a,1);
+    const int64_t n = p_int(a,"n",0);
+    const float gc = p_f32(a,"gate_cap",0), uc = p_f32(a,"up_cap",0);
+    if (!x || !out || n <= 0 || gc <= 0 || uc <= 0 || numel(out)%n ||
+        numel(x) != 2*numel(out)) return RAD_E_SHAPE;
+    REF_PAR_FOR(numel(out))
+    for (int64_t i=0; i<numel(out); ++i) {
+        const int64_t at = (i/n)*2*n+i%n;
+        const float g=ldt(x,offlin(x,at)), up=ldt(x,offlin(x,at+n));
+        stt(out,offlin(out,i), (gc*float(std::tanh(double(g/gc))))*act_sigmoid(g)*(uc*float(std::tanh(double(up/uc)))));
+    }
+    return RAD_OK;
+}
+
+// The gate's down projection has BF16 inputs and output. Its two head matrices, message,
+// residual, and final blend use F32. A per-row workspace holds only the normalized pair and h.
+int ref_inkling2_control(const RadArgs* a, RadStream) {
+    const auto *x=t_in(a,0), *msg=t_in(a,1), *down=t_in(a,2), *gain=t_in(a,3),
+               *forget=t_in(a,4), *out=t_in(a,5);
+    const int64_t n=p_int(a,"n",0), rank=p_int(a,"rank",0);
+    const float eps=p_f32(a,"eps",1e-6f);
+    if(!x || !msg || !down || !gain || !forget || !out || n<1 || rank<1 || eps<=0 ||
+       !rad_tensor_is_contiguous(x) || !rad_tensor_is_contiguous(msg) ||
+       !rad_tensor_is_contiguous(down) || !rad_tensor_is_contiguous(gain) ||
+       !rad_tensor_is_contiguous(forget) || !rad_tensor_is_contiguous(out)) return RAD_E_INVAL;
+    if (x->dtype!=RAD_F32 || msg->dtype!=RAD_F32 || down->dtype!=RAD_BF16 || gain->dtype!=RAD_F32 ||
+        forget->dtype!=RAD_F32 || out->dtype!=RAD_F32) return RAD_E_DTYPE;
+    const int64_t m=numel(x)/n;
+    if(m<1 || m*n!=numel(x) || numel(msg)!=m*n || numel(out)!=m*n ||
+       numel(down)!=2*n*rank || numel(gain)!=n*rank || numel(forget)!=n*rank) return RAD_E_SHAPE;
+    auto row=[](const RadTensor* t,int64_t start){return (const float*)t->data+start;};
+    auto bf=[](float v){return bf16_to_f32(f32_to_bf16(v));};
+    REF_PAR_FOR(m*n*rank)
+    for (int64_t t=0;t<m;++t) {
+        float* normed=ws_get(2*n+rank);
+        float* hidden=normed+2*n;
+        for(int input=0;input<2;++input) {
+            const float* vals=row(input?msg:x,t*n);
+            double ss=0;
+            for(int64_t c=0;c<n;++c) ss+=double(vals[c])*vals[c];
+            float inv=float(1./std::sqrt(ss/n+eps));
+            for(int64_t c=0;c<n;++c) normed[input*n+c]=bf(vals[c]*inv);
+        }
+        for(int64_t j=0;j<rank;++j) {
+            double sum=0;
+            const auto* w=(const uint16_t*)down->data+j*2*n;
+            for(int64_t c=0;c<2*n;++c) sum+=double(normed[c])*bf16_to_f32(w[c]);
+            hidden[j]=bf(sum);
+        }
+        for(int64_t c=0;c<n;++c) {
+            float g=0,f=0;
+            const float *gw=row(gain,c*rank), *fw=row(forget,c*rank);
+            for(int64_t j=0;j<rank;++j){g+=gw[j]*hidden[j];f+=fw[j]*hidden[j];}
+            ((float*)out->data)[t*n+c]=(1.f-float(std::tanh(double(f))))*row(x,t*n)[c]
+                                      +float(std::tanh(double(g)))*row(msg,t*n)[c];
+        }
+    }
+    return RAD_OK;
+}
+
+// The eager BF16 model has inputs close enough to rounding boundaries for serial F32
+// accumulation of mean-square to change a token. Sum in double, then use the F32 mean,
+// rsqrt, gain and one final narrowing that the layer performs.
+int ref_inkling2_rmsnorm(const RadArgs* a,RadStream) {
+    const auto *x=t_in(a,0),*w=t_in(a,1),*y=t_in(a,2);
+    int64_t n=p_int(a,"n",0);float eps=p_f32(a,"eps",1e-6f);
+    if(!x||!y||n<1||eps<=0||(x->dtype!=RAD_F32 && x->dtype!=RAD_BF16)||
+       (y->dtype!=RAD_F32 && y->dtype!=RAD_BF16))
+        return RAD_E_INVAL;
+    if(numel(x)!=numel(y)||numel(x)%n||(w && numel(w)!=n)) return RAD_E_SHAPE;
+    int64_t m=numel(x)/n;
+    REF_PAR_FOR(m*n)
+    for(int64_t r=0;r<m;++r) {
+        int64_t xb=rowoff(x,r,n),yb=rowoff(y,r,n);
+        double ss=0;
+        for(int64_t c=0;c<n;++c){double v=ldt(x,xb+c*laststride(x));ss+=v*v;}
+        float inv=1.f/std::sqrt(float(ss/n)+eps);
+        for(int64_t c=0;c<n;++c)
+            stt(y,yb+c*laststride(y),ldt(x,xb+c*laststride(x))*inv*(w?ldt(w,offlin(w,c)):1.f));
+    }
+    return RAD_OK;
+}
