+        int r=threadIdx.x/16,c=threadIdx.x%16;
+        if(q0+r<qlen) {
+            float v=0;
+#pragma unroll
+            for(int w=0;w<prefill_waves;++w)v+=output_tile[w][r][c];
+            a.out[(long long)(offset+q0+r)*a.out_stride+h*hd+16*d+c]=f32_to_bf16(v);
+        }
+        __syncthreads();
+    }
+}
