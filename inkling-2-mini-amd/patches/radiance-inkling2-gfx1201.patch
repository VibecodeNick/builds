@@ -0,0 +1,2106 @@
+/* Inkling text operators. Per-query relative bias is evaluated inside paged attention, uses
+ * the checkpoint table in its original [d_rel, extent] order, and vanishes beyond its extent.
+ * Threads cooperate within a wave on a single key's q.k and r.table dots. Split partials have a
+ * fixed-size workspace. No attention score matrix is allocated at any query or context length. */
+#include <hip/hip_runtime.h>
+#include <hip/hip_fp16.h>
+#include "r4d_common.h"
+#include "r4d_args.h"
+#include "r4d_plugin.h"
+#include "r4d_chain.h"
+#include "r4d_tanh_ff.h"
+#include <algorithm>
+#include <climits>
+#include <cstdlib>
+#include <cstring>
+
+namespace {
+constexpr int hd = 128;
+constexpr int dr = 16;
+constexpr int waves = 4;
+constexpr int threads = 32 * waves;
+constexpr int part_budget = 768;
+// The attention folds a query's context in `splits` parts, and the fold's order is
+// part of its rounding. The count was 768 / (rows x heads) capped by the context, so a verify
+// pass of m rows folded in fewer parts than the one-token step once the context bound passed
+// 256 x 32 / m tokens: eight rows from the first step, four once the context passed 1,024 tokens.
+// The drafted profile then left the target-only text there (seven drafts after 40 to 142 tokens, window 3 or
+// 4 after about 1,000; windows 1 and 2 never in 1,200). Up to decode_rows rows now take the
+// one-token step's count whatever the height, so a row is folded the same in any launch that
+// carries it; the partial sums' scratch grows to match (0.4 to 3.2 MiB).
+constexpr int decode_rows = 8;
+constexpr int decode_score_capacity=16*1024*1024;
+struct Attention {
+    const uint16_t *q, *r, *table, *sink;
+    const void* kv;
+    const int *bt, *used, *cu;
+    uint16_t* out;
+    float* partial;
+    int rows, heads, gqa, seqs, blocks, table_width, extent, window, splits, reserved;
+    long long bt_stride, q_stride, r_stride, sink_stride, out_stride;
+    float scale;
+    int score_stride;
+    uint16_t* score_cache;   // decode: the score cache; tiled prefill: the bias table as [distance][d_rel] in scratch, or null
+};
+// The AQL replay kernel compares every kernarg byte, including padding.
+// These offsets and the explicit reserved word keep every byte initialized.
+static_assert(offsetof(Attention, reserved)==116 && offsetof(Attention, bt_stride)==120);
+static_assert(offsetof(Attention, score_stride)==164 && offsetof(Attention, score_cache)==168);
+static_assert(sizeof(Attention)==176);
+__device__ float wave_sum(float x) {
+    for (int shift=16; shift>0; shift>>=1) x += __shfl_xor(x,shift,32);
+    return x;
+}
+__device__ float bf(float x) { return bf16_to_f32(f32_to_bf16(x)); }
+
+// Eager Transformers narrows the normalized probability to BF16 before P.V.
+// First reduce the softmax normalizer. Replay scores for P.V, retaining only a bounded
+// number of partials and never an array indexed by both query and key.
+template<bool int8_kv, bool stats_only>
+__device__ __forceinline__ void paged_body(Attention a) {
+    const int h=blockIdx.y, t=blockIdx.x, part=blockIdx.z;
+    const int lane=threadIdx.x%32, wave=threadIdx.x/32;
+    const int seq=r4d_q_seq(a.cu,a.seqs,a.rows/a.seqs,t);
+    const int qstart=r4d_q_off(a.cu,seq,a.rows/a.seqs), qlen=r4d_q_len(a.cu,seq,a.rows/a.seqs);
+    const int pos=a.used[seq]-qlen+t-qstart;
+    const int begin=a.window>0 ? max(0,pos-a.window+1) : 0;
+    const int end=min(pos+1,a.table_width*16), keys=max(0,end-begin);
+    const int lo=begin+(long long)keys*part/a.splits, hi=begin+(long long)keys*(part+1)/a.splits;
+    const int kvheads=a.heads/a.gqa;
+    float query[hd/32], value[hd/32]={};
+#pragma unroll
+    for (int i=0; i<hd/32; ++i) query[i]=bf16_to_f32(a.q[t*a.q_stride+h*hd+lane+32*i]);
+    const float r=lane<dr ? bf16_to_f32(a.r[t*a.r_stride+h*dr+lane]) : 0;
+    __shared__ float accum[waves][hd], maxima[waves], sums[waves], denominator, row_max;
+    float *parts=a.splits==1 ? nullptr : a.partial+(t*a.heads+h)*a.splits*(hd+2);
+    if (!stats_only && a.splits>1 && threadIdx.x==0) {
