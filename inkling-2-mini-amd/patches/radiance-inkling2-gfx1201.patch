+// The split count the one-token step at a row's own context takes (see decode_rows). A decode
+// pass's context bound is the context rounded up to 1,024 tokens (bound_bucket, core/sched/batch.cpp)
+// plus its query; the launcher folds 256 tokens a part, at most 32, and at most the window's in a
+// windowed layer. A verify row that has crossed into the next 1,024 before the step's own bound has
+// is the one-token step of that next bucket, so it takes that bucket's count, not the launch's.
+// `reserved` is 0 where every row takes the launch's count (one row a sequence: nothing changes).
+__device__ __forceinline__ int ink_row_splits(const Attention& a,int pos) {
+    if(!a.reserved) return a.splits;
+    long long bound=((long long)pos+1023)/1024*1024;
+    if(bound>a.reserved) bound=a.reserved;
+    long long upper=bound+1;
+    if(a.window && upper>a.window) upper=a.window;
+    long long rs=(upper+255)/256;
+    rs=rs<1?1:rs>32?32:rs;
+    return rs<a.splits?(int)rs:a.splits;
+}
+__device__ __forceinline__ int ink_row_pos(const Attention& a,int t) {
+    const int seq=r4d_q_seq(a.cu,a.seqs,a.rows/a.seqs,t);
+    const int qstart=r4d_q_off(a.cu,seq,a.rows/a.seqs),qlen=r4d_q_len(a.cu,seq,a.rows/a.seqs);
+    return a.used[seq]-qlen+t-qstart;
+}
