+                        else v[e]=words[i];
+                    }
+                    output[d]=ink_wmma(v,p0,output[d]);
+                    if constexpr(i8) {
+                        output[d]=ink_wmma(v,p1,output[d]);
+                        if(needs_tail)output[d]=ink_wmma(v,p2,output[d]);
