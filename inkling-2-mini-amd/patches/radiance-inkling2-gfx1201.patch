+        return RAD_E_INVAL;
+    }
+    auto it = std::make_shared<Item>();
+    it->kind = Kind::Image;
+    it->grid_t = it->n_seg = it->seg_prefix = 1;
+    it->grid_h = cells_h * c.merge;
+    it->grid_w = cells_w * c.merge;
+    it->rows_h = cells_h;
+    it->rows_w = cells_w;
+    it->seg_rows = cells_h * cells_w;
+    it->n_patch = patches;
+    it->patch_dim = c.patch_dim();
+    it->rope_1d = true;
+    it->pixels.resize((size_t)patches * it->patch_dim);
