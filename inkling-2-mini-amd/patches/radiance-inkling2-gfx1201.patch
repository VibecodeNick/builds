new file mode 100644
index 0000000..2096890
--- /dev/null
+++ b/libref/ref_inkling2_vision.cpp
@@ -0,0 +1,68 @@
+#include "ref_common.h"
+#include "ref_ops.h"
+#include <algorithm>
+#include <cmath>
+
+using namespace ref;
+
+// A negative row denotes the class token. All other rows receive the border-clamped
+// bilinear position table, with half-pixel centers, before the encoder's first layernorm.
+int ref_inkling2_vpos(const RadArgs* a, RadStream) {
+    const auto *x=t_in(a,0), *table=t_in(a,1), *crd=t_in(a,2), *cls=t_in(a,3), *cpos=t_in(a,4);
+    const int n=p_int(a,"n",0), side=p_int(a,"side",0);
+    if(!x || !table || !crd || !cls || !cpos || n<1 || side<1 || numel(x)%n ||
+       numel(table)!=int64_t(side)*side*n || x->dtype!=RAD_BF16 || table->dtype!=x->dtype ||
+       cls->dtype!=x->dtype || cpos->dtype!=x->dtype || crd->dtype!=RAD_I32 ||
+       numel(cls)!=n || numel(cpos)!=n) return RAD_E_SHAPE;
+    const int64_t m=numel(x)/n;
+    if(numel(crd)!=4*m) return RAD_E_SHAPE;
+    REF_PAR_FOR(m*n)
+    for(int64_t i=0;i<m;++i) {
+        auto pos=[&](int d){return ld_int(crd->dtype,crd->data,offlin(crd,d*m+i));};
+        const int row=pos(0),col=pos(1),h=pos(2),w=pos(3);
+        if(h<=0 || w<=0 || (row>=0 && (row>=h || col<0 || col>=w))) continue;
+        const float y=(row+.5f)*side/h-.5f, z=(col+.5f)*side/w-.5f;
+        const int y0=std::floor(y),z0=std::floor(z);
+        for(int c=0;c<n;++c) {
+            const auto at=offlin(x,i*n+c);
+            if(row<0) {stt(x,at,ldt(cls,offlin(cls,c))+ldt(cpos,offlin(cpos,c)));continue;}
+            float sum=0;
+            for(int j=0;j<2;++j) for(int k=0;k<2;++k) {
+                const int yy=std::clamp(y0+j,0,side-1), xx=std::clamp(z0+k,0,side-1);
+                const float factor=(1.f-std::fabs(y-y0-j))*(1.f-std::fabs(z-z0-k));
+                sum+=ldt(table,offlin(table,(yy*side+xx)*n+c))*factor;
+            }
+            stt(x,at,ldt(x,at)+round_dt(RAD_BF16,sum));
+        }
+    }
+    return RAD_OK;
+}
+
+// Q and K rotate adjacent channel pairs. The first half uses column+1, the second
+// row+1, each with its own frequency ladder. The class row has identity rotation.
+int ref_inkling2_vrope(const RadArgs* a, RadStream) {
+    const auto *qkv=t_in(a,0), *coord=t_in(a,1);
+    const int heads=p_int(a,"n_head",0), d=p_int(a,"head_dim",0);
+    const float theta=p_f32(a,"theta",0);
+    if(!qkv || !coord || heads<1 || d<4 || d%4 || theta<=0 || qkv->dtype!=RAD_BF16 ||
+       coord->dtype!=RAD_I32 || numel(qkv)%(3*heads*d)) return RAD_E_SHAPE;
+    const int64_t m=numel(qkv)/(3*heads*d);
+    if(numel(coord)!=4*m) return RAD_E_SHAPE;
+    REF_PAR_FOR(m*heads*d)
+    for(int64_t t=0;t<m;++t) {
+        int row=ld_int(coord->dtype,coord->data,offlin(coord,t));
+        int col=ld_int(coord->dtype,coord->data,offlin(coord,m+t));
+        if(row<0) continue;
+        for(int pair=0;pair<d/2;++pair) {
+            float phi=(pair<d/4?col+1:row+1)*std::pow(theta,-float(pair%(d/4))/(d/4));
+            float cs=std::cos(phi),sn=std::sin(phi);
+            for(int h=0;h<2*heads;++h) {
+                auto at=offlin(qkv,(t*3*heads+h)*d+2*pair);
+                auto at1=offlin(qkv,(t*3*heads+h)*d+2*pair+1);
+                float v0=ldt(qkv,at),v1=ldt(qkv,at1);
+                stt(qkv,at,v0*cs-v1*sn);stt(qkv,at1,v1*cs+v0*sn);
+            }
+        }
+    }
+    return RAD_OK;
+}
