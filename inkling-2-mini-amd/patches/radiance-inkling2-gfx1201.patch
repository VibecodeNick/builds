+// Float-float statistics for the depth mix. The reference sums the exact squares and
+// the exact products in FP64 and rounds the sum (over width, for the squares) to float; FP64 runs at
+// 1/32 of the FP32 rate here. These accumulate the same exact terms as float pairs (error about
+// 2^-46 of the magnitude sum; the FP64 reference's is about 2^-48), round the pair to float, and
+// when either could sit within 2^-38 of a float rounding threshold the whole block takes the FP64
+// path for every stream, so the float is the reference's in every case.
+struct MixFF { float hi, lo, mag; };
+__device__ __forceinline__ MixFF mix_ff_add(MixFF a, r4d_tanh_ff::FF p) {
+    r4d_tanh_ff::FF t=r4d_tanh_ff::ff_add({a.hi,a.lo},p);
+    return {t.hi,t.lo,__fadd_rn(a.mag,fabsf(p.hi))};
+}
+__device__ __forceinline__ MixFF mix_ff_wave(MixFF a) {
+    for(int sh=16;sh;sh>>=1) {
+        r4d_tanh_ff::FF o{__shfl_xor(a.hi,sh,32),__shfl_xor(a.lo,sh,32)};
+        r4d_tanh_ff::FF t=r4d_tanh_ff::ff_add({a.hi,a.lo},o);
+        a.hi=t.hi; a.lo=t.lo; a.mag=__fadd_rn(a.mag,__shfl_xor(a.mag,sh,32));
+    }
+    return a;
+}
+// The decode-height mix is one token's serial latency, and the 18 float-float adds a
+// lane made in a chain were most of it. A lane now keeps six partial sums of three terms and folds
+// them as a tree (five float-float adds deep instead of eighteen). The pair's error stays about 2^-46
+// of the magnitude sum in any order of the same 25 additions, and mix_ff_settle still sends anything
+// within 2^-38 of a rounding threshold to the reference's FP64 statements, so the float is the
+// reference's in every case, as before.
+__device__ __forceinline__ MixFF mix_ff_first(r4d_tanh_ff::FF p) { return {p.hi,p.lo,fabsf(p.hi)}; }
+__device__ __forceinline__ MixFF mix_ff_merge(MixFF a, MixFF b) {
+    r4d_tanh_ff::FF t=r4d_tanh_ff::ff_add({a.hi,a.lo},{b.hi,b.lo});
+    return {t.hi,t.lo,__fadd_rn(a.mag,b.mag)};
+}
+__device__ __forceinline__ MixFF mix_ff_tree6(const MixFF* q) {
+    return mix_ff_merge(mix_ff_merge(mix_ff_merge(q[0],q[1]),mix_ff_merge(q[2],q[3])),mix_ff_merge(q[4],q[5]));
+}
+// Lane 0 of a group: fold the four wave partials in order, divide, and decide. *out is the float the
+// pair rounds to; the return says whether that float is settled (the FP64 path would round the same).
+__device__ __forceinline__ bool mix_ff_settle(const float* h,const float* l,const float* m,float divisor,float* out) {
+    r4d_tanh_ff::FF t{0.f,0.f}; float mag=0.f;
+    for(int w=0;w<4;++w) { t=r4d_tanh_ff::ff_add(t,{h[w],l[w]}); mag=__fadd_rn(mag,m[w]); }
+    if(divisor!=1.f) { t=r4d_tanh_ff::ff_div(t,{divisor,0.f}); mag=__fdiv_rn(mag,divisor); }
+    const float c=t.hi, e=t.lo, ac=fabsf(c);
+    const uint32_t cb=__float_as_uint(ac);
+    const float up=__fsub_rn(__uint_as_float(cb+1u),ac), down=cb?__fsub_rn(ac,__uint_as_float(cb-1u)):up;
+    const float margin=__fmul_rn(fminf(up,down),0.5f);
+    *out=c;
+    return isfinite(c) && __fadd_rn(fabsf(e),__fmul_rn(0x1p-38f,mag))<margin;
+}
+struct Streams { const float* x[8]; };
+// H=2304 on the released checkpoint. Keep the four wave32 partials in
+// exactly the same order. A workgroup can evaluate several streams together.
+template<int Slots, bool Split>
+__device__ __forceinline__ void depth_mix_stats_body(Streams inputs, const float* query, float* output, float* stats,
+                                int streams) {
+    constexpr int width = 2304;
+    constexpr int lanes = 128;
+    constexpr int cols = width / lanes;
+    __shared__ double partial[Slots][4];
+    __shared__ float norm[Slots], score[Slots];
+    const int token = blockIdx.x;
+    const int group = threadIdx.x / lanes, lane = threadIdx.x % lanes;
+    const int s = Split ? blockIdx.y : group;
+    const long long offset = (long long)token * width;
+    float values[cols];
+    __shared__ float ffh[8][4], ffl[8][4], ffm[8][4], qv[8], dv[8];
+    __shared__ int fb;
+    if (threadIdx.x == 0) fb = 0;
+    if (s < streams) {
+        const float* x = inputs.x[s] + offset;
+        MixFF acc{0.f, 0.f, 0.f};
+        #pragma unroll
+        for (int k = 0; k < cols; ++k) {
+            values[k] = x[k * lanes + lane];
+            acc = mix_ff_add(acc, r4d_tanh_ff::two_prod(values[k], values[k]));
+        }
+        acc = mix_ff_wave(acc);
+        if ((lane % 32) == 0) { ffh[group][lane / 32] = acc.hi; ffl[group][lane / 32] = acc.lo; ffm[group][lane / 32] = acc.mag; }
+    }
+    __syncthreads();
+    if (s < streams && lane == 0) {
+        float q;
+        if (!mix_ff_settle(ffh[group], ffl[group], ffm[group], float(width), &q)) atomicOr(&fb, 1);
+        qv[group] = q;
+    }
+    __syncthreads();
+    if (fb) {
+        // The FP64 path of the reference, for every stream of the block.
+        if (s < streams) {
+            double square = 0;
+            #pragma unroll
+            for (int k = 0; k < cols; ++k) square += double(values[k]) * double(values[k]);
+            for (int sh = 16; sh; sh >>= 1) square += __shfl_xor(square, sh, 32);
+            if ((lane % 32) == 0) partial[group][lane / 32] = square;
+        }
+        __syncthreads();
+        if (s < streams && lane == 0) {
+            double sum = 0;
+            for (int w = 0; w < 4; ++w) sum += partial[group][w];
+            qv[group] = float(sum / width);
+        }
+        __syncthreads();
+        if (threadIdx.x == 0) fb = 0;
+    }
+    if (s < streams && lane == 0) {
+        float root = float(sqrt(double(qv[group] + 1e-6f)));
+        norm[group] = float(1.0 / double(root));
+    }
+    __syncthreads();
+    if (s < streams) {
+        MixFF acc{0.f, 0.f, 0.f};
+        #pragma unroll
+        for (int k = 0; k < cols; ++k) {
+            float value = __fmul_rn(values[k], norm[group]);
+            acc = mix_ff_add(acc, r4d_tanh_ff::two_prod(value, query[k * lanes + lane]));
+        }
+        acc = mix_ff_wave(acc);
+        if ((lane % 32) == 0) { ffh[group][lane / 32] = acc.hi; ffl[group][lane / 32] = acc.lo; ffm[group][lane / 32] = acc.mag; }
+    }
+    __syncthreads();
+    if (s < streams && lane == 0) {
+        float d;
+        if (!mix_ff_settle(ffh[group], ffl[group], ffm[group], 1.f, &d)) atomicOr(&fb, 1);
+        dv[group] = d;
+    }
+    __syncthreads();
+    if (fb) {
+        if (s < streams) {
+            double dot = 0;
+            #pragma unroll
+            for (int k = 0; k < cols; ++k) {
+                float value = __fmul_rn(values[k], norm[group]);
+                dot += double(value) * double(query[k * lanes + lane]);
+            }
+            for (int sh = 16; sh; sh >>= 1) dot += __shfl_xor(dot, sh, 32);
+            if ((lane % 32) == 0) partial[group][lane / 32] = dot;
+        }
+        __syncthreads();
+        if (s < streams && lane == 0) {
+            double dot = 0;
+            for (int w = 0; w < 4; ++w) dot += partial[group][w];
+            dv[group] = float(dot);
+        }
+        __syncthreads();
+    }
+    if (s < streams && lane == 0) {
+        constexpr float scale = 1.f / 48.f;
+        score[group] = dv[group] * scale;
+        if constexpr (Split) {
+            stats[((long long)token * streams + s) * 2] = norm[group];
+            stats[((long long)token * streams + s) * 2 + 1] = score[group];
+        }
+    }
+    if constexpr (!Split) {
+        __syncthreads();
+        // Give each stream one lane of the same wave for its exp. Every lane
+        // sums the resulting FP32 weights in increasing stream order.
+        if (threadIdx.x < 32) {
+            int id = threadIdx.x;
+            float maximum = -INFINITY;
+            for (int i = 0; i < streams; ++i) maximum = fmaxf(maximum, score[i]);
+            float weight = id < streams ? float(exp(double(score[id] - maximum))) : 0.f;
+            float denom = 0;
+            for (int i = 0; i < streams; ++i) denom = __fadd_rn(denom, __shfl(weight, i, 32));
+            if (id < streams) score[id] = float(double(weight) / double(denom));
+        }
+        __syncthreads();
+        for (int col = threadIdx.x; col < width; col += blockDim.x) {
+            float result = 0;
+            for (int i = 0; i < streams; ++i) {
+                float value = __fmul_rn(inputs.x[i][offset + col], norm[i]);
+                result = __fadd_rn(result, __fmul_rn(value, score[i]));
+            }
+            output[offset + col] = result;
+        }
+    }
+}
+template<int Slots, bool Split>
+__global__ void depth_mix_stats(Streams inputs, const float* query, float* output, float* stats,
+                                int streams) {
+    depth_mix_stats_body<Slots,Split>(inputs,query,output,stats,streams);
+}
+template<int Slots, bool Split>
+__global__ void r4dchain_depth_mix_stats(Streams inputs, const float* query, float* output, float* stats,
+                                int streams) {
+    r4d_chain_wait();
+    depth_mix_stats_body<Slots,Split>(inputs,query,output,stats,streams);
+    r4d_chain_done();
+}
+
+
+// Independent workgroups finish disjoint 256-column tiles. Only the two FP32
+// statistics per stream cross the launch boundary.
+__device__ __forceinline__ void depth_mix_finish_body(Streams inputs, const float* stats, float* output, int streams) {
+    constexpr int width = 2304;
+    int token = blockIdx.x, col = blockIdx.y * blockDim.x + threadIdx.x;
+    int lane = threadIdx.x % 32;
+    stats += (long long)token * streams * 2;
+    float norm = lane < streams ? stats[2 * lane] : 0.f;
+    float score = lane < streams ? stats[2 * lane + 1] : -INFINITY;
+    float maximum = -INFINITY;
+    for (int i = 0; i < streams; ++i) maximum = fmaxf(maximum, __shfl(score, i, 32));
+    float weight = lane < streams ? float(exp(double(score - maximum))) : 0.f;
+    float denom = 0;
+    for (int i = 0; i < streams; ++i) denom = __fadd_rn(denom, __shfl(weight, i, 32));
+    if (lane < streams) weight = float(double(weight) / double(denom));
+    float result = 0;
+    const long long index = (long long)token * width + col;
+    for (int i = 0; i < streams; ++i) {
+        float value = __fmul_rn(inputs.x[i][index], __shfl(norm, i, 32));
+        result = __fadd_rn(result, __fmul_rn(value, __shfl(weight, i, 32)));
+    }
+    output[index] = result;
+}
+__global__ void depth_mix_finish(Streams inputs, const float* stats, float* output, int streams) {
+    depth_mix_finish_body(inputs,stats,output,streams);
+}
+__global__ void r4dchain_depth_mix_finish(Streams inputs, const float* stats, float* output, int streams) {
+    r4d_chain_wait();
+    depth_mix_finish_body(inputs,stats,output,streams);
+    r4d_chain_done();
+}
+
+
+__device__ __forceinline__ void mix_body(Streams st,const float* q,float* y,int n,int streams) {
+    __shared__ float norm[8],weight[8];
+    __shared__ double sums[8][4];
+    int t=blockIdx.x,c=threadIdx.x;
+    for (int s=0; s<streams; ++s) {
+        double ss=0;
+        for (int j=c; j<n; j+=blockDim.x) {double x=st.x[s][(long long)t*n+j];ss+=x*x;}
+        for (int sh=16;sh;sh>>=1) ss+=__shfl_xor(ss,sh,32);
+        if(c%32==0) sums[s][c/32]=ss;
+    }
+    __syncthreads();
+    if(c<streams) {
+        double ss=0;for(int w=0;w<4;++w)ss+=sums[c][w];
+        // The device's native f32 sqrt/reciprocal can be one ulp above the host
+        // result. Eager rounds sqrt and division separately before stream mixing.
+        float root=float(sqrt(double(float(ss/n)+1e-6f)));
+        norm[c]=float(1.0/double(root));
+    }
+    __syncthreads();
+    for (int s=0; s<streams; ++s) {
+        double dot=0;
+        for(int j=c;j<n;j+=blockDim.x) {
+            float scaled=st.x[s][(long long)t*n+j]*norm[s];
+            dot+=double(scaled)*q[j];
+        }
+        for(int sh=16;sh;sh>>=1) dot+=__shfl_xor(dot,sh,32);
+        if(c%32==0)sums[s][c/32]=dot;
+    }
+    __syncthreads();
+    if(c==0) {
+        float m=-INFINITY,den=0;
+        const float scale=float(1.0/double(float(sqrt(double(n)))));
+        for(int s=0; s<streams; ++s) {
+            double dot=0;for(int w=0;w<4;++w)dot+=sums[s][w];
+            weight[s]=float(dot)*scale;m=fmaxf(m,weight[s]);
+        }
+        for(int s=0;s<streams;++s){weight[s]=float(exp(double(weight[s]-m)));den+=weight[s];}
+        for(int s=0;s<streams;++s)weight[s]=float(double(weight[s])/double(den));
+    }
+    __syncthreads();
+    for(int j=c;j<n;j+=blockDim.x) {
+        float v=0;
+        for(int s=0;s<streams;++s) {
+            float scaled=__fmul_rn(st.x[s][(long long)t*n+j],norm[s]);
+            v=__fadd_rn(v,__fmul_rn(weight[s],scaled));
+        }
+        y[(long long)t*n+j]=v;
+    }
+}
+__global__ void mix(Streams st,const float* q,float* y,int n,int streams) {
+    mix_body(st,q,y,n,streams);
+}
+__global__ void r4dchain_mix(Streams st,const float* q,float* y,int n,int streams) {
+    r4d_chain_wait();
+    mix_body(st,q,y,n,streams);
+    r4d_chain_done();
+}
+
+// One launch for a decode-height mix (m <= 8) in place of depth_mix_stats<1,true> + depth_mix_finish
+// (and of depth_mix_stats<8,false> at the verify height). Grid (m, Tiles), 1,024 threads: group g of
+// 128 threads computes stream g's statistics exactly as depth_mix_stats does (same lanes, same wave
+// partials, same order), each block redoing them for its token (Tiles x the 73 KB read a token, 0.07
+// ms a step at Tiles 3); threads then blend their tile's columns with depth_mix_finish's arithmetic,
+// the per-lane shuffles replaced by the same values in shared memory. The two FP32 statistics no
+// longer cross a launch boundary, so no scratch is read or written.
+template<int Tiles>
+__device__ __forceinline__ void depth_mix_fused_body(Streams inputs, const float* query, float* output, int streams) {
+    constexpr int width = 2304;
+    constexpr int lanes = 128;
+    constexpr int cols = width / lanes;
+    constexpr int tile = width / Tiles;
+    __shared__ double partial[8][4];
+    __shared__ float norm[8], score[8], weight[8];
+    const int token = blockIdx.x;
+    const int group = threadIdx.x / lanes, lane = threadIdx.x % lanes;
+    const int s = group;
+    const long long offset = (long long)token * width;
+    float values[cols];
+    __shared__ float ffh[8][4], ffl[8][4], ffm[8][4], qv[8], dv[8];
+    __shared__ int fb;
+    if (threadIdx.x == 0) fb = 0;
+    if (s < streams) {
+        const float* x = inputs.x[s] + offset;
+        #pragma unroll
+        for (int k = 0; k < cols; ++k) values[k] = x[k * lanes + lane];
+        MixFF part[6];
+        #pragma unroll
+        for (int k = 0; k < 6; ++k) part[k] = mix_ff_first(r4d_tanh_ff::two_prod(values[k], values[k]));
+        #pragma unroll
+        for (int k = 6; k < cols; ++k) part[k % 6] = mix_ff_add(part[k % 6], r4d_tanh_ff::two_prod(values[k], values[k]));
+        MixFF acc = mix_ff_wave(mix_ff_tree6(part));
+        if ((lane % 32) == 0) { ffh[group][lane / 32] = acc.hi; ffl[group][lane / 32] = acc.lo; ffm[group][lane / 32] = acc.mag; }
+    }
+    __syncthreads();
+    if (s < streams && lane == 0) {
+        float q;
+        if (!mix_ff_settle(ffh[group], ffl[group], ffm[group], float(width), &q)) atomicOr(&fb, 1);
+        qv[group] = q;
+    }
+    __syncthreads();
+    if (fb) {
+        // The FP64 path of the reference, for every stream of the block.
+        if (s < streams) {
+            double square = 0;
+            #pragma unroll
+            for (int k = 0; k < cols; ++k) square += double(values[k]) * double(values[k]);
+            for (int sh = 16; sh; sh >>= 1) square += __shfl_xor(square, sh, 32);
+            if ((lane % 32) == 0) partial[group][lane / 32] = square;
+        }
+        __syncthreads();
+        if (s < streams && lane == 0) {
+            double sum = 0;
+            for (int w = 0; w < 4; ++w) sum += partial[group][w];
+            qv[group] = float(sum / width);
+        }
+        __syncthreads();
+        if (threadIdx.x == 0) fb = 0;
+    }
+    if (s < streams && lane == 0) {
+        float root = float(sqrt(double(qv[group] + 1e-6f)));
+        norm[group] = float(1.0 / double(root));
+    }
+    __syncthreads();
+    if (s < streams) {
+        const float scale_s = norm[group];
+        MixFF part[6];
+        #pragma unroll
+        for (int k = 0; k < 6; ++k)
+            part[k] = mix_ff_first(r4d_tanh_ff::two_prod(__fmul_rn(values[k], scale_s), query[k * lanes + lane]));
+        #pragma unroll
+        for (int k = 6; k < cols; ++k)
+            part[k % 6] = mix_ff_add(part[k % 6], r4d_tanh_ff::two_prod(__fmul_rn(values[k], scale_s), query[k * lanes + lane]));
+        MixFF acc = mix_ff_wave(mix_ff_tree6(part));
+        if ((lane % 32) == 0) { ffh[group][lane / 32] = acc.hi; ffl[group][lane / 32] = acc.lo; ffm[group][lane / 32] = acc.mag; }
+    }
+    __syncthreads();
+    if (s < streams && lane == 0) {
+        float d;
+        if (!mix_ff_settle(ffh[group], ffl[group], ffm[group], 1.f, &d)) atomicOr(&fb, 1);
+        dv[group] = d;
+    }
+    __syncthreads();
+    if (fb) {
+        if (s < streams) {
+            double dot = 0;
+            #pragma unroll
+            for (int k = 0; k < cols; ++k) {
+                float value = __fmul_rn(values[k], norm[group]);
+                dot += double(value) * double(query[k * lanes + lane]);
+            }
+            for (int sh = 16; sh; sh >>= 1) dot += __shfl_xor(dot, sh, 32);
+            if ((lane % 32) == 0) partial[group][lane / 32] = dot;
+        }
+        __syncthreads();
+        if (s < streams && lane == 0) {
+            double dot = 0;
+            for (int w = 0; w < 4; ++w) dot += partial[group][w];
+            dv[group] = float(dot);
+        }
+        __syncthreads();
+    }
+    if (s < streams && lane == 0) {
+        constexpr float scale = 1.f / 48.f;
+        score[group] = dv[group] * scale;
+    }
+    __syncthreads();
+    if (threadIdx.x < 32) {
+        const int id = threadIdx.x;
+        const float sc = id < streams ? score[id] : -INFINITY;
+        float maximum = -INFINITY;
+        for (int i = 0; i < streams; ++i) maximum = fmaxf(maximum, __shfl(sc, i, 32));
+        float w = id < streams ? float(exp(double(sc - maximum))) : 0.f;
+        float denom = 0;
+        for (int i = 0; i < streams; ++i) denom = __fadd_rn(denom, __shfl(w, i, 32));
+        if (id < streams) weight[id] = float(double(w) / double(denom));
+    }
+    __syncthreads();
+    const int stop = min(width, (int)(blockIdx.y + 1) * tile);
+    if (blockDim.x == 1024) {
+        // Every stream's value for a thread's columns is loaded before the first sum, so
+        // the loads are in flight together (a load a stream in the sum's own loop was eight memory
+        // latencies in a row). A stream past `streams` reads stream 0 and is not summed. The products
+        // and the sum keep their order, so the bytes are the loop's below.
+        constexpr int reps = (tile + 1023) / 1024;
+        const int base = blockIdx.y * tile + threadIdx.x;
+        const float* px[8];
+        float nr[8], wt[8], v[reps][8];
+        #pragma unroll
+        for (int i = 0; i < 8; ++i) { px[i] = inputs.x[i < streams ? i : 0]; nr[i] = norm[i < streams ? i : 0]; wt[i] = weight[i < streams ? i : 0]; }
+        #pragma unroll
+        for (int r = 0; r < reps; ++r) {
+            const int col = base + r * 1024;
+            if (col < stop) {
+                const long long index = offset + col;
+                #pragma unroll
+                for (int i = 0; i < 8; ++i) v[r][i] = px[i][index];
+            }
+        }
+        #pragma unroll
+        for (int r = 0; r < reps; ++r) {
+            const int col = base + r * 1024;
+            if (col < stop) {
+                float result = 0;
+                #pragma unroll
+                for (int i = 0; i < 8; ++i)
+                    if (i < streams) result = __fadd_rn(result, __fmul_rn(__fmul_rn(v[r][i], nr[i]), wt[i]));
+                output[offset + col] = result;
+            }
+        }
+        return;
+    }
+    for (int col = blockIdx.y * tile + threadIdx.x; col < stop; col += blockDim.x) {
+        float result = 0;
+        const long long index = offset + col;
+        for (int i = 0; i < streams; ++i) {
+            float value = __fmul_rn(inputs.x[i][index], norm[i]);
+            result = __fadd_rn(result, __fmul_rn(value, weight[i]));
+        }
+        output[index] = result;
+    }
+}
+template<int Tiles>
+__global__ void depth_mix_fused(Streams inputs, const float* query, float* output, int streams) {
+    depth_mix_fused_body<Tiles>(inputs, query, output, streams);
+}
+template<int Tiles>
+__global__ void r4dchain_depth_mix_fused(Streams inputs, const float* query, float* output, int streams) {
+    r4d_chain_wait();
+    depth_mix_fused_body<Tiles>(inputs, query, output, streams);
+    r4d_chain_done();
+}
+// Up to four mixes over the same streams in one launch (inkling2_mixn). A core visit
+// of the second and third pass makes four (the loop messages), a global layer three (q, k, v); each
+// was a launch of its own behind the one before. Block (token, tile, z) is depth_mix_fused's block
+// (token, tile) for query z, the same body on the same operands, so each output has the bytes its
+// own launch wrote.
+struct MixSet { const float* q[4]; float* y[4]; };
+template<int Tiles>
+__global__ void depth_mix_fused_n(Streams inputs, MixSet set, int streams) {
+    depth_mix_fused_body<Tiles>(inputs, set.q[blockIdx.z], set.y[blockIdx.z], streams);
+}
+template<int Tiles>
+__global__ void r4dchain_depth_mix_fused_n(Streams inputs, MixSet set, int streams) {
+    r4d_chain_wait();
+    depth_mix_fused_body<Tiles>(inputs, set.q[blockIdx.z], set.y[blockIdx.z], streams);
+    r4d_chain_done();
+}
