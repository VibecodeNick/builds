+                for(int d=0;d<hd/16;++d) {
+                    InkB8 v;
+#pragma unroll
+                    for(int e=0;e<8;++e) {
+                        int i=(half*8+e)*width+hd+16*d+col;
+                        // A recycled or partially filled page can have non-finite values in
+                        // the tail. A masked zero probability cannot cancel a NaN in WMMA.
+                        const int j=page*16+half*8+e;
