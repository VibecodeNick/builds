+// Inkling 2 Mini's text trunk, with shared physical weights and visit-private caches.
+#include "graph.h"
+#include "vision.h"
+#include "draft.h"
+#include "chat.h"
+#include <cmath>
+#include <sstream>
+#include <unordered_map>
+
+namespace inkling2 {
+struct Shape {
+    int h, heads, kh, d, rel, extent, window, kernel, ff, experts, top, vocab;
+    int layers, start, end, passes, rank, span, max_seqs, max_ctx;
+    double eps, qclip, rclip, alpha, floor, gate_cap, up_cap, route_scale, logit_cap;
+    uint32_t kvdt;
+    int attn_world=1, world=1, expert_base=0, local_experts=0, vocab_rows=0;
+    bool qgate_split=false; // q and gate_attn stored as two weights: any tp > 1 layout, or a pack converted with the split key
+    std::vector<bool> local;
+    bool read(const RadModelMeta* m,const RadBuildCtx* c) {
+        auto i=[&](const char* k){return (int)meta_text_geti(m,k,-1);};
+        auto f=[&](const char* k){return meta_text_getf(m,k,-1);};
+        h=i("hidden_size"); heads=i("num_attention_heads"); kh=i("num_key_value_heads");
+        d=i("head_dim"); rel=i("d_rel"); extent=i("rel_extent"); window=i("sliding_window_size");
+        kernel=i("sconv_kernel_size"); ff=i("intermediate_size"); experts=i("n_routed_experts");
+        top=i("num_experts_per_tok"); vocab=i("unpadded_vocab_size"); layers=i("num_hidden_layers");
+        start=i("loop_config.core_start"); end=i("loop_config.core_end");
+        passes=i("loop_config.num_passes"); rank=i("loop_config.gate_rank");
+        span=i("n_layers_per_attn_res_block"); eps=f("rms_norm_eps"); qclip=f("qk_l2_clip_threshold");
+        rclip=f("rel_l2_clip_threshold"); alpha=f("log_scaling_alpha"); floor=f("log_scaling_n_floor");
+        gate_cap=f("mlp_gate_softcap"); up_cap=f("mlp_up_softcap"); route_scale=f("route_scale");
+        logit_cap=f("final_logit_softcapping"); kvdt=rad_kv_cache_dtype(c,RAD_BF16);
+        world=c->world_size;
+        attn_world=kh%world==0 && heads%world==0?world:1;
+        // One card reads q|gate as one concatenated weight. Two cards shard q and gate by head, so
+        // their pack holds the two tensors apart: convert it with --set radiance.inkling2.qgate=split
+        // (the key travels in the pack).
+        qgate_split=attn_world>1 || !std::strcmp(meta_text_gets(m,"radiance.inkling2.qgate",""),"split");
+        if (experts<=0 || experts%world) return false;
+        local_experts=experts/world;
+        expert_base=c->rank*local_experts;
+        vocab_rows=shard_extent(vocab,world,c->rank);
+        max_seqs=c->max_seqs; max_ctx=c->max_ctx;
+        if(h<=0||d!=128||heads<=0||kh<=0||heads%kh||rel<=0||extent<=0||window<=0||
+           kernel!=4||ff<=0||experts<=0||top<=0||top>experts||vocab<=0||layers<=0||
+           start<=0||end<=start||end>layers||passes<1||rank<=0||span<=0||start%span||
+           (end-start)%span||layers/span+2>8||eps<=0||floor<=0||qclip<=0||rclip<=0||
+           alpha<0||gate_cap<=0||up_cap<=0||route_scale<=0||logit_cap<=0||
+           i("swa_head_dim")!=d||i("swa_num_attention_heads")!=heads||
+           i("swa_num_key_value_heads")!=kh||i("n_shared_experts")!=0||
+           (kvdt!=RAD_BF16&&kvdt!=RAD_I8)) return false;
+        std::string ids=meta_text_gets(m,"local_layer_ids","");
+        for(auto& ch:ids) if(ch==','||ch=='['||ch==']') ch=' ';
+        std::istringstream in(ids);
+        local.assign(layers,false);
+        int n;
+        while(in>>n) {
+            if(n<0||n>=layers||local[n]) return false;
+            local[n]=true;
+        }
+        return in.eof() && std::count(local.begin(),local.end(),true)>0;
+    }
+};
+struct Controls {rad_weight down,gain,forget;};
+struct Layer {
+    rad_weight q,k,v,r,sink,gate,o,qscale,rscale,table;
+    rad_weight qgate=0; // q and gate_attn as one N-concatenated weight (one attention rank only)
+    rad_weight norm[3]{},conv[4]{},dyn[2]{},aq=0,mq,fn,router,bias,gu,dn;
+    Controls ctrl[4]{};
+    bool quant=false;
+    rad_weight w4[2][2][2]{}; // [projection][parity][codes, scale]
+};
+struct Model {
+    Program prog;
+    Draft draft;
+    InkVision vision;
+    InkVisionRows media;
+    size_t after_embed=0;
+    Tensor taps{};
+    bool have_draft=false;
+    Shape s;
+    std::vector<Layer> layers;
+    rad_weight emb,en,fin,fn,lm,loop,loopkv;
+    rad_kvgroup paged[2]{},conv[4]{};
+};
+static Model models[MAX_SLOTS];
+
+static int weights(RadBuilder* b,Model& m) {
+    auto& p=m.prog;
+    auto& s=m.s;
+    int layer=-1, status=RAD_OK;
+    auto w=[&](std::string path,std::initializer_list<int64_t> shape,uint32_t dt=RAD_BF16, int shard=RAD_SHARD_NONE) {
+        std::string src="model.llm."+path;
+        const char* logical=p.names.f("%s",path.c_str());
+        int rc=map_copy(b,logical,p.names.ckpt("%s",src.c_str()));
+        if(rc!=RAD_OK) status=rc;
+        rad_weight h=decl_w(b,logical,dt,shape,RAD_ACCESS_PER_TOKEN,shard,
+                            layer<0?grp_model():grp_layer(layer));
+        if(!h) status=RAD_E_INVAL;
+        return h;
+    };
+    int H=s.h,heads=s.heads/s.attn_world,kh=s.kh/s.attn_world,Q=heads*s.d,K=kh*s.d,R=heads*s.rel,I=s.ff,W=s.kernel;
+    m.emb=w("embed.weight",{s.vocab,H});
+    m.en=w("embed_norm.weight",{H},RAD_F32);
+    m.fin=w("attn_res.output_query",{H},RAD_F32);
+    m.fn=w("norm.weight",{H},RAD_F32);
+    m.lm=w("unembed.weight",{s.vocab_rows,H},RAD_BF16,RAD_SHARD_ROW);
+    m.loop=w("middle_cycle_cross_pass_queries",{2*(s.end-s.start),H},RAD_F32);
+    m.loopkv=w("middle_cycle_cross_pass_kv_queries",{2*(s.end-s.start),H},RAD_F32);
+    m.layers.resize(s.layers);
+    for(layer=0;layer<s.layers;++layer) {
+        auto& l=m.layers[layer];
+        const bool local=s.local[layer];
+        std::string prefix="layers."+std::to_string(layer)+".";
+        auto lw=[&](const char* k,std::initializer_list<int64_t> shape,uint32_t dt=RAD_BF16) {return w(prefix+k,shape,dt);};
+        auto part=[&](const char* key,std::initializer_list<int64_t> shape,int axis=RAD_SHARD_ROW) {
+            return w(prefix+key,shape,RAD_BF16,s.attn_world==1?RAD_SHARD_NONE:axis);
+        };
+        if(!s.qgate_split) {
+            // q and gate_attn read the same normalized input, and at N = 2,304 each GEMM ran its
+            // 144 column tiles at 67% of bandwidth (24.6 us for 10.6 MB). One launch over the two
+            // concatenated along N keeps every output column's reduction (the K split is picked
+            // from the tile count, 144 and 288 both land on one), halves the launches and doubles
+            // the blocks in flight. The checkpoint tensors are untouched: the loader concatenates,
+            // which needs a pack converted with this plugin.
+            const char* joined=p.names.f("%sattn.wq_gate",prefix.c_str());
+            RAD_ARCH_TRY(map_concat(b,joined,{p.names.ckpt("model.llm.%sattn.wq_du.weight",prefix.c_str()),
+                                              p.names.ckpt("model.llm.%sattn.gate_attn.weight",prefix.c_str())}));
+            l.qgate=decl_w(b,joined,RAD_BF16,{2*Q,H},RAD_ACCESS_PER_TOKEN,RAD_SHARD_NONE,grp_layer(layer),0,{Q,Q});
+            if(!l.qgate) return RAD_E_INVAL;
+        } else {
+            l.q=part("attn.wq_du.weight",{Q,H}); l.gate=part("attn.gate_attn.weight",{Q,H});
+        }
+        l.k=part("attn.wk_dv.weight",{K,H});
+        l.v=part("attn.wv_dv.weight",{K,H}); l.r=part("attn.wr_du.weight",{R,H});
+        l.o=lw("attn.wo_ud.weight",{H,Q*s.attn_world});
+        l.sink=part("attn.attn_sink_proj.weight",{heads,H});
+        l.qscale=part("attn.q_l2_clip.scale",{heads,s.d});
+        l.rscale=part("attn.rel_l2_clip.scale",{heads,s.rel});
+        l.table=lw("attn.rel_logits_proj.proj",{s.rel,local?s.window:s.extent});
+        if(local) {
+            l.norm[0]=l.norm[1]=l.norm[2]=lw("attn_norm.weight",{H},RAD_F32);
+            l.conv[0]=part("attn.k_sconv.weight",{K,1,W});
+            l.conv[1]=part("attn.v_sconv.weight",{K,1,W});
+        } else {
+            l.norm[0]=lw("q_input_norm.weight",{H},RAD_F32);
+            l.norm[1]=lw("k_input_norm.weight",{H},RAD_F32);
+            l.norm[2]=lw("v_input_norm.weight",{H},RAD_F32);
+            l.conv[0]=part("attn.k_sconv.static_w",{W,K},RAD_SHARD_COL);
+            l.conv[1]=part("attn.v_sconv.static_w",{W,K},RAD_SHARD_COL);
+            l.dyn[0]=part("attn.k_sconv.weight_proj",{kh*W,H});
+            l.dyn[1]=part("attn.v_sconv.weight_proj",{kh*W,H});
+        }
+        l.conv[2]=lw("attn_sconv.weight",{H,1,W});
+        l.conv[3]=lw("mlp_sconv.weight",{H,1,W});
+        if(layer>0) {
+            auto name="attn_res.attn_queries."+std::to_string(layer-1);
+            l.aq=local?w(name,{H},RAD_F32):w(name,{3,H},RAD_F32);
+        }
+        l.mq=w("attn_res.mlp_queries."+std::to_string(layer),{H},RAD_F32);
+        l.fn=lw("mlp_norm.weight",{H},RAD_F32);
+        l.router=lw("mlp.gate.weight",{s.experts,H},RAD_F32);
+        l.bias=lw("mlp.gate.bias",{s.experts},RAD_F32);
+        // Radiance moves experts separately, so slice the checkpoint stack on axis zero.
+        for(int proj=0;proj<2;++proj) {
+            auto src=p.names.ckpt("model.llm.%smlp.experts.%s",prefix.c_str(),proj?"w2_weight":"w13_weight");
+            auto name=[&](int e,const char* suffix) {
+                return p.names.f("blk.%d.ffn_%s_exps.%d.%s",layer,proj?"down":"gate_up",s.expert_base+e,suffix);
+            };
+            for(int e=0;e<s.local_experts;++e) RAD_ARCH_TRY(map_slice(b,name(e,"weight"),src,s.expert_base+e));
+            RadEncoding enc{};
+            bool known=weight_enc(b,name(0,"weight"),&enc);
+            bool q4=known&&rad_enc_is(&enc,"affine")&&enc.plane[0].dtype==RAD_I4;
+            if(proj==0) l.quant=q4;
+            if(l.quant!=q4) return RAD_E_DTYPE;
+            int rows=proj?H:2*I,cols=proj?I:H;
+            if(q4) {
+                const auto* scale=rad_enc_plane(&enc,"scale");
+                if(!scale||scale->dtype!=RAD_BF16||scale->block[0]!=1||scale->block[1]!=128||
+                   enc.n_planes!=2||*enc.transform||cols%128) return RAD_E_DTYPE;
+                // Each parity's codes and scales form their own contiguous handle table.
+                for(int parity=0;parity<2;++parity) for(int plane=0;plane<2;++plane) {
+                    for(int e=parity;e<s.local_experts;e+=2) {
+                        auto source=name(e,"weight");
+                        auto h=decl_view(b,plane?name(e,"scale"):source,plane?source:nullptr,
+                                plane?"scale":"codes",plane?RAD_BF16:RAD_I4,
+                                {rows,plane?cols/128:cols},RAD_ACCESS_CONDITIONAL,RAD_SHARD_NONE,
+                                grp_expert_slot(layer,e,proj));
+                        if(!h) return RAD_E_INVAL;
+                        auto& first=l.w4[proj][parity][plane];
+                        if(e==parity) first=h;
+                        else if(h!=first+(unsigned)(e/2)) return RAD_E_STATE;
+                    }
+                }
+            } else {
+                if(known&&(!rad_enc_is(&enc,"plain")||enc.plane[0].dtype!=RAD_BF16)) return RAD_E_DTYPE;
+                for(int e=0;e<s.local_experts;++e) {
+                    auto h=decl_w(b,name(e,"weight"),RAD_BF16,{rows,cols},RAD_ACCESS_CONDITIONAL,
+                                  RAD_SHARD_NONE,grp_expert_slot(layer,e,proj));
+                    if(!h) return RAD_E_INVAL;
+                    auto& first=proj?l.dn:l.gu;
+                    if(e==0) first=h;
+                    else if(h!=first+(unsigned)e) return RAD_E_STATE;
+                }
+            }
+        }
+        if(layer>=s.start&&layer<s.end) {
+            const char* labels[]={"attn","k","v","mlp"};
+            for(int j=0;j<4;++j) {
+                auto base=prefix+"controllers."+labels[j]+".";
+                l.ctrl[j]={w(base+"down_weight",{s.rank,2*H}),
+                           w(base+"gain_weight",{H,s.rank},RAD_F32),
+                           w(base+"forget_weight",{H,s.rank},RAD_F32)};
+            }
+        }
+    }
+    return status;
+}
+
+// A visit's three controllers (q, k, v) and the RMS norm behind each as one op: out[j] is what
+// g.rms(controller(g,s,w[j],x[j],msg[j]),norm[j],0,RAD_BF16) returned.
+static void controller3(Graph& g,const Shape& s,const Controls* w,const Tensor* x,const Tensor* msg,
+                        const rad_weight* norm,Tensor* out) {
+    for(int j=0;j<3;++j) out[j]=g.buf("norm",s.h,RAD_BF16);
+    g.op("inkling2_ctl3",{RAD_RANGE("M",1,g.T),RAD_INT("n",s.h),RAD_INT("rank",s.rank),RAD_F64("eps",s.eps)},
+         {x[0].arg(),x[1].arg(),x[2].arg(),msg[0].arg(),msg[1].arg(),msg[2].arg(),
+          wt(w[0].down),wt(w[1].down),wt(w[2].down),wt(w[0].gain),wt(w[1].gain),wt(w[2].gain),
+          wt(w[0].forget),wt(w[1].forget),wt(w[2].forget),wt(norm[0]),wt(norm[1]),wt(norm[2]),
+          out[0].arg(true),out[1].arg(true),out[2].arg(true)});
+}
+static Tensor controller(Graph& g,const Shape& s,const Controls& w,Tensor x,Tensor msg) {
+    Tensor y=g.buf("controller",s.h,RAD_F32);
+    g.op("inkling2_control",{RAD_RANGE("M",1,g.T),RAD_INT("n",s.h),RAD_INT("rank",s.rank),
+                             RAD_F64("eps",s.eps)},
+         {x.arg(),msg.arg(),wt(w.down),wt(w.gain),wt(w.forget),y.arg(true)});
+    return y;
+}
+
+static Tensor convolve(Graph& g,const Model& m,const Layer& l,int which,Tensor x,Tensor dyn={}) {
+    const int nh=dyn.buf?m.s.kh/m.s.attn_world:0;
+    Tensor y=g.buf("conv",x.width);
+    auto group=m.conv[which];
+    g.op("inkling2_conv",{RAD_RANGE("M",1,g.T),RAD_INT("n",x.width),RAD_INT("width",m.s.kernel),
+                         RAD_STR("dtype","bf16"),RAD_INT("n_head",nh)},
+         {x.arg(),wt(l.conv[which]),{Field::kv},{Field::cu},{Field::index},{Field::prefix},
+          {Field::accepted},y.arg(true),dyn.buf?dyn.arg():Arg{Field::absent}},
+         Band::convolution,1,group);
+    return y;
+}
+static Tensor clip(Graph& g,const Shape& s,Tensor x,int heads,rad_weight scale,
+                   double threshold,bool logscale) {
+    Tensor y=g.buf("clip",x.width);
+    g.op("inkling2_clip",{RAD_RANGE("M",1,g.T),RAD_INT("n_head",heads),RAD_INT("head_dim",x.width/heads),
+                         RAD_F64("threshold",threshold),RAD_F64("log_alpha",logscale?s.alpha:0.0),
+                         RAD_INT("log_floor",(int)s.floor),RAD_STR("dtype","bf16")},
+         {x.arg(),wt(scale),{logscale?Field::pos:Field::absent},y.arg(true)});
+    return y;
+}
+static Tensor attention(Graph& g,const Model& m,const Layer& l,bool local,const Tensor in[3]) {
+    auto& s=m.s;
+    int heads=s.heads/s.attn_world,kh=s.kh/s.attn_world;
+    int Q=heads*s.d,K=kh*s.d;
+    auto project=[&](Tensor x,rad_weight weight,int n) {
+        if(s.attn_world==1) return g.gemm(x,weight,n);
+        Tensor y=g.buf("linear",n,x.dt,x.rows);
+        // Keep each head's reduction order when the rank owns fewer weight rows.
+        g.op("gemm_nt",{RAD_RANGE("M",1,g.maxrows(x.rows)),RAD_INT("K",x.width),RAD_INT("N",n),
+                        RAD_STR("dtype",rad_dtype_name(x.dt)),RAD_INT("split_n",n*s.attn_world)},
+             {x.arg(),wt(weight),y.arg(true)},Band::token,x.rows);
+        return y;
+    };
+    auto kv=[&](int j,rad_weight w) {
+        Tensor x=project(in[j+1],w,K);
+        Tensor dyn=local?Tensor{}:project(in[j+1],l.dyn[j],kh*s.kernel);
+        return convolve(g,m,l,j,x,dyn);
+    };
+    // The three clips of the visit (q, r, k) as one launch: the same per-head arithmetic as
+    // `clip`, with the q and r projections and the k convolution issued first.
+    Tensor qx,gate;
+    if(l.qgate) {
+        // One GEMM for q and gate_attn; q and gate are its column halves (pitched rows downstream).
+        Tensor qg=g.gemm(in[0],l.qgate,2*Q);
+        qx=qg; qx.col=0; qx.width=Q;
+        gate=qg; gate.col=Q; gate.width=Q;
+    } else {
+        qx=project(in[0],l.q,Q);
+        gate=project(in[0],l.gate,Q);
+    }
+    Tensor rx=project(in[0],l.r,s.rel*heads), kx=kv(0,l.k);
+    Tensor q=g.buf("clip",qx.width), r=g.buf("clip",rx.width), k=g.buf("clip",kx.width);
+    {
+        const double la=local?0.0:s.alpha;
+        g.op("inkling2_clip3",{RAD_RANGE("M",1,g.T),RAD_INT("n_head",heads),RAD_INT("head_dim",s.d),
+                               RAD_F64("threshold",s.qclip),RAD_F64("log_alpha",la),
+                               RAD_INT("n_head1",heads),RAD_INT("head_dim1",s.rel),
+                               RAD_F64("threshold1",s.rclip),RAD_F64("log_alpha1",la),
+                               RAD_INT("n_head2",kh),RAD_INT("head_dim2",s.d),RAD_F64("threshold2",s.qclip),
+                               RAD_INT("log_floor",(int)s.floor),RAD_STR("dtype","bf16")},
+             {qx.arg(),wt(l.qscale),rx.arg(),wt(l.rscale),kx.arg(),Arg{Field::absent},
+              {local?Field::absent:Field::pos},q.arg(true),r.arg(true),k.arg(true)});
+    }
+    Tensor v=g.rms(kv(1,l.v),0,s.d);
+    Tensor sinks=project(in[0],l.sink,heads);
+    Tensor y=g.buf("context",Q);
+    const rad_kvgroup group=m.paged[local];
+    const char* kd=rad_dtype_name(s.kvdt);
+    // Declare the reader first: the block manager asks that row for its page size.
+    // Issue the store before it.
+    g.op("inkling2_attn",{RAD_RANGE("q_len",1,g.T),RAD_INT("head_dim",s.d),RAD_INT("gqa",heads/kh),
+                         RAD_INT("causal",1),RAD_INT("window",local?s.window:0),RAD_INT("n_head",heads),
+                         RAD_INT("block_size",RAD_KV_BLOCK),RAD_INT("max_ctx",s.max_ctx),
+                         RAD_INT("max_seqs",s.max_seqs),RAD_STR("q_dtype","bf16"),RAD_STR("kv_dtype",kd),
+                         RAD_INT("d_rel",s.rel),RAD_INT("rel_extent",local?s.window:s.extent),
+                         RAD_INT("split_heads",s.heads)},
+         {q.arg(),{Field::kv},{Field::blocks},{Field::used},{Field::absent},{Field::absent},{Field::cu},
+          r.arg(),sinks.arg(),wt(l.table),y.arg(true)},Band::query,1,group);
+    auto block=rad_kv_block_size(g.b,group);
+    g.op("kv_store",{RAD_RANGE("M",1,g.T),RAD_INT("head_dim",s.d),RAD_INT("n_head_kv",kh),
+                     RAD_INT("block_size",block),RAD_STR("kv_dtype",kd)},
+         {k.arg(),v.arg(),{Field::slots},{Field::kv}},Band::token,1,group);
+    std::iter_swap(g.p.calls.end()-2,g.p.calls.end()-1);
+    Tensor gated=g.buf("gated_context",Q);
+    g.op("inkling2_gate",{RAD_RANGE("M",1,g.T),RAD_INT("n",Q),RAD_STR("dtype","bf16")},
+         {gate.arg(),y.arg(),gated.arg(true)});
+    if(s.attn_world>1) {
+        Tensor whole=g.buf("context_all_heads",Q*s.attn_world);
+        g.op("all_gather",{RAD_INT("world_size",s.attn_world),RAD_RANGE("numel",Q,int64_t(g.T)*Q),
+                           RAD_STR("dtype","bf16"),RAD_INT("row",Q)},
+             {gated.arg(),whole.arg(true)},Band::token,Q);
+        gated=whole;
+    }
+    return convolve(g,m,l,2,g.gemm(gated,l.o,s.h));
+}
+static Tensor residual(Graph& g,Tensor x,Tensor delta,bool round) {
+    Tensor y=g.buf("residual",x.width,RAD_F32);
+    g.op("inkling2_add_residual",{RAD_RANGE("M",1,g.T),RAD_INT("n",x.width),
+                                 RAD_INT("round_bf16",round?1:0),RAD_STR("dtype","f32")},
+         {x.arg(),delta.arg(),y.arg(true)});
+    return y;
+}
+static Tensor moe(Graph& g,const Model& m,const Layer& l,Tensor x) {
+    const auto& s=m.s;
+    const int E=s.local_experts, top=s.top;
+    Tensor scores=g.gemm(x,l.router,s.experts,true), ids=g.buf("experts",top,RAD_I32),
+           weights=g.buf("prob",top,RAD_F32);
+    g.op("router_sigmoid_topk",{RAD_RANGE("M",1,g.T),RAD_INT("n_expert",s.experts),RAD_INT("top_k",top),
+                               RAD_INT("norm",1),RAD_F64("route_scale",s.route_scale),RAD_STR("dtype","f32")},
+         {scores.arg(),wt(l.bias),ids.arg(true),weights.arg(true)});
+    Tensor sorted=g.buf("expert_rows",1,RAD_I32,top), offsets=g.fixed("offsets",E+1,RAD_I32),
+           counts=g.fixed("counts",E,RAD_I32);
+    g.op("moe_scatter",{RAD_RANGE("M",1,g.T),RAD_INT("n_expert",E),RAD_INT("expert_base",s.expert_base),RAD_INT("top_k",top)},
+         {ids.arg(),sorted.arg(true),offsets.arg(true),counts.arg(true)});
+    // pre_codes / pre_scales: the activation already quantised by a fused producer (inkling2_situ_quant).
+    auto grouped=[&](Tensor a,rad_weight w,int n,bool first,Tensor pre_codes={},Tensor pre_scales={}) {
+        Tensor y=g.buf("expert_linear",n,RAD_BF16,top);
+        if(l.quant) {
+            Tensor codes=pre_codes, scales=pre_scales;
+            if(!pre_codes.buf) {
+                codes=g.buf("expert_codes",a.width,RAD_F8E4M3,a.rows);
+                scales=g.buf("expert_scales",a.width/128,RAD_F32,a.rows);
+                g.op("quant_act_fp8",{RAD_RANGE("M",1,g.T*a.rows),RAD_INT("n",a.width),
+                                      RAD_INT("group",128),RAD_STR("dtype","bf16")},
+                     {a.arg(),codes.arg(true),scales.arg(true)},Band::expert,a.rows);
+            }
+            const auto& tab=l.w4[first?0:1];
+            g.op("moe_gemm_q",{RAD_RANGE("M",1,g.T),RAD_INT("N",n),RAD_INT("K",a.width),
+                               RAD_INT("n_expert",E),RAD_INT("top_k",top),RAD_INT("group",128),
+                               RAD_STR("a_order",first?"token":"sorted"),RAD_STR("dtype","w4a8"),
+                               RAD_INT("N_odd",n),RAD_INT("K_odd",a.width),RAD_INT("parts",first?2:1)},
+                 {codes.arg(),scales.arg(),table(tab[0][0],(E+1)/2),table(tab[0][1],(E+1)/2),
+                  sorted.arg(),offsets.arg(),table(tab[1][0],E/2),table(tab[1][1],E/2),y.arg(true)});
+            return y;
+        }
+        g.op("moe_gemm",{RAD_RANGE("M",1,g.T),RAD_INT("N",n),RAD_INT("K",a.width),
+                         RAD_INT("n_expert",E),RAD_INT("top_k",top),
+                         RAD_STR("a_order",first?"token":"sorted"),RAD_STR("dtype","bf16")},
+             {a.arg(),table(w,E),sorted.arg(),offsets.arg(),y.arg(true)});
+        return y;
+    };
+    Tensor gu=grouped(x,l.gu,2*s.ff,true), down;
+    if(l.quant && s.ff%128==0) {
+        // situ and the down projection's quantiser as one launch (the standalone pair below for
+        // the bf16 experts): same bf16-rounded values, same codes and scales.
+        Tensor codes=g.buf("expert_codes",s.ff,RAD_F8E4M3,top), scales=g.buf("expert_scales",s.ff/128,RAD_F32,top);
+        g.op("inkling2_situ_quant",{RAD_RANGE("M",1,g.T*top),RAD_INT("n",s.ff),RAD_INT("group",128),
+                                    RAD_F64("gate_cap",s.gate_cap),RAD_F64("up_cap",s.up_cap),RAD_STR("dtype","bf16")},
+             {gu.arg(),codes.arg(true),scales.arg(true)},Band::expert,top);
+        Tensor act=gu; act.width=s.ff;   // the K the down projection sees
+        down=grouped(act,l.dn,s.h,false,codes,scales);
+    } else {
+        Tensor act=g.buf("situ",s.ff,RAD_BF16,top);
+        g.op("inkling2_situ",{RAD_RANGE("M",1,g.T*top),RAD_INT("n",s.ff),RAD_F64("gate_cap",s.gate_cap),
+                              RAD_F64("up_cap",s.up_cap),RAD_STR("dtype","bf16")},
+             {gu.arg(),act.arg(true)},Band::expert,top);
+        down=grouped(act,l.dn,s.h,false);
+    }
+    Tensor y=g.buf("expert_out",s.h);
+    if (s.world>1) {
+        // Restore routed output rows to (token, slot) order before reducing them. Every
+        // row is nonzero on at most one rank. The final weighted sum then rounds once,
+        // in the same slot order as the single-rank model.
+        Tensor slots=g.buf("expert_slots",s.h,RAD_BF16,top);
+        const auto rows=RAD_RANGE("M",1,int64_t(g.T)*top);
+        g.op("fill",{rows,RAD_INT("n",s.h),RAD_STR("dtype","bf16"),RAD_F64("value",0)},
+             {slots.arg(true)},Band::expert,top);
+        g.op("scatter_rows",{rows,RAD_INT("n",s.h),RAD_STR("dtype","bf16")},
+             {down.arg(),sorted.arg(),slots.arg(true)},Band::expert,top);
+        g.op("all_reduce",{RAD_INT("world_size",s.world),RAD_RANGE("numel",s.h,int64_t(g.T)*top*s.h),
+                           RAD_STR("dtype","bf16"),RAD_INT("exact",1)},
+             {slots.arg(),{Field::absent}},Band::token,top*s.h);
+        auto reduce=g.p.calls.back().op;
+        if(reduce) rad_op_writes(g.b,reduce,&slots.buf,1);
+        sorted=g.buf("slot_ids",1,RAD_I32,top);
+        g.op("iota",{rows,RAD_INT("start",0),RAD_INT("step",1)},
+             {sorted.arg(true)},Band::expert,top);
+        down=slots;
+    }
+    g.op("moe_gather",{RAD_RANGE("M",1,g.T),RAD_INT("n",s.h),RAD_INT("top_k",top),RAD_STR("dtype","bf16")},
+         {down.arg(),weights.arg(),sorted.arg(),{Field::absent},{Field::absent},y.arg(true)});
+    return convolve(g,m,l,3,y);
+}
+static int build(RadBuilder* b,Model& m,const RadModelMeta* meta,const RadBuildCtx* c) {
+    auto& s=m.s;
+    const int out=std::max<int>(c->max_out_rows, std::min<int64_t>(c->max_tok,c->max_seqs*(1+c->max_spec)));
+    Graph g{b,m.prog,(int)c->max_tok,out,0,0,s.eps};
+    // A convolution at two sites in one visit needs two independent history rings.
+    for(int i=0;i<4;++i) {
+        RadKVGroupDecl kd{};
+        kd.kind=RAD_KV_CONV; kd.dtype=RAD_BF16; kd.n_head_kv=1;
+        kd.conv_width=s.kernel; kd.head_dim=i<2?(s.kh/s.attn_world)*s.d:s.h;
+        m.conv[i]=rad_decl_kv_group(b,m.prog.names.f("conv.%d",i),&kd);
+        if(!m.conv[i]) return RAD_E_INVAL;
+    }
+    if(m.have_draft) m.taps=g.buf("draft_features",4*s.h,RAD_BF16);
+    auto tap=[&](int idx,Tensor value) {
+        Tensor dest=m.taps;
+        dest.width=s.h; dest.col=idx*s.h;
+        g.cast_to(value,dest);
+    };
+    Tensor raw=g.buf("embedding",s.h);
+    g.op("embed_lookup",{RAD_RANGE("M",1,g.T),RAD_INT("n_embd",s.h),RAD_INT("n_vocab",s.vocab),
+                         RAD_STR("dtype","bf16")},{{Field::tokens},wt(m.emb),raw.arg(true)});
+    // Between layers the reference stores BF16. Within the residual sum and depth mix it keeps FP32.
+    Tensor embedding=g.rms(raw,m.en);
+    if(m.vision.on) {
+        RAD_ARCH_TRY(m.media.declare(b,m.prog.names,g.T,s.h,s.world,embedding.buf));
+        m.after_embed=g.p.calls.size();
+    }
+    Tensor cur=g.cast(embedding,RAD_F32);
+    std::vector<Tensor> blocks,previous_blocks,prelude;
+    Tensor pre_cur{},prev_cur{};
+    int visit=0;
+    auto run=[&](int i,int pass) {
+        g.visit=visit++;
+        if(m.have_draft) {
+            // Pinned DSpark reads the partial residual on entry to these zero-based visits.
+            if(g.visit==5) tap(0,cur);
+            if(g.visit==23) tap(1,cur);
+            if(g.visit==41) tap(2,cur);
+        }
+        const bool local=s.local[i];
+        if(!m.paged[local]) {
+            RadKVGroupDecl kd{};
+            kd.kind=local?RAD_KV_WINDOW:RAD_KV_FULL; kd.window=local?s.window:0;
+            kd.dtype=s.kvdt; kd.n_head_kv=s.kh/s.attn_world; kd.head_dim=s.d;
+            m.paged[local]=rad_decl_kv_group(b,m.prog.names.f("kv.%s",local?"window":"full"),&kd);
+        }
+        if(rad_bind_layer_kv(b,g.visit,m.paged[local])!=RAD_OK) return RAD_E_INVAL;
+        for(auto cv:m.conv) if(rad_bind_layer_kv(b,g.visit,cv)!=RAD_OK) return RAD_E_INVAL;
+        const auto& l=m.layers[i];
+        Tensor msg[4]{},in[3]{};
+        if(pass>0) {
+            int row=(i-s.start)*2;
+            // The visit's four loop messages are mixes over the same streams: one launch.
+            auto ms=g.mixn(previous_blocks,prev_cur,m.loop,m.loopkv,{{0,row},{0,row+1},{1,row},{1,row+1}},
+                           2*(s.end-s.start));
+            msg[0]=ms[0]; msg[3]=ms[1]; msg[1]=ms[2]; msg[2]=ms[3];
+        }
+        Tensor pre=cur;
+        Tensor local_input=local && l.aq ? g.mix(blocks,cur,l.aq,0) : cur;
+        // A global layer's q, k and v inputs are three mixes over the same streams: one launch.
+        std::vector<Tensor> qkv;
+        if(!local && l.aq) qkv=g.mixn(blocks,cur,l.aq,0,{{0,0},{0,1},{0,2}},3);
+        if(pass>0) {
+            // Second and third pass: the three controllers and their norms side by side.
+            Tensor v[3];
+            for(int j=0;j<3;++j) v[j]=(local || !l.aq) ? local_input : qkv[j];
+            controller3(g,s,l.ctrl,v,msg,l.norm,in);
+        } else for(int j=0;j<3;++j) {
+            if(local&&j) {in[j]=in[0];continue;}
+            Tensor v=(local || !l.aq) ? local_input : qkv[j];
+            in[j]=g.rms(v,l.norm[j],0,RAD_BF16);
+        }
+        Tensor delta=attention(g,m,l,local,in);
+        if(i%s.span==0) {blocks.push_back(pre);cur=g.cast(delta,RAD_F32);}
+        else cur=residual(g,pre,delta,false);
+        Tensor h=g.mix(blocks,cur,l.mq,0);
+        if(pass>0) h=controller(g,s,l.ctrl[3],h,msg[3]);
+        h=g.rms(h,l.fn,0,RAD_BF16);
+        cur=residual(g,cur,moe(g,m,l,h),true);
+        return RAD_OK;
+    };
+    for(int i=0;i<s.start;++i) RAD_ARCH_TRY(run(i,0));
+    prelude=blocks; pre_cur=cur;
+    for(int pass=0;pass<s.passes;++pass) {
+        if(pass>0) {
+            previous_blocks.assign(blocks.begin()+prelude.size()+1,blocks.end());
+            prev_cur=cur; blocks=prelude; cur=pre_cur;
+        }
+        for(int i=s.start;i<s.end;++i) RAD_ARCH_TRY(run(i,pass));
+    }
+    for(int i=s.end;i<s.layers;++i) RAD_ARCH_TRY(run(i,0));
+    auto mixed=g.mix(blocks,cur,m.fin,0);
+    // The last tap is the final normalized hidden state of every token, including prefill.
+    if(m.have_draft) {
+        mixed=g.rms(mixed,m.fn);
+        tap(3,mixed);
+    }
+    Tensor selected=g.buf("sample_rows",s.h,RAD_F32,-1);
+    g.op("gather_rows",{RAD_RANGE("M",1,out),RAD_INT("n",s.h),RAD_STR("dtype","f32")},
+         {mixed.arg(),{Field::out_ids},selected.arg(true)},Band::head);
+    auto hidden=m.have_draft?g.cast(selected,RAD_BF16):g.rms(selected,m.fn,0,RAD_BF16);
+    auto logits=g.buf("raw_logits",s.vocab_rows,RAD_F32,-1);
+    g.op("logits_gemm",{RAD_RANGE("M",1,out),RAD_INT("n_vocab",s.vocab_rows),RAD_INT("n_embd",s.h),
+                        RAD_STR("dtype","bf16")},{hidden.arg(),wt(m.lm),logits.arg(true)},Band::head);
+    // HF's BF16 lm_head is widened before tanh. Preserve its rounded ties for greedy decoding.
+    logits=g.cap(g.cast(g.cast(logits,RAD_BF16),RAD_F32),s.logit_cap);
+    RAD_ARCH_TRY(rad_declare_logits(b,logits.buf));
+    if(g.status!=RAD_OK) return g.status;
+    if(m.have_draft) return m.draft.declare(b,m.prog.names,meta,c,visit,m.taps.buf,m.emb,m.en,m.lm);
+    return RAD_OK;
+}
+static int declare(RadBuilder* b,const RadModelMeta* meta,const RadBuildCtx* c) {
+    if(!b||!meta||!c||c->rank<0||c->rank>=c->world_size||c->world_size<1||c->world_size>2||c->is_draft||rad_build_slot(c)>=MAX_SLOTS)
+        return RAD_E_UNSUPPORTED;
+    Model& m=models[rad_build_slot(c)];
+    m=Model{};
+    m.prog.names=Names(c->scope);
+    if(!m.s.read(meta,c)) {
+        std::fprintf(stderr,"inkling2: missing or unsupported text_config geometry (H=%d layers=%d loop=%d:%d/%d vocab=%d)\n",
+                     m.s.h,m.s.layers,m.s.start,m.s.end,m.s.passes,m.s.vocab);
+        return RAD_E_FORMAT;
+    }
+    m.have_draft=c->max_spec>0 && std::strcmp(rad_meta_gets(meta,"draft.model_type",""),"inkling2_dspark")==0;
+    if(m.have_draft && (m.s.h!=2304 || m.s.layers+(m.s.passes-1)*(m.s.end-m.s.start)!=48))
+        return RAD_E_FORMAT;
+    RAD_ARCH_TRY(weights(b,m));
+    RAD_ARCH_TRY(m.vision.declare(b,meta,c,m.prog.names,m.s.h,meta->n_layers+1));
+    return build(b,m,meta,c);
+}
+static void step(RadCtx* ctx,const RadBatch* batch) {
+    auto& m=models[rad_slot(ctx)];
+    if(batch->enc) {m.vision.step(ctx,batch);return;}
+    if(batch->draft_pass) {
+        if(!m.have_draft) rad_step_fail(ctx,"inkling2: drafter absent");
+        else if(batch->draft_pass>0) m.draft.step(ctx,batch);
+        else m.draft.context(ctx,batch);
+        return;
+    }
+    if(batch->spec_parent||(batch->n_spec && !m.have_draft)||(batch->n_mm_rows&&!m.vision.on)) {
+        rad_step_fail(ctx,"inkling2: unsupported tree or multimodal batch");
+        return;
+    }
+    auto& prog=models[rad_slot(ctx)].prog;
+    size_t index=0;
+    for(const auto& call:prog.calls) {
+        if(batch->n_mm_rows && index==m.after_embed) m.media.step(ctx,batch);
+        ++index;
+        if(call.run(ctx,batch)!=RAD_OK) {rad_step_fail(ctx,"inkling2: trunk operator failed");return;}
+    }
+}
+}
+namespace inkling2 {
+static int probe(const RadModelMeta* meta,RadArchProbe* out) {
+    if(!meta||!out) return RAD_E_INVAL;
+    out->draft_depth=0; out->draft_depth_fixed=0;
+    // Chained launches with or without the drafter: a target-only step was 2,273 launches before any were merged, 28% of it
+    // idle between them; the kernels with chained forms stop waiting on the bit.
+    out->chain_pays=RAD_CHAIN_ALWAYS;
+    const char* kind=rad_meta_gets(meta,"draft.model_type","");
+    if(!*kind) return RAD_OK;
+    if(std::strcmp(kind,"inkling2_dspark") || rad_meta_geti(meta,"draft.block_size",0)!=8)
+        return RAD_E_UNSUPPORTED;
+    out->draft_depth=7; out->draft_depth_fixed=1;
+    return RAD_OK;
+}
+}
+RAD_ARCH_CHAT_FORMAT(inkling2)
+RAD_ARCH_PROBE(inkling2)
+RAD_ARCH_MULTI_INSTANCE()
+RAD_ARCH_PLUGIN(inkling2,"inkling2","","0.1.0","Inkling 2 Mini looped text trunk")
