+extern "C" int r4d_reference_order_mix(const RadArgs *a, RadStream st) {
+  int n = r4d_geti_or(a, "n", 0), count = r4d_geti_or(a, "streams", 0),
+      qr = r4d_geti_or(a, "query_row", -1);
+  const auto *q = r4d_opt(a, 0);
