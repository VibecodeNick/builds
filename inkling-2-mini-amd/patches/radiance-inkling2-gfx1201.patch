+extern "C" int64_t r4d_inkling2_control_scratch(const RadArgs* a) {
+    const long long m=r4d_geti_or(a,"M",0),rank=r4d_geti_or(a,"rank",0),n=r4d_geti_or(a,"n",0);
+    if(m<1 || m>65535*8 || rank<32 || rank>64 || n<1024 || n>8192)return 0;
+    return (m*rank+std::min<long long>(m,16)*n)*sizeof(float);
+}
+
+extern "C" int r4d_inkling2_control(const RadArgs* a,RadStream stream) {
+    bool chain=r4d_geti_or(a,"chain",0)!=0;
+    const auto *x=r4d_opt(a,0),*msg=r4d_opt(a,1),*down=r4d_opt(a,2),*g=r4d_opt(a,3),
+               *f=r4d_opt(a,4),*out=r4d_opt(a,5);
+    const int n=r4d_geti_or(a,"n",0), rank=r4d_geti_or(a,"rank",0);
+    const float eps=r4d_getf(a,"eps",1e-6);
+    if(!dense(x,RAD_F32)||!dense(msg,RAD_F32)||!dense(down,RAD_BF16)||!dense(g,RAD_F32)||
+        !dense(f,RAD_F32)||!dense(out,RAD_F32)) return R4D_NO(RAD_E_DTYPE);
+    if(n<1 || n>8192 || rank<1 || rank>64 || eps<=0 || r4d_numel(x)%n) return R4D_NO(RAD_E_SHAPE);
+    const long long m=r4d_numel(x)/n;
+    if(m<1||m>INT_MAX||r4d_numel(msg)!=m*n||r4d_numel(out)!=m*n||r4d_numel(down)!=2LL*n*rank||
+        r4d_numel(g)!=(long long)n*rank||r4d_numel(f)!=(long long)n*rank) return R4D_NO(RAD_E_SHAPE);
+    chain=chain && m<=64;
+    if(m<=65535*8 && n>=1024 && rank>=32 && a->scratch && a->scratch_bytes>=m*rank*(long long)sizeof(float)) {
+        auto* hidden=(float*)a->scratch;
+        // With room for the normalized pair, one token takes the verify heights two
+        // launches (below): the token is normalized once instead of in each of 64 blocks, then the
+        // float-pair dots. Equal bytes at one token; 12.6 us to about 6 a launch.
+        if(m==1 && a->scratch_bytes<m*(n+rank)*(long long)sizeof(float)) {
+            if(chain) r4dchain_control_norm_down_rank<<<dim3(rank,m),256,0,(hipStream_t)stream>>>((const float*)x->data,
+                (const float*)msg->data,(const uint16_t*)down->data,hidden,n,rank,eps);
+    else control_norm_down_rank<<<dim3(rank,m),256,0,(hipStream_t)stream>>>((const float*)x->data,
+                (const float*)msg->data,(const uint16_t*)down->data,hidden,n,rank,eps);
+        } else if(m<=16 && a->scratch_bytes>=m*(n+rank)*(long long)sizeof(float)) {
+            auto* normalized=(uint16_t*)a->scratch;
+            hidden=(float*)(normalized+2*m*n);
+            if(chain) r4dchain_control_norm_token<<<m,256,0,(hipStream_t)stream>>>((const float*)x->data,
+                (const float*)msg->data,normalized,n,eps);
+    else control_norm_token<<<m,256,0,(hipStream_t)stream>>>((const float*)x->data,
+                (const float*)msg->data,normalized,n,eps);
+            int status=launched();
+            if(status!=RAD_OK)return status;
+            if(chain) r4dchain_control_down_rank<<<dim3(rank,m),256,0,(hipStream_t)stream>>>(normalized,
+                (const uint16_t*)down->data,hidden,2*n,rank);
+    else control_down_rank<<<dim3(rank,m),256,0,(hipStream_t)stream>>>(normalized,
+                (const uint16_t*)down->data,hidden,2*n,rank);
+        } else if(std::getenv("R4D_INKLING2_CONTROL_PROBE") && std::getenv("R4D_INKLING2_CONTROL_PROBE")[0]==(char)98) {
+        } else {
+            const int rows=m>256?1:(rank+7)/8;
+            if(chain) r4dchain_control_down<<<dim3(m,rows),256,4*n,(hipStream_t)stream>>>((const float*)x->data,
+                (const float*)msg->data,(const uint16_t*)down->data,hidden,n,rank,eps);
+    else control_down<<<dim3(m,rows),256,4*n,(hipStream_t)stream>>>((const float*)x->data,
+                (const float*)msg->data,(const uint16_t*)down->data,hidden,n,rank,eps);
+        }
+        int status=launched();
+        if(status!=RAD_OK)return status;
+        // Timing probe only: R4D_INKLING2_CONTROL_PROBE=down skips the blend, =blend skips the first stage.
+        static const int probe=[]{const char* v=std::getenv("R4D_INKLING2_CONTROL_PROBE"); return v?(v[0]==(char)100?1:v[0]==(char)98?2:0):0;}();
+        if(probe==1) return RAD_OK;
+        if(chain) r4dchain_control_blend<<<dim3((n+31)/32,(m+7)/8),256,0,(hipStream_t)stream>>>((const float*)x->data,
+            (const float*)msg->data,(const float*)g->data,(const float*)f->data,hidden,
+            (float*)out->data,m,n,rank);
+    else control_blend<<<dim3((n+31)/32,(m+7)/8),256,0,(hipStream_t)stream>>>((const float*)x->data,
+            (const float*)msg->data,(const float*)g->data,(const float*)f->data,hidden,
+            (float*)out->data,m,n,rank);
+        return launched();
+    }
+    const int tile=m>=32?n:128;
+    if(chain) r4dchain_control<<<dim3(m,(n+tile-1)/tile),256,4*n,(hipStream_t)stream>>>((const float*)x->data,
+        (const float*)msg->data,(const uint16_t*)down->data,(const float*)g->data,(const float*)f->data,
+        (float*)out->data,n,rank,eps,tile);
+    else control<<<dim3(m,(n+tile-1)/tile),256,4*n,(hipStream_t)stream>>>((const float*)x->data,
+        (const float*)msg->data,(const uint16_t*)down->data,(const float*)g->data,(const float*)f->data,
+        (float*)out->data,n,rank,eps,tile);
+    return launched();
+}
