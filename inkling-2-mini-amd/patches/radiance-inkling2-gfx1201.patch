+// Tile zero owns the history for this sequence and channel. Higher tiles never read history.
+__device__ __forceinline__ void conv_body(const uint16_t* x,const uint16_t* w,const uint16_t* dyn,uint16_t* y,
+                     uint16_t* state,const int* cu,const int* slots,const int* init,const int* accepted,
+                     int rows,int n,int heads,int depth,int nslots,long long slot_stride,long long ch_stride) {
+    int c=blockIdx.x*blockDim.x+threadIdx.x, seq=blockIdx.z;
+    if(c>=n) return;
+    int start=cu[seq], length=cu[seq+1]-start, first=blockIdx.y*32;
+    int slot=slots?slots[seq]:seq, offset=accepted?accepted[seq]-1:0;
+    if(start<0 || start+length>rows || first>=length || slot<0 || slot>=nslots ||
+        offset<0 || offset+3>depth || (accepted && 2+length>depth)) return;
+    uint16_t* st=state+slot*slot_stride+c*ch_stride;
+    uint16_t hist[3]={};
+    if(first==0 && (!init || init[seq])) for(int j=0;j<3;++j) hist[j]=st[offset+j];
+    // A reciprocal estimate crosses BF16 halfway values (for example 0x3c318000).
+    // Round the division itself before the BF16 store, as in the eager convolution.
+    constexpr float sqrt5=0x1.1e377ap+1f;
+    const float divisor=dyn ? 3.f : sqrt5;
+    for(int t=first;t<min(length,first+32);++t) {
+        float acc=0;
+#pragma unroll
+        for(int j=0;j<4;++j) {
+            const int src=t-3+j,lag=3-j;
+            const float val=bf16_to_f32(src>=0 ? x[(long long)(start+src)*n+c] : hist[src+3]);
+            float tap=bf16_to_f32(dyn?w[(long long)lag*n+c]:w[4*c+j]);
+            if(dyn) tap+=bf16_to_f32(dyn[((long long)(start+t)*heads+c/(n/heads))*4+lag]);
+            acc+=val*tap;
+        }
+        long long i=(long long)(start+t)*n+c;
+        y[i]=f32_to_bf16(__fdiv_rn(acc+bf16_to_f32(x[i]),divisor));
+    }
+    if(first) return;
+    if(accepted) {
+        st[0]=hist[1]; st[1]=hist[2];
+        for(int t=0;t<length;++t) st[2+t]=x[(long long)(start+t)*n+c];
+    } else {
+        for(int j=0;j<3;++j) {
+            const int src=length-3+j;
+            st[j]=src>=0?x[(long long)(start+src)*n+c]:hist[src+3];
+        }
+    }
+}
+__global__ void conv(const uint16_t* x,const uint16_t* w,const uint16_t* dyn,uint16_t* y,
+                     uint16_t* state,const int* cu,const int* slots,const int* init,const int* accepted,
+                     int rows,int n,int heads,int depth,int nslots,long long slot_stride,long long ch_stride) {
+    conv_body(x,w,dyn,y,state,cu,slots,init,accepted,rows,n,heads,depth,nslots,slot_stride,ch_stride);
+}
+__global__ void r4dchain_conv(const uint16_t* x,const uint16_t* w,const uint16_t* dyn,uint16_t* y,
+                     uint16_t* state,const int* cu,const int* slots,const int* init,const int* accepted,
+                     int rows,int n,int heads,int depth,int nslots,long long slot_stride,long long ch_stride) {
+    r4d_chain_wait();
+    conv_body(x,w,dyn,y,state,cu,slots,init,accepted,rows,n,heads,depth,nslots,slot_stride,ch_stride);
+    r4d_chain_done();
+}
