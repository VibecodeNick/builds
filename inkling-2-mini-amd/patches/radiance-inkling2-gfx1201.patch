+                    if(a.score_cache) {
+                        // The transposed table: one distance's sixteen bf16 as two 16-byte words.
+                        const uint4* row=(const uint4*)(a.score_cache+(long long)distance*dr);
+                        const uint4 w0=row[0], w1=row[1];
