+    const int rs=a.reserved ? ink_row_splits(a,ink_row_pos(a,t)) : a.splits;
+    float v=0;
+    for(int i=0; i<rs; ++i) v+=p[i*(hd+2)+d];
+    a.out[t*a.out_stride+h*hd+d]=f32_to_bf16(v);
