+# Built in radiance's tree, or standalone against an installed radiance.
+if(NOT COMMAND rad_add_plugin)
+  cmake_minimum_required(VERSION 3.21)
+  project(inkling2 LANGUAGES CXX)
+  find_package(radiance REQUIRED)
+  rad_plugin_defaults()
+endif()
+
+rad_add_plugin(inkling2 architectures SOURCES ${CMAKE_CURRENT_SOURCE_DIR}/inkling2.cpp)
diff --git a/arch/inkling2/chat.h b/arch/inkling2/chat.h
new file mode 100644
index 0000000..e3be6e3
--- /dev/null
+++ b/arch/inkling2/chat.h
@@ -0,0 +1,21 @@
+#pragma once
+#include "rad_builder.h"
+
+namespace inkling2 {
+inline const RadChatFormat* chat_format(const RadModelMeta*) {
+    static const RadChatFormat format=[] {
+        RadChatFormat f{};
+        f.struct_size=sizeof(f);
+        f.name="plugin:inkling2";
+        f.reasoning_open="<|message_model|><|content_thinking|>";
+        f.reasoning_close="<|end_message|>";
+        f.content_open="<|message_model|><|content_text|>";
+        f.name_prefix="<|message_model|>";
+        f.name_suffix="<|content_invoke_tool_json|>";
+        f.call_end="<|end_message|>";
+        f.args_form=RAD_CHAT_ARGS_NAMED_OBJECT;
+        return f;
+    }();
+    return &format;
+}
+}
diff --git a/arch/inkling2/draft.h b/arch/inkling2/draft.h
new file mode 100644
index 0000000..d0cdd28
--- /dev/null
+++ b/arch/inkling2/draft.h
@@ -0,0 +1,214 @@
+// Inkling's DFlare taps and recurrent Markov head. The trunk owns the tap buffer.
+// The scheduler sends its context pass immediately after the trunk, then an
+// eight-row bidirectional block whose seven mask rows propose seven tokens.
+#pragma once
+#include <arch/rad_arch.h>
+#include <array>
+#include <string>
+#include <vector>
+namespace inkling2 {
+using namespace rad::arch;
+struct Draft {
+    static constexpr int H=2304, D=128, Q=3072, K=1024, I=9216, R=256, V=200058;
+    static constexpr int block=8, depth=7;
+    struct Layer {
+        rad_weight input{}, post{}, q{}, k{}, v{}, o{}, qg{}, kg{}, ctxk{}, ctxv{}, ctxg{}, gu{}, down{}, alpha{}, dflare{};
+    };
+    enum class View { buffer, weight, pos, slot, cache, block_table, used, cu, tokens, out_ids, anchor, none };
+    enum class Size { tokens, selected, sequences, context_capacity, longest };
+    struct Arg {
+        View view=View::none; unsigned id=0; Size size=Size::tokens; int col=0,width=0; bool write=false;
+    };
+    struct Instr {
+        rad_op op=0; Size size=Size::tokens; int scale=1, layer=0; std::vector<Arg> args;
+    };
+    std::array<Layer,3> l{};
+    std::vector<Instr> context_ops,query_ops;
+    std::array<rad_kvgroup,3> group{};
+    int base=0, capacity=0, error=RAD_OK;
+    bool ready=false;
+    static Arg rd(rad_buf b,Size n=Size::tokens) {return {View::buffer,b,n};}
+    static Arg wr(rad_buf b,Size n=Size::tokens) {auto a=rd(b,n);a.write=true;return a;}
+    static Arg wt(rad_weight h) {return {View::weight,h};}
+    static Arg slice(rad_buf b,int col,int width) {auto a=rd(b);a.col=col;a.width=width;return a;}
+    void add(RadBuilder* b,std::vector<Instr>& pass,const char* name,
+             std::initializer_list<RadParam> params,std::initializer_list<Arg> args,
+             int layer=0,Size n=Size::tokens,int scale=1) {
+        std::vector<rad_weight> weights; std::vector<rad_buf> reads,writes;
+        for(auto a:args) {
+            if(a.view==View::weight) weights.push_back(a.id);
+            if(a.view==View::buffer) (a.write?writes:reads).push_back(a.id);
+        }
+        rad_op op=rad_decl_op(b,name,params.begin(),params.size(),weights.data(),weights.size());
+        if(!op){error=RAD_E_UNSUPPORTED;return;}
+        rad_op_reads(b,op,reads.data(),reads.size()); rad_op_writes(b,op,writes.data(),writes.size());
+        pass.push_back({op,n,scale,layer,args});
+    }
+    int declare(RadBuilder* b, Names& nm,const RadModelMeta* meta,const RadBuildCtx* ctx,int visits,
+                rad_buf taps,rad_weight embedding,rad_weight embed_norm,rad_weight lm_head) {
+        if(!b||!taps||!embedding||!embed_norm||!lm_head||ctx->max_spec!=7||ctx->max_tok<block||
+           std::string(rad_meta_gets(meta,"draft.model_type",""))!="inkling2_dspark"||
+           rad_meta_geti(meta,"draft.block_size",0)!=block||rad_meta_geti(meta,"draft.hidden_size",0)!=H||
+           rad_meta_geti(meta,"draft.num_hidden_layers",0)!=3||rad_meta_geti(meta,"draft.markov_rank",0)!=R||
+           rad_meta_geti(meta,"draft.vocab_size",0)!=V||(ctx->world_size!=1&&ctx->world_size!=2)) return RAD_E_UNSUPPORTED;
+        base=visits; capacity=ctx->max_tok;
+        const int T=ctx->max_tok, S=ctx->max_seqs, B=std::min(T,S*block), G=S*depth;
+        const char* kd=rad_dtype_name(rad_kv_cache_dtype(ctx,RAD_BF16));
+        RadKVGroupDecl kdsc{}; kdsc.kind=RAD_KV_FULL;kdsc.dtype=rad_kv_cache_dtype(ctx,RAD_BF16);
+        kdsc.n_head_kv=8;kdsc.head_dim=D;
+        auto full=rad_decl_kv_group(b,nm.f("draft.kv.full"),&kdsc);
+        kdsc.kind=RAD_KV_WINDOW; kdsc.window=1025;
+        auto local=rad_decl_kv_group(b,nm.f("draft.kv.local"),&kdsc);
+        group={local,full,local};
+        if(!local||!full) return RAD_E_INVAL;
+        for(int i=0;i<3;++i) RAD_ARCH_TRY(rad_bind_layer_kv(b,base+i,group[i]));
+        auto W=[&](const std::string& key,std::initializer_list<int64_t> shape,uint32_t dtype=RAD_BF16){
+            auto logical=nm.f("dspark.%s",key.c_str());
+            if(map_copy(b,logical,nm.ckpt("draft.%s",key.c_str()))<0){error=RAD_E_FORMAT;return rad_weight(0);}
+            auto w=decl_w(b,logical,dtype,shape,RAD_ACCESS_PER_TOKEN,RAD_SHARD_NONE,grp_model());
+            if(!w) error=RAD_E_FORMAT;
+            return w;
+        };
+        auto Buf=[&](const char* k,int rows,int width,uint32_t dt=RAD_BF16){
+            auto h=decl_b(b,nm.f("dspark.buf.%s",k),dt,{rows,width});if(!h)error=RAD_E_INVAL;return h;
+        };
+        // The trunk may shard the LM head by vocabulary. Draft inference is
+        // replicated on each rank, so every proposal sees the complete vocabulary.
+        // Store this alias also in a container converted with one rank.
+        const char* draft_head_name=nm.f("dspark.target_head.weight");
+        RAD_ARCH_TRY(map_copy(b,draft_head_name,nm.ckpt("model.llm.unembed.weight")));
+        auto draft_head=decl_w(b,draft_head_name,RAD_BF16,{V,H},RAD_ACCESS_VOCAB,RAD_SHARD_NONE,grp_model());
+        if(!draft_head)return RAD_E_FORMAT;
+        auto norm=W("norm.weight",{H}), mask=W("mask_embed",{H}), f_alpha=W("fuse_alpha.3",{4});
+        auto f_norm=W("markov_head.dflare_norm.weight",{H});
+        auto book=W("markov_head.markov_w1.weight",{V,R}), cw=W("markov_head.context.weight",{3*R,2*H});
+        auto rwgt=W("markov_head.recurrent.weight",{3*R,2*R}), rb=W("markov_head.rnn_proj.bias",{3*R},RAD_F32);
+        auto fold=W("markov_head.fold.weight",{V,R}), fb=W("markov_head.fold.bias",{V});
+        for(int i=0;i<3;++i){
+            auto& a=l[i];auto p=std::string("layers.")+std::to_string(i)+".";
+            a.alpha=W("fuse_alpha."+std::to_string(i),{4});a.dflare=W(p+"dflare_norm.weight",{H});
+            a.input=W(p+"input_layernorm.weight",{H});a.post=W(p+"post_attention_layernorm.weight",{H});
+            a.q=W(p+"self_attn.q_proj.weight",{Q,H});a.k=W(p+"self_attn.k_proj.weight",{K,H});
+            a.v=W(p+"self_attn.v_proj.weight",{K,H});a.o=W(p+"self_attn.o_proj.weight",{H,Q});
+            a.ctxk=W(p+"self_attn.k_proj_ctx.weight",{K,H});a.ctxv=W(p+"self_attn.v_proj_ctx.weight",{K,H});
+            a.ctxg=W(p+"self_attn.k_norm_ctx.weight",{D});a.qg=W(p+"self_attn.q_norm.weight",{D});
+            a.kg=W(p+"self_attn.k_norm.weight",{D});a.down=W(p+"mlp.down_proj.weight",{H,I});
+            auto joined=nm.f("dspark.layers.%d.mlp.gate_up",i);
+            RAD_ARCH_TRY(map_concat(b,joined,{nm.ckpt("draft.%smlp.gate_proj.weight",p.c_str()),
+                                               nm.ckpt("draft.%smlp.up_proj.weight",p.c_str())}));
+            a.gu=decl_w(b,joined,RAD_BF16,{2*I,H},RAD_ACCESS_PER_TOKEN,RAD_SHARD_NONE,grp_model(),0,{I,I});
+            if(!a.gu)return RAD_E_FORMAT;
+        }
+        if(error)return error;
+        auto mixed=Buf("context_mix",T,H), ck=Buf("ck",T,K), cv=Buf("cv",T,K), cn=Buf("ck_norm",T,K);
+        auto feat=Buf("recurrent_features",T,H);
+        auto x=Buf("residual",B,H), raw=Buf("delta",B,H), hn=Buf("norm",B,H), q=Buf("q",B,Q);
+        auto k=Buf("key",B,K),v=Buf("value",B,K), qn=Buf("q_norm",B,Q),kn=Buf("k_norm",B,K);
+        auto att=Buf("attn",B,Q), gu=Buf("gate_up",B,2*I),act=Buf("swiglu",B,I);
+        auto picked=Buf("mask_rows",G,H), logits=Buf("base_logits",G,V), out=Buf("proposal",S,depth,RAD_I32);
+        if(error)return error;
+        auto mm=[&](std::vector<Instr>& p,int maxn,rad_buf a,rad_weight w,rad_buf y,int n,int k,Size size=Size::tokens){
+            add(b,p,"gemm_nt",{RAD_RANGE("M",1,maxn),RAD_INT("N",n),RAD_INT("K",k),RAD_STR("dtype","bf16")},
+                {rd(a,size),wt(w),wr(y,size)},0,size);
+        };
+        auto rms=[&](std::vector<Instr>& p,int maxn,rad_buf x,rad_weight w,rad_buf y,int n,int heads=1){
+            add(b,p,"rmsnorm",{RAD_RANGE("M",1,maxn*heads),RAD_INT("n",n),RAD_F64("eps",1e-6),RAD_STR("dtype","bf16")},
+                {rd(x),wt(w),wr(y)},0,Size::tokens,heads);
+        };
+        auto rotate=[&](std::vector<Instr>& p,int maxn,rad_buf x,int heads){
+            add(b,p,"rope",{RAD_RANGE("M",1,maxn),RAD_INT("head_dim",D),RAD_INT("n_head",heads),RAD_INT("n_head_kv",0),
+                            RAD_F64("theta",1000000.),RAD_F64("scale",1.),RAD_STR("mode","neox"),RAD_INT("rotary_dim",D)},
+                {wr(x),{View::pos}});
+            if(!p.empty()) rad_op_reads(b,p.back().op,&x,1);
+        };
+        auto store=[&](std::vector<Instr>& p,int maxn,int i,rad_buf nk,rad_buf value){
+            add(b,p,"kv_store",{RAD_RANGE("M",1,maxn),RAD_INT("head_dim",D),RAD_INT("n_head_kv",8),
+                                 RAD_INT("block_size",RAD_KV_BLOCK),RAD_STR("kv_dtype",kd)},
+                {rd(nk),rd(value),{View::slot},{View::cache}},i);
+        };
+        auto& cc=context_ops;auto& qq=query_ops;
+        for(int i=0;i<3;++i){
+            const auto& a=l[i];
+            add(b,cc,"ink_ds_mix",{RAD_RANGE("M",1,T)},{rd(taps),wt(a.alpha),wt(a.dflare),wr(mixed)});
+            mm(cc,T,mixed,a.ctxk,ck,K,H);mm(cc,T,mixed,a.ctxv,cv,K,H);rms(cc,T,ck,a.ctxg,cn,D,8);
+            rotate(cc,T,cn,8);store(cc,T,i,cn,cv);
+        }
+        add(b,cc,"ink_ds_mix",{RAD_RANGE("M",1,T)},{rd(taps),wt(f_alpha),wt(f_norm),wr(feat)});
+        add(b,qq,"embed_lookup",{RAD_RANGE("M",1,B),RAD_INT("n_embd",H),RAD_INT("n_vocab",V),
+                                 RAD_STR("dtype","bf16"),RAD_INT("vocab_offset",0)},
+            {{View::tokens},wt(embedding),wr(raw)});
+        add(b,qq,"inkling2_rmsnorm",{RAD_RANGE("M",1,B),RAD_INT("n",H),RAD_F64("eps",1e-6),RAD_STR("dtype","bf16")},
+            {rd(raw),wt(embed_norm),wr(hn)});
+        add(b,qq,"ink_ds_seed",{RAD_RANGE("M",1,B)},{rd(hn),wt(mask),wr(x)});
+        auto add_norm=[&](rad_weight gain){
+            add(b,qq,"rmsnorm_add",{RAD_RANGE("M",1,B),RAD_INT("n",H),RAD_F64("eps",1e-6),
+                                    RAD_STR("dtype","bf16")},{rd(raw),rd(x),wt(gain),wr(hn),wr(x)});
+        };
+        rms(qq,B,x,l[0].input,hn,H);
+        for(int i=0;i<3;++i){
+            const auto& a=l[i];
+            mm(qq,B,hn,a.q,q,Q,H);mm(qq,B,hn,a.k,k,K,H);mm(qq,B,hn,a.v,v,K,H);
+            rms(qq,B,q,a.qg,qn,D,24);rms(qq,B,k,a.kg,kn,D,8);rotate(qq,B,qn,24);rotate(qq,B,kn,8);
+            store(qq,B,i,kn,v);
+            add(b,qq,i==1?"attn_paged":"attn_paged_anchor_window",{RAD_RANGE("q_len",1,block),RAD_INT("head_dim",D),
+                RAD_INT("gqa",3),RAD_INT("causal",0),RAD_INT("window",i==1?0:1025),RAD_INT("n_head",24),
+                RAD_INT("block_size",RAD_KV_BLOCK),RAD_INT("max_seqs",S),
+                RAD_INT("max_ctx",ctx->max_ctx),RAD_STR("q_dtype","bf16"),RAD_STR("kv_dtype",kd)},
+                {rd(qn),{View::cache},{View::block_table},{View::used},{},{},{View::cu},wr(att)},i,Size::longest);
+            mm(qq,B,att,a.o,raw,H,Q);add_norm(a.post);mm(qq,B,hn,a.gu,gu,2*I,H);
+            add(b,qq,"act_mul",{RAD_RANGE("M",1,B),RAD_INT("n",I),RAD_STR("act","silu"),RAD_STR("dtype","bf16")},
+                {slice(gu,0,I),slice(gu,I,I),wr(act)});
+            mm(qq,B,act,a.down,raw,H,I);add_norm(i+1<3?l[i+1].input:norm);
+        }
+
+        add(b,qq,"gather_rows",{RAD_RANGE("M",1,G),RAD_INT("n",H),RAD_STR("dtype","bf16")},
+            {rd(hn),{View::out_ids},wr(picked,Size::selected)},0,Size::selected);
+        mm(qq,G,picked,draft_head,logits,V,H,Size::selected);
+        add(b,qq,"ink_ds_markov",{RAD_RANGE("M",1,S)},{rd(picked,Size::selected),rd(feat,Size::context_capacity),
+            {View::anchor},{View::tokens},rd(logits,Size::selected),wt(book),wt(cw),wt(rwgt),wt(rb),wt(fold),
+            wt(fb),wr(out,Size::sequences)},0,Size::sequences);
+        if(error)return error;
+        RadDrafterDecl def{};def.name="inkling2_dspark";def.kind=RAD_DRAFT_BLOCK;def.depth=depth;
+        def.block=block;def.proposal=out;def.proposal_pitch=depth;def.window=0;
+        def.mask_token=0; // Ignored at every mask slot. ink_ds_seed supplies the learned mask embedding.
+        RAD_ARCH_TRY(rad_declare_drafter(b,&def));ready=true;return RAD_OK;
+    }
+    int issue(RadCtx* c,const RadBatch* b,const std::vector<Instr>& ops) const {
+        if(!ready||b->n_tok>capacity)return RAD_E_STATE;
+        // The head's rows are the window's: 1 to depth draft rows a sequence (--draft-window).
+        if(b->draft_pass>0&&(b->n_tok!=b->n_seq*block||b->n_seq<=0||b->n_out<=0||b->n_out%b->n_seq||
+           b->n_out>b->n_seq*depth||!b->anchor_rows))
+            return RAD_E_SHAPE;
+        auto extent=[&](Size s)->int64_t{
+            switch(s){case Size::tokens:return b->n_tok;case Size::selected:return b->n_out;
+            case Size::sequences:return b->n_seq;case Size::longest:return b->max_q_len;
+            case Size::context_capacity:return capacity;}return 0;
+        };
+        for(const auto& inst:ops){
+            const auto* kvb=kv_batch(b,group[inst.layer]);std::array<RadOperand,16> argv{};
+            for(size_t i=0;i<inst.args.size();++i){
+                auto a=inst.args[i];auto& o=argv[i];
+                switch(a.view){
+                case View::buffer:o=a.width?bcol(a.id,a.col,a.width,extent(a.size)):brows(a.id,extent(a.size));break;
+                case View::weight:o=RAD_W(a.id);break;
+                case View::pos:o=praw(b->positions,RAD_I32,b->n_tok);break;
+                case View::slot:if(!kvb)return RAD_E_STATE;o=praw(kvb->slot_mapping,RAD_I32,b->n_tok);break;
+                case View::cache:o=kv_cache(group[inst.layer],base+inst.layer);break;
+                case View::block_table:if(!kvb)return RAD_E_STATE;o=praw2(kvb->block_table,RAD_I32,b->n_seq,kvb->block_table_pitch);break;
+                case View::used:if(!kvb)return RAD_E_STATE;o=praw(kvb->seqused,RAD_I32,b->n_seq);break;
+                case View::cu:o=praw(b->cu_seqlens,RAD_I32,b->n_seq+1);break;
+                case View::tokens:o=praw(b->token_ids,RAD_I32,b->n_tok);break;
+                case View::out_ids:o=praw(b->out_ids,RAD_I32,b->n_out);break;
+                case View::anchor:o=praw(b->anchor_rows,RAD_I32,b->n_seq);break;
+                case View::none:o=RAD_NONE;break;
+                }
+            }
+            int rc=rad_issue(c,inst.op,argv.data(),inst.args.size(),extent(inst.size)*inst.scale);
+            if(rc!=RAD_OK)return rc;
+        }
+        return RAD_OK;
+    }
+    void context(RadCtx* c,const RadBatch* b) const {if(issue(c,b,context_ops)!=RAD_OK)rad_step_fail(c,"Inkling DSpark context pass failed");}
+    void step(RadCtx* c,const RadBatch* b) const {if(issue(c,b,query_ops)!=RAD_OK)rad_step_fail(c,"Inkling DSpark query pass failed");}
+};
+}
diff --git a/arch/inkling2/graph.h b/arch/inkling2/graph.h
new file mode 100644
index 0000000..8faeb77
--- /dev/null
+++ b/arch/inkling2/graph.h
@@ -0,0 +1,206 @@
+#pragma once
+#include <arch/rad_arch.h>
+#include <algorithm>
+#include <array>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace inkling2 {
+using namespace rad::arch;
+
+// Every instruction is declared at the point where its output first becomes live.
+// The step fills in only the ragged batch dimensions and the manager's sequence maps.
+enum class Field { activation, weight, table, kv, tokens, pos, slots, blocks, used,
+                   cu, index, prefix, accepted, out_ids, absent };
+struct Arg {
+    Field field;
+    uint32_t id = 0;
+    int multiplier = 1; // zero: whole declared buffer, -1: gathered output rows
+    int offset = 0, width = 0;
+    bool write = false;
+};
+struct Tensor {
+    rad_buf buf;
+    int width;
+    uint32_t dt;
+    int rows = 1;
+    int col = -1;
+    Arg arg(bool output=false) const {
+        return {Field::activation,buf,rows,std::max(0,col),col < 0 ? 0 : width,output};
+    }
+};
+inline Arg wt(rad_weight w) { return {w ? Field::weight : Field::absent, w}; }
+inline Arg table(rad_weight first, int count) { return {Field::table,first,count}; }
+enum class Band { token, expert, query, head, convolution };
+struct Call {
+    rad_op op;
+    Band band;
+    int multiple;
+    rad_kvgroup group;
+    int visit;
+    std::vector<Arg> args;
+    int issue(RadCtx* c, const RadBatch* b, int64_t T, int64_t D, int64_t S,
+              const RadKVGroupBatch* state, bool decode) const {
+        const int64_t n = band==Band::head ? b->n_out : band==Band::query ? b->max_q_len : T*multiple;
+        if (n == 0) return RAD_OK;
+        std::array<RadOperand,24> ops;
+        for (size_t i=0; i<args.size(); ++i) {
+            const Arg& a=args[i];
+            RadOperand& o=ops[i];
+            switch(a.field) {
+            case Field::activation:
+                o=RAD_B(a.id);
+                o.rows=a.multiplier < 0 ? b->n_out : T*a.multiplier;
+                o.offset=a.offset; o.cols=a.width;
+                break;
+            case Field::weight: o=RAD_W(a.id); break;
+            case Field::table: o=RAD_WTAB(a.id,a.multiplier); break;
+            case Field::kv: o=kv_cache(group,visit); break;
+            case Field::tokens: o=praw(b->token_ids,RAD_I32,T); break;
+            case Field::pos: o=praw(b->positions,RAD_I32,T); break;
+            case Field::slots: o=praw(state->slot_mapping,RAD_I32,T); break;
+            case Field::blocks: o=praw2(state->block_table,RAD_I32,S,state->block_table_pitch); break;
+            case Field::used: o=praw(state->seqused,RAD_I32,S); break;
+            case Field::cu: o=praw(b->cu_seqlens+D,RAD_I32,S+1); break;
+            case Field::index: o=praw(state->state_index+D,RAD_I32,S); break;
+            case Field::prefix: o=praw(b->ctx_lens+D,RAD_I32,S); break;
+            case Field::accepted: o=decode && b->num_accepted ? praw(b->num_accepted+D,RAD_I32,S) : RAD_NONE; break;
+            case Field::out_ids: o=praw(b->out_ids,RAD_I32,b->n_out); break;
+            case Field::absent: o=RAD_NONE; break;
+            }
+        }
+        return rad_issue(c,op,ops.data(),(int)args.size(),n);
+    }
+    int run(RadCtx* c,const RadBatch* b) const {
+        auto kv=group ? kv_batch(b,group) : nullptr;
+        if (group&&!kv) return RAD_E_STATE;
+        if (band!=Band::convolution) return issue(c,b,b->n_tok,0,b->n_seq,kv,false);
+        int64_t D,DT;
+        batch_split(b,&D,&DT);
+        if (D) {
+            int rc=issue(c,b,DT,0,D,kv,true);
+            if (rc!=RAD_OK) return rc;
+        }
+        return D < b->n_seq ? issue(c,b,b->n_tok,D,b->n_seq-D,kv,false) : RAD_OK;
+    }
+};
+struct Program {
+    Names names{};
+    std::vector<Call> calls;
+};
+struct Graph {
+    RadBuilder* b;
+    Program& p;
+    int T, O;
+    int serial=0, visit=0;
+    double eps;
+    int status=RAD_OK;
+    Tensor buf(const char* tag,int width,uint32_t dt=RAD_BF16,int factor=1) {
+        auto name=p.names.f("visit.%d.%s.%d",visit,tag,serial++);
+        auto h=decl_b(b,name,dt,{factor<0?O:int64_t(T)*factor,width});
+        if(!h) status=RAD_E_INVAL;
+        return {h,width,dt,factor};
+    }
+    Tensor fixed(const char* tag,int count,uint32_t dt) {
+        auto h=decl_b(b,p.names.f("visit.%d.%s.%d",visit,tag,serial++),dt,{count});
+        if(!h) status=RAD_E_INVAL;
+        return {h,count,dt,0};
+    }
+    int maxrows(int scale=1) const {return scale<0 ? O : T*scale;}
+    void op(const char* name,std::initializer_list<RadParam> params,std::vector<Arg> args,
+            Band band=Band::token,int scale=1,rad_kvgroup group=0) {
+        std::vector<rad_weight> weights;
+        std::vector<rad_buf> reads,writes;
+        for(const Arg& a:args) {
+            if(a.field==Field::weight) weights.push_back(a.id);
+            if(a.field==Field::table)
+                for(int i=0;i<a.multiplier;++i) weights.push_back(a.id+i);
+            if(a.field==Field::activation) (a.write?writes:reads).push_back(a.id);
+        }
+        auto h=rad_decl_op(b,name,params.begin(),(int)params.size(),weights.data(),(int)weights.size());
+        if(args.size()>24) throw std::logic_error("too many operands");
+        if(h) {
+            if(!reads.empty()) rad_op_reads(b,h,reads.data(),(int)reads.size());
+            if(!writes.empty()) rad_op_writes(b,h,writes.data(),(int)writes.size());
+        }
+        p.calls.push_back({h,band,scale,group,visit,std::move(args)});
+    }
+    void cast_to(Tensor x,Tensor y) {
+        op("cast",{RAD_RANGE("M",1,maxrows(y.rows)),RAD_INT("n",y.width),
+                   RAD_STR("from",rad_dtype_name(x.dt)),RAD_STR("to",rad_dtype_name(y.dt))},
+           {x.arg(),y.arg(true)},y.rows<0?Band::head:Band::token,y.rows);
+    }
+    Tensor cast(Tensor x,uint32_t dt) {
+        if(x.dt==dt) return x;
+        Tensor y=buf("cast",x.width,dt,x.rows);
+        cast_to(x,y);
+        return y;
+    }
+    Tensor rms(Tensor x,rad_weight w=0,int block=0,uint32_t dtype=RAD_DT_INVALID) {
+        int n=block?block:x.width;
+        Tensor y=buf("norm",x.width,dtype==RAD_DT_INVALID?x.dt:dtype,x.rows);
+        op("inkling2_rmsnorm",
+           {RAD_RANGE("M",1,maxrows(x.rows)*x.width/n),RAD_INT("n",n),RAD_F64("eps",eps),
+            RAD_STR("dtype",rad_dtype_name(x.dt)),RAD_STR("out_dtype",rad_dtype_name(y.dt))},
+           {x.arg(),wt(w),y.arg(true)},
+           x.rows<0?Band::head:Band::token,x.width/n);
+        return y;
+    }
+    Tensor gemm(Tensor x,rad_weight w,int n,bool fp32_out=false) {
+        Tensor y=buf("linear",n,fp32_out?RAD_F32:x.dt,x.rows);
+        op(fp32_out?"gemm_nt_f32":"gemm_nt",
+           {RAD_RANGE("M",1,maxrows(x.rows)),RAD_INT("K",x.width),RAD_INT("N",n),
+            RAD_STR("dtype",rad_dtype_name(x.dt))},
+           {x.arg(),wt(w),y.arg(true)},x.rows<0?Band::head:Band::token,x.rows);
+        return y;
+    }
+    Tensor elem(const char* name,Tensor a,Tensor other) {
+        Tensor y=buf(name,a.width,a.dt,a.rows);
+        op(name,{RAD_RANGE("M",1,maxrows(a.rows)),RAD_INT("n",a.width),RAD_STR("dtype",rad_dtype_name(a.dt))},
+           {a.arg(),other.arg(),y.arg(true)},a.rows<0?Band::head:Band::token,a.rows);
+        return y;
+    }
+    Tensor cap(Tensor x,double value) {
+        Tensor y=buf("softcap",x.width,x.dt,x.rows);
+        op("logit_softcap",{RAD_RANGE("M",1,maxrows(x.rows)),RAD_INT("n",x.width),RAD_F64("cap",value),
+                           RAD_STR("dtype",rad_dtype_name(x.dt))},
+           {x.arg(),y.arg(true)},x.rows<0?Band::head:Band::token,x.rows);
+        return y;
+    }
+    Tensor mix(const std::vector<Tensor>& bank,Tensor last,rad_weight query,int row,int query_rows=1) {
+        Tensor y=buf("mix",last.width,RAD_F32);
+        std::vector<Arg> a{wt(query),y.arg(true)};
+        for(auto t:bank) a.push_back(t.arg());
+        a.push_back(last.arg());
+        if(a.size()>10) throw std::logic_error("depth mix exceeds eight streams");
+        a.resize(10,Arg{Field::absent});
+        op("inkling2_mix",{RAD_RANGE("M",1,T),RAD_INT("n",last.width),
+            RAD_INT("streams",(int)bank.size()+1),RAD_INT("query_row",row),RAD_INT("query_rows",query_rows)},a);
+        return y;
+    }
+    // Two to four mixes over the same streams as one op: pick j is row pick[j].second of table
+    // pick[j].first (0: qa, 1: qb). Each output is the tensor mix() would have returned.
+    std::vector<Tensor> mixn(const std::vector<Tensor>& bank,Tensor last,rad_weight qa,rad_weight qb,
+                             const std::vector<std::pair<int,int>>& pick,int query_rows=1) {
+        if(pick.size()<2 || pick.size()>4) throw std::logic_error("mixn takes two to four queries");
+        std::vector<Tensor> ys;
+        std::vector<Arg> a{wt(qa),wt(qb)};
+        for(size_t j=0;j<4;++j) {
+            if(j<pick.size()) { ys.push_back(buf("mix",last.width,RAD_F32)); a.push_back(ys.back().arg(true)); }
+            else a.push_back(Arg{Field::absent});
+        }
+        for(auto t:bank) a.push_back(t.arg());
+        a.push_back(last.arg());
+        if(a.size()>14) throw std::logic_error("depth mix exceeds eight streams");
+        a.resize(14,Arg{Field::absent});
+        int row[4]={},tab[4]={};
+        for(size_t j=0;j<pick.size();++j) { tab[j]=pick[j].first; row[j]=pick[j].second; }
+        op("inkling2_mixn",{RAD_RANGE("M",1,T),RAD_INT("n",last.width),RAD_INT("streams",(int)bank.size()+1),
+            RAD_INT("queries",(int)pick.size()),RAD_INT("row0",row[0]),RAD_INT("row1",row[1]),RAD_INT("row2",row[2]),
+            RAD_INT("row3",row[3]),RAD_INT("tab0",tab[0]),RAD_INT("tab1",tab[1]),RAD_INT("tab2",tab[2]),
+            RAD_INT("tab3",tab[3]),RAD_INT("query_rows",query_rows)},a);
+        return ys;
+    }
+};
+}
