+// ATen's x86 vector exponential uses SLEEF's single-precision u10 polynomial.
+// The score has already been centered on the row maximum.
+__device__ float reference_exp(float x) {
+  if (x < -104.f)
+    return 0.f;
+  float k = rintf(x * 0x1.715476p+0f);
+  float r = fmaf(k, -0x1.62e4p-1f, x);
+  r = fmaf(k, -0x1.7f7d1cp-20f, r);
+  float p = fmaf(0x1.a057b4p-13f, r, 0x1.6d2d92p-10f);
+  p = fmaf(p, r, 0x1.11114cp-7f);
+  p = fmaf(p, r, 0x1.5554f4p-5f);
+  p = fmaf(p, r, 0x1.555556p-3f);
+  p = fmaf(p, r, .5f);
+  float mantissa = 1.f + fmaf(r * r, p, r);
+  int ik = int(k), half = ik >> 1;
+  return (mantissa * ldexpf(1.f, half)) * ldexpf(1.f, ik - half);
+}
+
+// Reproduce the two rounded eager float operations independently. A native
+// gfx12 reciprocal/square-root combination can cross the BF16 midpoint.
+__device__ float eager_inverse(float sum,int n,float eps) {
+    float mean=float(double(sum)/double(n));
+    float root=float(sqrt(double(__fadd_rn(mean,eps))));
+    return float(1.0/double(root));
+}
+__global__ void ordered_mix_kernel(MixInputs bank,const float* q,float* y,long long output_pitch,
+                                   int n,int count,int queries,int qr) {
+    int row = blockIdx.x;
+    int stream = threadIdx.x/32;
+    int lane = threadIdx.x%32;
+    __shared__ float inv[8], weight[8];
+    if (stream < count) {
+        const float* x = bank.data[stream] + row*bank.pitch[stream];
+        float total = squared_sum(x,n,lane);
+        float norm = eager_inverse(total,n,1e-6f);
+        if (lane == 0) inv[stream] = norm;
+        // A one-query SGEMV has a scalar lead-in and may have a four-element
+        // tail. The general matrix kernel uses complete four-column output
+        // tiles and eight independent accumulators for a partial tile.
+        int output_index=count==1 ? qr : stream;
+        int outputs=count==1 ? queries : count;
+        bool vector=queries==1 || (count==1 && gridDim.x==1);
+        bool full=output_index<outputs/4*4;
+        int stride=full || (vector && (output_index%2)) ? 4 : 8;
+        int lead=vector ? 4 : 0,tail=vector && !full ? 4 : 0;
+        float dot=0;
+        if (lane%stride==0) {
+            for (int i=0;i<lead;++i)
+                dot=__fadd_rn(dot,__fmul_rn(__fmul_rn(x[i],norm),q[i]));
+        }
+        for (int i=lead+lane%stride;i<n-tail;i+=stride)
+            dot=__fadd_rn(dot,__fmul_rn(__fmul_rn(x[i],norm),q[i]));
+        for (int d=stride/2;d>0;d/=2) dot+=__shfl_xor(dot,d,32);
+        for (int i=n-tail;i<n;++i)
+            dot=__fadd_rn(dot,__fmul_rn(__fmul_rn(x[i],norm),q[i]));
+        if (lane==0) weight[stream]=dot*float(1.0/double(float(sqrt(double(n)))));
+    }
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        float maximum = weight[0], den = 0;
+        for (int s=1; s<count; ++s) maximum=fmaxf(maximum,weight[s]);
+        for (int s=0; s<count; ++s) {
+            weight[s]=reference_exp(weight[s]-maximum);
+            den+=weight[s];
+        }
+        float reciprocal=float(1.0/double(den));
+        for (int s=0; s<count; ++s) weight[s]*=reciprocal;
+    }
+    __syncthreads();
+    for (int j=threadIdx.x; j<n; j+=blockDim.x) {
+        float v=0;
+        for (int s=0; s<count; ++s) {
+            float key=__fmul_rn(bank.data[s][row*bank.pitch[s]+j],inv[s]);
+            // The reference SGEMM's four-query tile contracts the output update.
+            // The one- and three-query tails round the product first.
+            v=queries>=4 ? fmaf(weight[s],key,v) : __fadd_rn(v,__fmul_rn(weight[s],key));
+        }
+        y[row*output_pitch+j]=v;
+    }
+}
