+template<class T>
+__global__ void ordered_rms_kernel(const T* x,const void* gain,bool fp32_gain,void* out,bool fp32_out,
+                                   int n,int64_t xp,int64_t yp,float eps) {
+    int lane=threadIdx.x;
+    x+=blockIdx.x*xp;
+    float sum=squared_sum(x,n,lane);
+    float inv=eager_inverse(sum,n,eps);
+    for(int c=lane;c<n;c+=32){
+        float w=!gain ? 1.f : fp32_gain ? ((const float*)gain)[c] : read_float(((const uint16_t*)gain)[c]);
+        float v=__fmul_rn(__fmul_rn(read_float(x[c]),inv),w);
+        if(fp32_out) ((float*)out)[blockIdx.x*yp+c]=v;
+        else ((uint16_t*)out)[blockIdx.x*yp+c]=f32_to_bf16(v);
+    }
+}
+extern "C" int r4d_reference_order_rms(const RadArgs* a,RadStream st) {
+    const auto* x=r4d_opt(a,0);const auto* gain=r4d_opt(a,1);const auto* y=r4d_opt(a,2);
+    const int n=r4d_geti_or(a,"n",0);const float eps=r4d_getf(a,"eps",1e-6);
+    if(n<=0 || n%32 || n>65536 || !(eps>0))return RAD_E_SHAPE;
+    if(!x||!y||(x->dtype!=RAD_BF16 && x->dtype!=RAD_F32)||(y->dtype!=RAD_BF16&&y->dtype!=RAD_F32)||
+       (gain&&(!r4d_contig(gain)||(gain->dtype!=RAD_BF16&&gain->dtype!=RAD_F32))))return RAD_E_DTYPE;
+    long long m=0,my=0;auto xp=r4d_rows_pitch(x,n,&m),yp=r4d_rows_pitch(y,n,&my);
+    if(m<1||m>INT_MAX||m!=my||xp<n||yp<n||(gain&&r4d_numel(gain)!=n))return RAD_E_SHAPE;
+    const void* w=gain?gain->data:nullptr;
+    if(x->dtype==RAD_F32)
+        ordered_rms_kernel<<<m,32,0,(hipStream_t)st>>>((const float*)x->data,w,gain&&gain->dtype==RAD_F32,y->data,y->dtype==RAD_F32,n,xp,yp,eps);
+    else
+        ordered_rms_kernel<<<m,32,0,(hipStream_t)st>>>((const uint16_t*)x->data,w,gain&&gain->dtype==RAD_F32,y->data,y->dtype==RAD_F32,n,xp,yp,eps);
+    return hipGetLastError()==hipSuccess?RAD_OK:RAD_E_DEVICE;
+}
+extern "C" int r4d_rad_moe_gather(const RadArgs*,RadStream);
+// The x86 reference accumulates the promoted router in FP32. Its small-M path
+// reduces four strided accumulators. SGEMM packs K in panels of at most 192.
+__global__ void router_dot_kernel(const uint16_t* x,const float* w,float* y,
+                                  int rows,int n,int k,int xp,int wp,int yp) {
+    int row=blockIdx.y,col=blockIdx.x*blockDim.x+threadIdx.x;
+    if(col>=n)return;
+    x+=1LL*row*xp; w+=1LL*col*wp;
+    float sum=0;
+    if(rows<=3) {
+        float sums[4]={};int lead=rows==1?4:0;
+        for(int i=0;i<lead;++i)sums[0]=fmaf(bf16_to_f32(x[i]),w[i],sums[0]);
+        for(int i=lead;i<k;i+=4) for(int lane=0;lane<4;++lane)
+            sums[lane]=fmaf(bf16_to_f32(x[i+lane]),w[i+lane],sums[lane]);
+        sum=(sums[0]+sums[2])+(sums[1]+sums[3]);
+    } else {
+        for(int i=0;i<k;) {
+            int panel=k<=192?k:k<384?(k/2+3)/4*4:192;
+            int count=min(k-i,panel);
+            float part=0;int end=i+count;
+            for(;i<end;++i) part=fmaf(bf16_to_f32(x[i]),w[i],part);
+            sum+=part;
+        }
+    }
+    y[1LL*row*yp+col]=sum;
+}
+extern "C" int r4d_reference_order_router_dot(const RadArgs* a,RadStream stream) {
+    auto x=r4d_opt(a,0),w=r4d_opt(a,1),y=r4d_opt(a,2);
+    int n=r4d_geti_or(a,"N",0),k=r4d_geti_or(a,"K",0);long long m=0,wx=0,mx=0;
+    if(!x||!w||!y||x->dtype!=RAD_BF16||w->dtype!=RAD_F32||y->dtype!=RAD_F32)return RAD_E_DTYPE;
+    auto xp=r4d_rows_pitch(x,k,&mx),wp=r4d_rows_pitch(w,k,&wx),yp=r4d_rows_pitch(y,n,&m);
+    if(k<=0||k%4||n<=0||m<1||m>65535||mx<m||wx<n||xp<k||wp<k||yp<n)return RAD_E_SHAPE;
+    router_dot_kernel<<<dim3((n+31)/32,m),32,0,(hipStream_t)stream>>>((const uint16_t*)x->data,(const float*)w->data,(float*)y->data,m,n,k,xp,wp,yp);
+    return hipGetLastError()==hipSuccess?RAD_OK:RAD_E_DEVICE;
+}
+__device__ void swap_expert(int& a,int& b){int t=a;a=b;b=t;}
+__device__ bool higher_score(float x,float y){return (isnan(x)&&!isnan(y))||x>y;}
+__device__ void choose_experts(int* index,const float* rank,int n,int top) {
+    // Unsorted eager topk partitions around the median of three. Ordering the
+    // selected slots here affects the subsequent FP32 denominator reduction.
+    int left=0,right=n;
+    while(right-left>3 && 64*top>n) {
+        int a=left+1,b=(left+right)/2,c=right-1;int median;
+        if(higher_score(rank[index[a]],rank[index[b]]))
+            median=higher_score(rank[index[b]],rank[index[c]])?b:higher_score(rank[index[a]],rank[index[c]])?c:a;
+        else median=higher_score(rank[index[a]],rank[index[c]])?a:higher_score(rank[index[b]],rank[index[c]])?c:b;
+        swap_expert(index[left],index[median]);float pivot=rank[index[left]];int f=left+1,l=right;
+        while(true) {
+            while(higher_score(rank[index[f]],pivot))++f;
+            do{--l;}while(higher_score(pivot,rank[index[l]]));
+            if(f>=l)break;
+            swap_expert(index[f++],index[l]);
+        }
+        if(f<=top-1) left=f; else right=f;
+    }
+    for(int j=left+1;j<right;++j){int key=index[j],at=j;while(at>left && higher_score(rank[key],rank[index[at-1]])){index[at]=index[at-1];--at;}index[at]=key;}
+}
+__global__ void reference_route(const float* logits,const float* bias,int* ids,float* weights,int n,int top,int norm,float scale,int lp,int bp,int ip,int wp) {
+    __shared__ float score[128],rank[128];__shared__ int index[128];
+    int e=threadIdx.x,row=blockIdx.x;
+    if(e<n){float arg=-logits[1LL*row*lp+e];int64_t flat=int64_t(row)*n+e;int64_t vector_end=int64_t(gridDim.x)*n/32*32;
+        float ex=flat>=vector_end?float(exp(double(arg))):arg>88.72284f?INFINITY:reference_exp(arg);score[e]=float(1.0/double(1.f+ex));rank[e]=score[e]+bias[e*bp];index[e]=e;}
+    __syncthreads();if(e!=0)return;
+    choose_experts(index,rank,n,top);
+    // Preserve ATen's vector reduction and its scalar remainder.
+    int width=top>=8?8:top>=4?4:top;
+    float vals[8]={};for(int j=0;j<width;++j)vals[j]=score[index[j]];
+    if(top==16)for(int j=0;j<8;++j)vals[j]+=score[index[8+j]];
+    else if(top>width && width==8){float tail=0;for(int j=8;j<top;++j)tail+=score[index[j]];vals[0]+=tail;}
+    else for(int j=width;j<top;++j)vals[0]+=score[index[j]];
+    float den=vals[0];for(int j=1;j<width;++j)den+=vals[j];
+    for(int j=0;j<top;++j){int ix=index[j];ids[1LL*row*ip+j]=ix;float s=score[ix];weights[1LL*row*wp+j]=(norm?float(double(s)/double(den+1e-20f)):s)*scale;}
+}
+extern "C" int r4d_reference_order_router_top(const RadArgs* a,RadStream s) {
+    auto x=r4d_opt(a,0),b=r4d_opt(a,1),ids=r4d_opt(a,2),w=r4d_opt(a,3);
+    if(!x||!b||!ids||!w||x->dtype!=RAD_F32||b->dtype!=RAD_F32||ids->dtype!=RAD_I32||w->dtype!=RAD_F32)return RAD_E_DTYPE;
+    int n=r4d_geti_or(a,"n_expert",0),k=r4d_geti_or(a,"top_k",0);long long m=0,iw=0,mw=0;
+    if(n<1||n>128||k<1||k>n)return RAD_E_SHAPE;
+    auto xp=r4d_rows_pitch(x,n,&m),ip=r4d_rows_pitch(ids,k,&iw),wp=r4d_rows_pitch(w,k,&mw);
+    if(m<1||iw<m||mw<m||xp<n||ip<k||wp<k||r4d_numel(b)<n)return RAD_E_SHAPE;
+    reference_route<<<m,128,0,(hipStream_t)s>>>((float*)x->data,(float*)b->data,(int*)ids->data,(float*)w->data,n,k,r4d_geti_or(a,"norm",1),r4d_getf(a,"route_scale",1),xp,b->stride[b->rank-1],ip,wp);
+    return hipGetLastError()==hipSuccess?RAD_OK:RAD_E_DEVICE;
+}
+__global__ void ordered_gather_kernel(const uint16_t* values,const float* weights,const int* sorted,uint16_t* y,int rows,int top,int n,int vp,int wp,int yp) {
+    int token=blockIdx.y,col=blockIdx.x*blockDim.x+threadIdx.x;if(col>=n)return;
+    float acc=0;for(int i=0;i<rows*top;++i){int slot=sorted[i]-token*top;if(slot>=0&&slot<top)acc=__fadd_rn(acc,__fmul_rn(bf16_to_f32(values[1LL*i*vp+col]),weights[1LL*token*wp+slot]));}
+    y[1LL*token*yp+col]=f32_to_bf16(acc);
+}
+extern "C" int r4d_reference_order_gather(const RadArgs* a,RadStream s) {
+    if(r4d_opt(a,3)||r4d_opt(a,4))return r4d_rad_moe_gather(a,s);
+    auto x=r4d_opt(a,0),w=r4d_opt(a,1),idx=r4d_opt(a,2),y=r4d_opt(a,5);
+    if(!x||!w||!idx||!y||x->dtype!=RAD_BF16||w->dtype!=RAD_F32||idx->dtype!=RAD_I32||y->dtype!=RAD_BF16)return RAD_E_DTYPE;
+    int n=r4d_geti_or(a,"n",0),k=r4d_geti_or(a,"top_k",0);long long m=0,mw=0,mx=0;
+    auto xp=r4d_rows_pitch(x,n,&mx),wp=r4d_rows_pitch(w,k,&mw),yp=r4d_rows_pitch(y,n,&m);
+    if(n<1||k<1||m<1||m>65535||xp<n||yp<n||wp<k||mw<m||mx<m*k||r4d_numel(idx)<m*k)return RAD_E_SHAPE;
+    ordered_gather_kernel<<<dim3((n+255)/256,m),256,0,(hipStream_t)s>>>((uint16_t*)x->data,(float*)w->data,(int*)idx->data,(uint16_t*)y->data,m,k,n,xp,wp,yp);
+    return hipGetLastError()==hipSuccess?RAD_OK:RAD_E_DEVICE;
+}
