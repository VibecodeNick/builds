+extern "C" int r4d_inkling2_situ_quant(const RadArgs* a,RadStream stream) {
+    bool chain=r4d_geti_or(a,"chain",0)!=0;
+    auto *x=r4d_opt(a,0), *q=r4d_opt(a,1), *sc=r4d_opt(a,2);
+    const int n=r4d_geti_or(a,"n",0), group=r4d_geti_or(a,"group",0);
+    const float gc=r4d_getf(a,"gate_cap",0),uc=r4d_getf(a,"up_cap",0);
+    if(!dense(x,RAD_BF16) || !dense(q,RAD_F8E4M3) || !dense(sc,RAD_F32)) return R4D_NO(RAD_E_DTYPE);
+    if(n<=0 || n%4 || group!=128 || gc<=0 || uc<=0 || r4d_numel(x)%(2LL*n)) return R4D_NO(RAD_E_SHAPE);
+    const long long rows=r4d_numel(x)/(2LL*n), nkb=(n+127)/128;
+    if(rows<=0 || rows>INT_MAX || r4d_numel(q)!=rows*n || r4d_numel(sc)!=rows*nkb) return R4D_NO(RAD_E_SHAPE);
+    chain=chain && rows<=512;   // as the situ row: up to 64 tokens of 8 routed rows
+    if(chain) r4dchain_situ_quant<<<(unsigned)rows,256,0,(hipStream_t)stream>>>((const uint16_t*)x->data,(uint8_t*)q->data,(float*)sc->data,(int)rows,n,(int)nkb,gc,uc);
+    else situ_quant<<<(unsigned)rows,256,0,(hipStream_t)stream>>>((const uint16_t*)x->data,(uint8_t*)q->data,(float*)sc->data,(int)rows,n,(int)nkb,gc,uc);
+    return launched();
+}
+
+extern "C" int r4d_inkling2_situ(const RadArgs* a,RadStream stream) {
+    bool chain=r4d_geti_or(a,"chain",0)!=0;
+    auto *x=r4d_opt(a,0), *out=r4d_opt(a,1);
+    int n=r4d_geti_or(a,"n",0);
+    float gc=r4d_getf(a,"gate_cap",0),uc=r4d_getf(a,"up_cap",0);
+    if(!dense(x,RAD_BF16) || !dense(out,RAD_BF16)) return R4D_NO(RAD_E_DTYPE);
+    long long count=r4d_numel(out);
+    if(n<=0 || gc<=0 || uc<=0 || count<=0 || count%n || r4d_numel(x)!=2*count) return R4D_NO(RAD_E_SHAPE);
+    chain=chain && count/n<=512;   // up to 64 tokens of 8 routed rows
+    if(chain) r4dchain_situ<<<(count+255)/256,256,0,(hipStream_t)stream>>>((const uint16_t*)x->data,(uint16_t*)out->data,count,n,gc,uc);
+    else situ<<<(count+255)/256,256,0,(hipStream_t)stream>>>((const uint16_t*)x->data,(uint16_t*)out->data,count,n,gc,uc);
+    return launched();
+}
