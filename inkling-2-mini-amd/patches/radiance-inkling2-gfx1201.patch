+namespace {
+__global__ void position(uint16_t* x,const uint16_t* table,const int* coord,const uint16_t* cls,
+                         const uint16_t* cls_pos,int m,int n,int side) {
+    const int t=blockIdx.y,c=int(blockIdx.x)*blockDim.x+threadIdx.x;
+    if(c>=n) return;
+    const int row=coord[t],col=coord[m+t];
+    if(row<0) {x[t*n+c]=f32_to_bf16(bf16_to_f32(cls[c])+bf16_to_f32(cls_pos[c]));return;}
+    const float y=(row+.5f)*side/coord[2*m+t]-.5f,z=(col+.5f)*side/coord[3*m+t]-.5f;
+    const int y0=floorf(y),z0=floorf(z);
+    float sum=0;
+    for(int j=0;j<2;++j) for(int k=0;k<2;++k) {
+        const int yy=min(max(y0+j,0),side-1),xx=min(max(z0+k,0),side-1);
+        const float f=(1.f-fabsf(y-y0-j))*(1.f-fabsf(z-z0-k));
+        sum+=bf16_to_f32(table[(yy*side+xx)*n+c])*f;
+    }
+    x[t*n+c]=f32_to_bf16(bf16_to_f32(x[t*n+c])+bf16_to_f32(f32_to_bf16(sum)));
+}
+__global__ void rotate(uint16_t* qkv,const int* coord,int m,int heads,int d,float theta) {
+    const int t=blockIdx.y,i=int(blockIdx.x)*blockDim.x+threadIdx.x,row=coord[t];
+    if(i>=heads*d || row<0) return;
+    const int p=i%(d/2),axis=p<d/4?coord[m+t]+1:row+1;
+    const float phi=axis*powf(theta,-float(p%(d/4))/(d/4));
+    float sn,cs;sincosf(phi,&sn,&cs);
+    uint16_t* pair=qkv+(long long)t*3*heads*d+i*2;
+    float v0=bf16_to_f32(pair[0]),v1=bf16_to_f32(pair[1]);
+    pair[0]=f32_to_bf16(v0*cs-v1*sn);pair[1]=f32_to_bf16(v1*cs+v0*sn);
+}
+bool b16(const RadTensor* t) {return t && t->dtype==RAD_BF16 && r4d_contig(t);}
+bool coords(const RadTensor* t,int64_t m) {
+    return t && t->dtype==RAD_I32 && r4d_contig(t) && r4d_numel(t)==4*m;
+}
+}
+extern "C" int r4d_inkling2_vpos(const RadArgs* a,RadStream s) {
+    const auto *x=r4d_opt(a,0),*tbl=r4d_opt(a,1),*coord=r4d_opt(a,2),*c=r4d_opt(a,3),*cp=r4d_opt(a,4);
+    const int n=r4d_geti_or(a,"n",0),side=r4d_geti_or(a,"side",0);
+    if(!b16(x)||!b16(tbl)||!b16(c)||!b16(cp)||n<=0||side<=0||r4d_numel(x)%n ||
+       r4d_numel(tbl)!=int64_t(side)*side*n||r4d_numel(c)!=n||r4d_numel(cp)!=n) return R4D_NO(RAD_E_SHAPE);
