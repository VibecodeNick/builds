+extern "C" int r4d_inkling2_gather_f32(const RadArgs* a,RadStream st){
+    bool chain=r4d_geti_or(a,"chain",0)!=0;
+    auto *x=r4d_opt(a,0),*idx=r4d_opt(a,1),*y=r4d_opt(a,2);int n=r4d_geti_or(a,"n",0);
+    if(!x||!y||n<1||x->dtype!=RAD_F32||y->dtype!=RAD_F32||!dense(idx,RAD_I32))return R4D_NO(RAD_E_DTYPE);
