+namespace {
+// A thread's columns are tid, tid+128, ... as before and the sum takes them in that order; the
+// change is that every load is issued before the first add. The loop with a runtime bound had one
+// load in flight at a time, and at the 2,304-wide residual that was 18 serial memory latencies
+// twice over (the weight pass reloaded x): 9.5 us a launch for 9 KB. Rows wider than the register
+// bank keep the original loop.
+constexpr int rms_threads=128, rms_cols=18;
+template<bool fp32>
+__device__ __forceinline__ void rms_ink_body(const void* x,const void* w,bool w_f32,void* out,bool out_f32,int n,
+                        long long xs,long long ys,float eps) {
+    const long long xv=blockIdx.x*xs, yv=blockIdx.x*ys;
+    auto get=[&](int c){return fp32?((const float*)x)[xv+c]:bf16_to_f32(((const uint16_t*)x)[xv+c]);};
+    auto getw=[&](int c){return !w?1.f:w_f32?((const float*)w)[c]:bf16_to_f32(((const uint16_t*)w)[c]);};
+    __shared__ double partial[4];
+    if(n<=rms_threads*rms_cols) {
+        float xr[rms_cols],wr[rms_cols];
+#pragma unroll
+        for(int i=0;i<rms_cols;++i){const int c=threadIdx.x+i*rms_threads;xr[i]=c<n?get(c):0.f;wr[i]=c<n?getw(c):1.f;}
+        double ss=0;
+#pragma unroll
+        for(int i=0;i<rms_cols;++i){const int c=threadIdx.x+i*rms_threads;if(c<n){double v=xr[i];ss+=v*v;}}
+        for(int shift=16;shift;shift>>=1)ss+=__shfl_xor(ss,shift,32);
+        if(threadIdx.x%32==0)partial[threadIdx.x/32]=ss;
+        __syncthreads();
+        float inv=1.f/sqrtf(float((partial[0]+partial[1]+partial[2]+partial[3])/n)+eps);
+#pragma unroll
+        for(int i=0;i<rms_cols;++i){
+            const int c=threadIdx.x+i*rms_threads;
+            if(c<n){
+                float v=xr[i]*inv*wr[i];
+                if(out_f32)((float*)out)[yv+c]=v;else ((uint16_t*)out)[yv+c]=f32_to_bf16(v);
+            }
+        }
+        return;
+    }
+    double ss=0;
+    for(int c=threadIdx.x;c<n;c+=blockDim.x){double v=get(c);ss+=v*v;}
+    for(int shift=16;shift;shift>>=1)ss+=__shfl_xor(ss,shift,32);
+    if(threadIdx.x%32==0)partial[threadIdx.x/32]=ss;
+    __syncthreads();
+    float inv=1.f/sqrtf(float((partial[0]+partial[1]+partial[2]+partial[3])/n)+eps);
+    for(int c=threadIdx.x;c<n;c+=blockDim.x){
+        float weight=getw(c);
+        float v=get(c)*inv*weight;
+        if(out_f32)((float*)out)[yv+c]=v;else ((uint16_t*)out)[yv+c]=f32_to_bf16(v);
+    }
+}
+template<bool fp32>
+__global__ void rms_ink(const void* x,const void* w,bool w_f32,void* out,bool out_f32,int n,
+                        long long xs,long long ys,float eps) {
+    rms_ink_body<fp32>(x,w,w_f32,out,out_f32,n,xs,ys,eps);
+}
+template<bool fp32>
+__global__ void r4dchain_rms_ink(const void* x,const void* w,bool w_f32,void* out,bool out_f32,int n,
+                        long long xs,long long ys,float eps) {
+    r4d_chain_wait();
+    rms_ink_body<fp32>(x,w,w_f32,out,out_f32,n,xs,ys,eps);
+    r4d_chain_done();
+}
+
+}
+extern "C" int r4d_inkling2_rmsnorm(const RadArgs* a,RadStream st) {
+    bool chain=r4d_geti_or(a,"chain",0)!=0;
+    auto *x=r4d_opt(a,0),*w=r4d_opt(a,1),*y=r4d_opt(a,2);
+    int n=r4d_geti_or(a,"n",0);float eps=r4d_getf(a,"eps",1e-6);
+    if(!x||!y||n<1||eps<=0||(x->dtype!=RAD_BF16 && x->dtype!=RAD_F32) || (y->dtype!=RAD_BF16 && y->dtype!=RAD_F32) ||
+       (w && !dense(w,RAD_F32) && !dense(w,RAD_BF16)))return R4D_NO(RAD_E_DTYPE);
+    long long m=0,my=0,xs=r4d_rows_pitch(x,n,&m),ys=r4d_rows_pitch(y,n,&my);
+    if(m<1||m!=my||xs<0||ys<0||(w && r4d_numel(w)!=n))return R4D_NO(RAD_E_SHAPE);
+    chain=chain && m<=64*18;   // one block a 128-wide row: 64 tokens of the 2,304-wide residual
+    if(x->dtype==RAD_F32)if(chain) r4dchain_rms_ink<true><<<m,128,0,(hipStream_t)st>>>(x->data,r4d_p(w),
+        w && w->dtype==RAD_F32,y->data,y->dtype==RAD_F32,n,xs,ys,eps);
+    else rms_ink<true><<<m,128,0,(hipStream_t)st>>>(x->data,r4d_p(w),
+        w && w->dtype==RAD_F32,y->data,y->dtype==RAD_F32,n,xs,ys,eps);
+    else if(chain) r4dchain_rms_ink<false><<<m,128,0,(hipStream_t)st>>>(x->data,r4d_p(w),
+        w && w->dtype==RAD_F32,y->data,y->dtype==RAD_F32,n,xs,ys,eps);
+    else rms_ink<false><<<m,128,0,(hipStream_t)st>>>(x->data,r4d_p(w),
+        w && w->dtype==RAD_F32,y->data,y->dtype==RAD_F32,n,xs,ys,eps);
+    return launched();
+}
+
+// ---------------------------------------------------------------------------------------------
+// Inkling2_ctl3. A core visit of the second and third pass runs three controllers
+// (the q, k and v inputs), each followed by its RMS norm: nine launches a visit at one token and
+// twelve at the verify height, each behind the one before. Here the three run side by side, block
+// z of every grid being the launch that controller j = z made alone: the bodies are the same
+// functions on the same operands, so each output has the bytes it had. Four launches up to 16 tokens
+// (norm, down, blend, rms); above that the original launches run in turn.
+namespace {
+struct Ctl3 {
+    const float* x[3]; const float* msg[3]; const uint16_t* down[3]; const float* gain[3];
+    const float* forget[3]; float* hidden[3]; uint16_t* normalized[3]; float* y[3];
+};
+struct Rms3 { const void* x[3]; const void* w[3]; void* out[3]; bool w_f32[3]; long long ys[3]; };
+template<bool CHAIN> __global__ void ctl3_norm_token(Ctl3 c,int n,float eps) {
+    if(CHAIN) r4d_chain_wait();
+    const int z=blockIdx.z;
+    control_norm_token_body(c.x[z],c.msg[z],c.normalized[z],n,eps);
+    if(CHAIN) r4d_chain_done();
+}
+template<bool CHAIN> __global__ void ctl3_down_rank(Ctl3 c,int count,int rank) {
+    if(CHAIN) r4d_chain_wait();
+    const int z=blockIdx.z;
+    control_down_rank_body(c.normalized[z],c.down[z],c.hidden[z],count,rank);
+    if(CHAIN) r4d_chain_done();
+}
+template<bool CHAIN> __global__ void ctl3_blend(Ctl3 c,int m,int n,int rank) {
+    if(CHAIN) r4d_chain_wait();
+    const int z=blockIdx.z;
+    control_blend_body(c.x[z],c.msg[z],c.gain[z],c.forget[z],c.hidden[z],c.y[z],m,n,rank);
+    if(CHAIN) r4d_chain_done();
+}
+template<bool CHAIN> __global__ void ctl3_rms(Rms3 r,bool out_f32,int n,float eps) {
+    if(CHAIN) r4d_chain_wait();
+    const int z=blockIdx.z;
+    rms_ink_body<true>(r.x[z],r.w[z],r.w_f32[z],r.out[z],out_f32,n,(long long)n,r.ys[z],eps);
+    if(CHAIN) r4d_chain_done();
+}
+}
+// The backend chains the kernels whose name carries "r4dchain" (rad_abi.h): the chained forms.
+namespace {
+__global__ void r4dchain_ctl3_norm_token(Ctl3 c,int n,float eps) {
+    r4d_chain_wait(); const int z=blockIdx.z;
+    control_norm_token_body(c.x[z],c.msg[z],c.normalized[z],n,eps); r4d_chain_done();
+}
+__global__ void r4dchain_ctl3_down_rank(Ctl3 c,int count,int rank) {
+    r4d_chain_wait(); const int z=blockIdx.z;
+    control_down_rank_body(c.normalized[z],c.down[z],c.hidden[z],count,rank); r4d_chain_done();
+}
+__global__ void r4dchain_ctl3_blend(Ctl3 c,int m,int n,int rank) {
+    r4d_chain_wait(); const int z=blockIdx.z;
+    control_blend_body(c.x[z],c.msg[z],c.gain[z],c.forget[z],c.hidden[z],c.y[z],m,n,rank); r4d_chain_done();
+}
+__global__ void r4dchain_ctl3_rms(Rms3 r,bool out_f32,int n,float eps) {
+    r4d_chain_wait(); const int z=blockIdx.z;
+    rms_ink_body<true>(r.x[z],r.w[z],r.w_f32[z],r.out[z],out_f32,n,(long long)n,r.ys[z],eps); r4d_chain_done();
+}
+}
+// Scratch a controller: its bottleneck (m x rank f32), the normalized pair of a verify height
+// (min(m,16) x 2n bf16) and its output (m x n f32), which the norm reads.
+static long long ctl3_slice(long long m,long long n,long long rank) {
+    return (m*rank+std::min<long long>(m,16)*n+m*n)*(long long)sizeof(float);
+}
+extern "C" int64_t r4d_inkling2_ctl3_scratch(const RadArgs* a) {
+    const long long m=r4d_geti_or(a,"M",0),rank=r4d_geti_or(a,"rank",0),n=r4d_geti_or(a,"n",0);
+    if(m<1 || m>65535*8 || rank<1 || rank>64 || n<1 || n>8192)return 0;
+    return 3*ctl3_slice(m,n,rank);
+}
+// Operands: x0..2, msg0..2, down0..2, gain0..2, forget0..2, norm0..2 (optional), out0..2.
+extern "C" int r4d_inkling2_ctl3(const RadArgs* a,RadStream stream) {
+    bool chain=r4d_geti_or(a,"chain",0)!=0;
+    const int n=r4d_geti_or(a,"n",0), rank=r4d_geti_or(a,"rank",0);
+    const float eps=r4d_getf(a,"eps",1e-6);
+    if(n<1 || n>8192 || rank<1 || rank>64 || eps<=0) return R4D_NO(RAD_E_SHAPE);
+    const RadTensor *x[3],*msg[3],*down[3],*g[3],*f[3],*w[3],*out[3];
+    long long m=0; bool out_f32=false;
+    for(int j=0;j<3;++j) {
+        x[j]=r4d_opt(a,j);msg[j]=r4d_opt(a,3+j);down[j]=r4d_opt(a,6+j);g[j]=r4d_opt(a,9+j);
+        f[j]=r4d_opt(a,12+j);w[j]=r4d_opt(a,15+j);out[j]=r4d_opt(a,18+j);
+        if(!dense(x[j],RAD_F32)||!dense(msg[j],RAD_F32)||!dense(down[j],RAD_BF16)||!dense(g[j],RAD_F32)||
+           !dense(f[j],RAD_F32)||!out[j]||(out[j]->dtype!=RAD_BF16 && out[j]->dtype!=RAD_F32)||
+           (w[j] && !dense(w[j],RAD_F32) && !dense(w[j],RAD_BF16))) return R4D_NO(RAD_E_DTYPE);
+        if(r4d_numel(x[j])%n) return R4D_NO(RAD_E_SHAPE);
+        const long long rows=r4d_numel(x[j])/n;
+        if(rows<1 || rows>INT_MAX || (j && rows!=m)) return R4D_NO(RAD_E_SHAPE);
+        m=rows;
+        if(r4d_numel(msg[j])!=m*n||r4d_numel(down[j])!=2LL*n*rank||r4d_numel(g[j])!=(long long)n*rank||
+           r4d_numel(f[j])!=(long long)n*rank||(w[j] && r4d_numel(w[j])!=n)) return R4D_NO(RAD_E_SHAPE);
+        if(j && (out[j]->dtype==RAD_F32)!=out_f32) return R4D_NO(RAD_E_DTYPE);
+        out_f32=out[j]->dtype==RAD_F32;
+    }
+    const long long slice=ctl3_slice(m,n,rank);
+    if(!a->scratch || a->scratch_bytes<3*slice) return R4D_NO(RAD_E_SHAPE);
+    chain=chain && m<=64;
+    Ctl3 c{}; Rms3 r{};
+    for(int j=0;j<3;++j) {
+        char* base=(char*)a->scratch+j*slice;
+        // The layout r4d_inkling2_control uses inside its own scratch, then the output.
+        c.normalized[j]=(uint16_t*)base;
+        c.hidden[j]=(float*)(c.normalized[j]+2*std::min<long long>(m,16)*n);
+        c.y[j]=(float*)(base+(m*rank+std::min<long long>(m,16)*n)*(long long)sizeof(float));
+        c.x[j]=(const float*)x[j]->data;c.msg[j]=(const float*)msg[j]->data;c.down[j]=(const uint16_t*)down[j]->data;
+        c.gain[j]=(const float*)g[j]->data;c.forget[j]=(const float*)f[j]->data;
+        long long my=0; r.ys[j]=r4d_rows_pitch(out[j],n,&my);
+        if(r.ys[j]<0 || my!=m) return R4D_NO(RAD_E_SHAPE);
+        r.x[j]=c.y[j];r.w[j]=r4d_p(w[j]);r.w_f32[j]=w[j] && w[j]->dtype==RAD_F32;r.out[j]=out[j]->data;
+    }
+    auto queue=(hipStream_t)stream;
+    if(m<=16 && n>=1024 && rank>=32) {
+        // One token takes the verify heights' two launches too: the token is normalized once (the
+        // one-token kernel redoes the FP64 norms in each of its 64 blocks, and three controllers of
+        // that side by side took three times as long, 37 us), then the 64 float-pair dots. The
+        // output at one token is the same through either.
+        if(chain) r4dchain_ctl3_norm_token<<<dim3(m,1,3),256,0,queue>>>(c,n,eps);
+        else ctl3_norm_token<false><<<dim3(m,1,3),256,0,queue>>>(c,n,eps);
+        int status=launched(); if(status!=RAD_OK) return status;
+        if(chain) r4dchain_ctl3_down_rank<<<dim3(rank,m,3),256,0,queue>>>(c,2*n,rank);
+        else ctl3_down_rank<false><<<dim3(rank,m,3),256,0,queue>>>(c,2*n,rank);
+        status=launched(); if(status!=RAD_OK) return status;
+        if(chain) r4dchain_ctl3_blend<<<dim3((n+31)/32,(m+7)/8,3),256,0,queue>>>(c,m,n,rank);
+        else ctl3_blend<false><<<dim3((n+31)/32,(m+7)/8,3),256,0,queue>>>(c,m,n,rank);
+        status=launched(); if(status!=RAD_OK) return status;
+        if(chain) r4dchain_ctl3_rms<<<dim3(m,1,3),128,0,queue>>>(r,out_f32,n,eps);
+        else ctl3_rms<false><<<dim3(m,1,3),128,0,queue>>>(r,out_f32,n,eps);
+        return launched();
+    }
+    // Above the verify heights: each controller's own launches, then its norm, as before.
+    for(int j=0;j<3;++j) {
+        RadTensor yt=*x[j]; yt.data=c.y[j];
+        RadTensor ct[6]={*x[j],*msg[j],*down[j],*g[j],*f[j],yt};
+        RadArgs ca=*a; ca.t=ct; ca.n_t=6; ca.scratch=(char*)a->scratch+j*slice;
+        ca.scratch_bytes=(m*rank+std::min<long long>(m,16)*n)*(long long)sizeof(float);
+        int rc=r4d_inkling2_control(&ca,stream); if(rc!=RAD_OK) return rc;
+        RadTensor none{}; RadTensor rt[3]={yt,w[j]?*w[j]:none,*out[j]};
+        RadArgs ra=*a; ra.t=rt; ra.n_t=3; ra.scratch=nullptr; ra.scratch_bytes=0;
+        rc=r4d_inkling2_rmsnorm(&ra,stream); if(rc!=RAD_OK) return rc;
+    }
+    return RAD_OK;
+}
diff --git a/libr4d/r4d_inkling2_decode.h b/libr4d/r4d_inkling2_decode.h
new file mode 100644
index 0000000..d8d1bfc
--- /dev/null
+++ b/libr4d/r4d_inkling2_decode.h
@@ -0,0 +1,133 @@
+// One wave reads a page once for all three query heads sharing its KV head.
+// The two split passes retain the BF16-normalized P.V arithmetic and sink.
+template<bool stats>
+__device__ __forceinline__ void grouped_decode_body(Attention a) {
+    constexpr int G=3,W=4;
+    const int t=blockIdx.x,kh=blockIdx.y,part=blockIdx.z,tid=threadIdx.x,lane=tid%32,wave=tid/32;
+    const int qh=lane%16,half=lane/16,h0=kh*G,H=a.heads;
+    int seq=r4d_q_seq(a.cu,a.seqs,a.rows/a.seqs,t);
+    int qstart=r4d_q_off(a.cu,seq,a.rows/a.seqs),qlen=r4d_q_len(a.cu,seq,a.rows/a.seqs);
+    int pos=a.used[seq]-qlen+t-qstart, begin=a.window?max(0,pos+1-a.window):0;
+    int last=min(a.table_width,(pos+16)/16),first=begin/16;
+    // The row's own count (ink_row_splits): the launch's unless several rows share a sequence.
+    const int rs=ink_row_splits(a,pos);
+    if(part>=rs)return;
+    int lo=first+(long long)(last-first)*part/rs,hi=first+(long long)(last-first)*(part+1)/rs;
+    bool live=qh<G;
+    auto pp=[&](int h,int k){return a.partial+((long long)(t*H+h0+h)*a.splits+k)*(hd+2);};
+    __shared__ float row_m[G],row_z[G],maxes[W][G],sums[W][G],outputs[W][G][16];
+    if constexpr(!stats) {
+        if(tid<G){
+            float mx=-INFINITY,den=0;
+            for(int i=0;i<rs;++i)mx=fmaxf(mx,pp(tid,i)[hd]);
+            for(int i=0;i<rs;++i){float s=pp(tid,i)[hd+1];if(s)den+=s*expf(pp(tid,i)[hd]-mx);}
+            row_m[tid]=mx;row_z[tid]=den;
+        }
+        __syncthreads();
+    }
+    InkB8 q[8];float rel[dr];
+#pragma unroll
+    for(int d=0;d<8;++d)q[d]=live?*(const InkB8*)(a.q+t*a.q_stride+(h0+qh)*hd+d*16+half*8):InkB8{};
+#pragma unroll
+    for(int d=0;d<dr;++d)rel[d]=live?bf16_to_f32(a.r[t*a.r_stride+(h0+qh)*dr+d]):0;
+    float mx=live && !part && !wave?bf16_to_f32(a.sink[t*a.sink_stride+h0+qh]):-INFINITY;
+    float z=live && !part && !wave?1.f:0.f;
+    InkF8 output[8]={};
+    for(int pg=lo+wave;pg<hi;pg+=W){
+        int block=a.bt[(long long)seq*a.bt_stride+pg];if(block<0||block>=a.blocks)continue;
+        const int8_t* bytes=(const int8_t*)a.kv+((long long)block*(H/G)+kh)*16*260;
+        auto sc=(const __half*)(bytes+qh*260+256);
+        float ks=__half2float(sc[0]),vs=__half2float(sc[1]);
+        bool stored=a.score_cache && pg*16>=begin && pg*16+16-begin<=a.score_stride;
+        InkF8 dot{};
+        if(stats || !stored){
+#pragma unroll
+            for(int d=0;d<8;++d){
+                InkB8 key;
+#pragma unroll
+                for(int i=0;i<8;++i)key[i]=i8_bf16(bytes[qh*260+d*16+half*8+i]);   // exact: int8 is exact in BF16
+                dot=ink_wmma(key,q[d],dot);
+            }
+        }
+        float score[8],pmax=-INFINITY;
+#pragma unroll
+        for(int i=0;i<8;++i){
+            const int col=half*8+i,j=pg*16+col,dist=pos-j;
+            float value=-INFINITY;
+            float scale=__shfl(ks,col,32);
+            if(live && j>=begin && j<=pos){
+                auto* cache=a.score_cache && j-begin<a.score_stride ?
+                    a.score_cache+((long long)t*H+h0+qh)*a.score_stride+j-begin:nullptr;
+                if(!stats && stored)value=bf16_to_f32(*cache);
+                else{
+                    float bias=0;
+                    if(dist<a.extent){
+#pragma unroll
+                        for(int d=0;d<dr;++d)bias+=rel[d]*bf16_to_f32(a.table[d*a.extent+dist]);
+                    }
+                    value=bf(bf(bf(dot[i]*scale)*a.scale)+bf(bias));
+                    if(stats && cache)*cache=f32_to_bf16(value);
+                }
+            }
+            score[i]=value;pmax=fmaxf(pmax,value);
+        }
+        if constexpr(stats){
+            float next=fmaxf(mx,fmaxf(pmax,__shfl_xor(pmax,16,32)));
+            if(next!=-INFINITY){
+                float s=0;
+#pragma unroll
+                for(int i=0;i<8;++i)s+=expf(score[i]-next);
+                z=z*expf(mx-next)+s+__shfl_xor(s,16,32);mx=next;
+            }
+        }else{
+            InkB8 p0{},p1{},p2{};int tail=0;
+#pragma unroll
+            for(int i=0;i<8;++i){
+                float s=__shfl(vs,half*8+i,32);
+                float p=live?bf(__fdiv_rn(expf(score[i]-row_m[qh]),row_z[qh])):0;
+                float v=p==0?0:p*s;p0[i]=f32_to_bf16(v);
+                float rem=v-bf16_to_f32(p0[i]);p1[i]=f32_to_bf16(rem);p2[i]=f32_to_bf16(rem-bf16_to_f32(p1[i]));tail|=p2[i]&0x7fff;
+            }
+            bool extra=__builtin_amdgcn_ballot_w32(tail);
+#pragma unroll
+            for(int d=0;d<8;++d){
+                InkB8 v;
+#pragma unroll
+                for(int i=0;i<8;++i)v[i]=i8_bf16(bytes[(half*8+i)*260+hd+d*16+qh]);
+                output[d]=ink_wmma(v,p0,output[d]);output[d]=ink_wmma(v,p1,output[d]);
+                if(extra)output[d]=ink_wmma(v,p2,output[d]);
+            }
+        }
+    }
+    if constexpr(stats){
+        if(!half && live){maxes[wave][qh]=mx;sums[wave][qh]=z;}__syncthreads();
+        if(tid<G){
+            float v=-INFINITY,sum=0;
+            for(int w=0;w<W;++w)v=fmaxf(v,maxes[w][tid]);
+            for(int w=0;w<W;++w)if(sums[w][tid])sum+=sums[w][tid]*expf(maxes[w][tid]-v);
+            auto* p=pp(tid,part);p[hd]=v;p[hd+1]=sum;
+        }
+    }else{
+#pragma unroll
+        for(int d=0;d<8;++d){
+            if(live){
+#pragma unroll
+                for(int i=0;i<8;++i)outputs[wave][qh][half*8+i]=output[d][i];
+            }
+            __syncthreads();
+            if(tid<G*16){float sum=0;for(int w=0;w<W;++w)sum+=outputs[w][tid/16][tid%16];pp(tid/16,part)[d*16+tid%16]=sum;}
+            __syncthreads();
+        }
+    }
+}
+template<bool stats>
+__global__ void grouped_decode(Attention a) {
+    grouped_decode_body<stats>(a);
+}
+template<bool stats>
+__global__ void r4dchain_grouped_decode(Attention a) {
+    r4d_chain_wait();
+    grouped_decode_body<stats>(a);
+    r4d_chain_done();
+}
+
diff --git a/libr4d/r4d_inkling2_prefill.h b/libr4d/r4d_inkling2_prefill.h
new file mode 100644
index 0000000..c9290b0
--- /dev/null
+++ b/libr4d/r4d_inkling2_prefill.h
@@ -0,0 +1,167 @@
+// RDNA4 WMMA prefill. One block shares sixteen query positions of one head.
+// Its eight waves split the visible key pages and combine their row statistics in LDS.
+// The second pass uses the normalized, BF16-rounded probabilities of eager attention.
+using InkB8 = short __attribute__((ext_vector_type(8)));
+using InkF8 = float __attribute__((ext_vector_type(8)));
+constexpr int prefill_waves=8;
